@model turistico.Controllers.ComercioAdminVM

@{
    ViewBag.Title = "Editar Comercio";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var hasErrors = !ViewData.ModelState.IsValid;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-1">Editar comercio</h3>
        <div class="text-muted">Actualizá la información del comercio seleccionado.</div>
    </div>

    <div>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index","AdminComercios")">Volver</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "AdminComercios", new { id = ViewBag.ComercioId }, FormMethod.Post,
            new { autocomplete = "off", enctype = "multipart/form-data", id = "frmComercio" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", (int)ViewBag.ComercioId)

            @* ✅ Solo mostrar el cuadro rojo si hay errores *@
            if (hasErrors)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0" })
                </div>
            }

            <div class="row g-3">
                <!-- Básicos -->
                <div class="col-12 col-md-6">
                    <label class="form-label">Nombre del comercio <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Categoría <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.CategoriaId, (SelectList)ViewBag.Categorias, "Seleccione...", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.CategoriaId, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción</label>
                    @Html.TextAreaFor(m => m.Descripcion, 3, 1, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <label class="form-label">Imagen del comercio (opcional)</label>
                    <input type="file" name="Imagen" class="form-control" accept="image/*" />
                    <div class="form-text">Si seleccionas una imagen, se reemplazará la actual.</div>

                    @if (ViewBag.ImagenActual != null)
                    {
                        <div class="mt-2">
                            <div class="text-muted small mb-1">Imagen actual:</div>
                            <img src="@ViewBag.ImagenActual"
                                 style="max-height:160px; border-radius:10px; object-fit:cover;" />
                        </div>
                    }
                </div>

                <!-- Ubicación / contacto -->
                <div class="col-12 col-md-6">
                    <label class="form-label">Dirección</label>
                    @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control" })
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Teléfono</label>
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Horario</label>
                    @Html.TextBoxFor(m => m.Horario, new { @class = "form-control" })
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Sitio web</label>
                    @Html.TextBoxFor(m => m.SitioWeb, new { @class = "form-control", placeholder = "https://..." })
                </div>

                @* ✅ CAMBIO: lat/long como TEXT para aceptar coma o punto *@
                <div class="col-12 col-md-3">
                    <label class="form-label">Latitud</label>
                    @Html.TextBoxFor(m => m.Latitud, "{0:0.######}", new
                    {
                        @class = "form-control js-latlng",
                        type = "text",
                        inputmode = "decimal",
                        placeholder = "Ej: 10.469956 o 10,469956"
                    })
                    <div class="form-text">Podés usar coma o punto.</div>
                    @Html.ValidationMessageFor(m => m.Latitud, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Longitud</label>
                    @Html.TextBoxFor(m => m.Longitud, "{0:0.######}", new
                    {
                        @class = "form-control js-latlng",
                        type = "text",
                        inputmode = "decimal",
                        placeholder = "Ej: -84.469296 o -84,469296"
                    })
                    <div class="form-text">Podés usar coma o punto.</div>
                    @Html.ValidationMessageFor(m => m.Longitud, "", new { @class = "text-danger small" })
                </div>

                <!-- Estado -->
                <div class="col-12 col-md-4">
                    <label class="form-label">Estado</label>
                    @Html.DropDownListFor(m => m.Estado,
                             new SelectList(new[] { "Aprobado", "Pendiente", "Rechazado" }, Model?.Estado ?? "Aprobado"),
                             new { @class = "form-select" })
                </div>

                <!-- Regulación -->
                <div class="col-12 col-md-8 d-flex align-items-end">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.EsRegulado, new { @class = "form-check-input", id = "chkRegulado" })
                        <label class="form-check-label" for="chkRegulado">
                            Es comercio regulado (requiere patente)
                        </label>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Número de patente</label>
                    @Html.TextBoxFor(m => m.NumeroPatente, new { @class = "form-control", id = "txtPatente" })
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Fecha de vencimiento</label>
                    @Html.TextBoxFor(m => m.FechaVencimiento, new { @class = "form-control", type = "date", id = "txtVence" })
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-success" type="submit">Guardar cambios</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("Index","AdminComercios")">Cancelar</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ===== regulado =====
            const chk = document.getElementById('chkRegulado');
            const patente = document.getElementById('txtPatente');
            const vence = document.getElementById('txtVence');

            function toggleRegulado() {
                const on = chk && chk.checked;
                if (patente) patente.disabled = !on;
                if (vence) vence.disabled = !on;
            }
            if (chk) chk.addEventListener('change', toggleRegulado);
            toggleRegulado();

            // ===== ✅ normalizar coma -> punto en lat/long =====
            function normalizeLatLngValue(v) {
                if (!v) return v;
                v = v.trim();
                if (v.includes('.') && v.includes(',')) v = v.replace(/\./g, '').replace(',', '.');
                else v = v.replace(',', '.');
                return v;
            }

            document.querySelectorAll('.js-latlng').forEach(inp => {
                inp.addEventListener('blur', () => {
                    inp.value = normalizeLatLngValue(inp.value);
                });
            });

            const form = document.getElementById('frmComercio');
            if (form) {
                form.addEventListener('submit', () => {
                    document.querySelectorAll('.js-latlng').forEach(inp => {
                        inp.value = normalizeLatLngValue(inp.value);
                    });
                });
            }
        })();
    </script>
}