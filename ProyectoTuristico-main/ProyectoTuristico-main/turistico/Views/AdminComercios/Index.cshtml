@model IEnumerable<turistico.Models.Comercio>

@{
    ViewBag.Title = "Comercios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    string estadoFiltro = (Request["estado"] ?? "").Trim();
    string q = (Request["q"] ?? "").Trim();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-1">Comercios</h3>
        <div class="text-muted">Gestión de comercios: crear, aprobar o rechazar.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-success" href="@Url.Action("Create","AdminComercios")">
            + Agregar comercio
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "AdminComercios", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-12 col-md-5">
                <label class="form-label mb-1">Buscar</label>
                <input type="text" name="q" value="@q" class="form-control" placeholder="Nombre, categoría, dirección..." />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label mb-1">Estado</label>
                <select class="form-select" name="estado">
                    <option value="" @(string.IsNullOrEmpty(estadoFiltro) ? "selected" : "")>Todos</option>
                    <option value="Aprobado" @(estadoFiltro == "Aprobado" ? "selected" : "")>Aprobado</option>
                    <option value="Pendiente" @(estadoFiltro == "Pendiente" ? "selected" : "")>Pendiente</option>
                    <option value="Rechazado" @(estadoFiltro == "Rechazado" ? "selected" : "")>Rechazado</option>
                </select>
            </div>

            <div class="col-12 col-md-4 d-flex gap-2">
                <button class="btn btn-outline-success w-100" type="submit">Filtrar</button>
                <a class="btn btn-outline-secondary w-100" href="@Url.Action("Index","AdminComercios")">Limpiar</a>
            </div>
        }
    </div>
</div>

@{
    var lista = Model ?? Enumerable.Empty<turistico.Models.Comercio>();

    if (!string.IsNullOrWhiteSpace(estadoFiltro))
    {
        lista = lista.Where(x =>
            x.Lugar != null &&
            x.Lugar.Estado != null &&
            x.Lugar.Estado == estadoFiltro
        );
    }

    if (!string.IsNullOrWhiteSpace(q))
    {
        var qq = q.ToLower();

        lista = lista.Where(x =>
            (x.Nombre ?? "").ToLower().Contains(qq) ||
            (x.Lugar != null &&
                (
                    (x.Lugar.Direccion ?? "").ToLower().Contains(qq) ||
                    (x.Lugar.Categoria != null &&
                     (x.Lugar.Categoria.Nombre ?? "").ToLower().Contains(qq))
                )
            )
        );
    }

    var total = lista.Count();
    var aprobados = lista.Count(x => x.Lugar != null && x.Lugar.Estado == "Aprobado");
    var pendientes = lista.Count(x => x.Lugar != null && x.Lugar.Estado == "Pendiente");
    var rechazados = lista.Count(x => x.Lugar != null && x.Lugar.Estado == "Rechazado");
}

<div class="row g-3 mb-3">
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total</div>
                <div class="fs-4 fw-bold">@total</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Aprobados</div>
                <div class="fs-4 fw-bold">@aprobados</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Pendientes</div>
                <div class="fs-4 fw-bold">@pendientes</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Rechazados</div>
                <div class="fs-4 fw-bold">@rechazados</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Comercio</th>
                        <th>Categoría</th>
                        <th>Dirección</th>
                        <th>Estado</th>
                        <th>Regulado</th>
                        <th class="text-end pe-3" style="width:240px;">Acciones</th>
                    </tr>
                <tbody>
                    @if (!lista.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                No hay comercios para mostrar con los filtros seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in lista)
                        {
                            var estado = c.Lugar?.Estado ?? "Pendiente";
                            var badge =
                                estado == "Aprobado" ? "bg-success" :
                                estado == "Pendiente" ? "bg-warning text-dark" :
                                "bg-danger";

                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold">@c.Nombre</div>
                                    <div class="text-muted small text-truncate" style="max-width: 360px;">
                                        @(c.Descripcion ?? c.Lugar?.Descripcion ?? "")
                                    </div>
                                </td>

                                <td>@(c.Lugar?.Categoria?.Nombre ?? "-")</td>

                                <td class="text-truncate" style="max-width: 280px;">
                                    @(c.Lugar?.Direccion ?? "-")
                                </td>

                                <td>
                                    <span class="badge @badge">@estado</span>
                                </td>

                                <td>
                                    @if (c.ComercioRegulado != null)
                                    {
                                        <span class="badge bg-info">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>

                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">

                                        <!-- EDIT -->
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="@Url.Action("Edit","AdminComercios", new { id = c.Id })">
                                            Editar
                                        </a>

                                        <!-- APROBAR -->
                                        @using (Html.BeginForm("Aprobar", "AdminComercios", FormMethod.Post, new { @class = "m-0" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", c.Id)

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    @(estado == "Aprobado" ? "disabled" : "")>
                                                Aprobar
                                            </button>
                                        }

                                        <!-- RECHAZAR -->
                                        @using (Html.BeginForm("Rechazar", "AdminComercios", FormMethod.Post, new { @class = "m-0" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", c.Id)

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @(estado == "Rechazado" ? "disabled" : "")>
                                                Rechazar
                                            </button>
                                        }

                                        <!-- DELETE (abre modal) -->
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@c.Id">
                                            Eliminar
                                        </button>
                                    </div>

                                    <!-- MODAL DELETE -->
                                    <div class="modal fade" id="deleteModal-@c.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Confirmar eliminación</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <p class="mb-2">
                                                        Vas a eliminar el comercio:
                                                        <span class="fw-semibold">@c.Nombre</span>
                                                    </p>
                                                    <p class="text-muted mb-0 small">
                                                        Esta acción eliminará también su <b>Lugar</b> asociado y (si existe) el registro de <b>Comercio regulado</b>.
                                                        No se puede deshacer.
                                                    </p>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>

                                                    @using (Html.BeginForm("Delete", "AdminComercios", FormMethod.Post, new { @class = "m-0" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        @Html.Hidden("id", c.Id)
                                                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
