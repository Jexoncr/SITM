@model turistico.Controllers.EditUsuarioVM
@{
    ViewBag.Title = "Editar Usuario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">Editar usuario</h3>
        <div class="text-muted">Actualiza datos, roles y estado de acceso.</div>
    </div>
    <div>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index","AdminUsuarios")">Volver</a>
    </div>
</div>

@if (TempData["Ok"] != null)
{<div class="alert alert-success">@TempData["Ok"]</div>}
@if (TempData["Err"] != null)
{<div class="alert alert-danger">@TempData["Err"]</div>}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "AdminUsuarios", FormMethod.Post, new { autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Correo (no editable)</label>
                    <input class="form-control" value="@Model.Email" disabled />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Teléfono</label>
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Ej: 8888-8888" })
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Nombre</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Nombre" })
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Apellido</label>
                    @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control", placeholder = "Apellido" })
                </div>

                <div class="col-12">
                    <hr />
                </div>

                <!-- ROLES -->
                <div class="col-12 col-lg-7">
                    <label class="form-label fw-semibold">Roles</label>
                    <div class="text-muted small mb-2">Activa o desactiva los permisos del usuario.</div>

                    <div class="row g-2">
                        @for (int i = 0; i < (Model.Roles?.Count ?? 0); i++)
                        {
                            <div class="col-12 col-md-6">
                                <div class="form-check">
                                    @Html.HiddenFor(m => m.Roles[i].RoleName)
                                    @Html.CheckBoxFor(m => m.Roles[i].Assigned, new { @class = "form-check-input", id = "role_" + i })
                                    <label class="form-check-label" for="@("role_" + i)">
                                        @Model.Roles[i].RoleName
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- ESTADO -->
                <div class="col-12 col-lg-5">
                    <label class="form-label fw-semibold">Estado de acceso</label>
                    <div class="text-muted small mb-2">Bloquea el inicio de sesión del usuario.</div>

                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Bloqueado, new { @class = "form-check-input", id = "chkLock" })
                        <label class="form-check-label" for="chkLock">
                            Bloquear usuario
                        </label>
                    </div>

                    <div class="mt-3">
                        @if (Model.Bloqueado)
                        {
                            <span class="badge bg-danger">Actualmente bloqueado</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Actualmente activo</span>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <hr />
                </div>

                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">
                        Guardar cambios
                    </button>
                    <a class="btn btn-outline-secondary" href="@Url.Action("Index","AdminUsuarios")">
                        Cancelar
                    </a>
                </div>
            </div>
        }

        <!-- RESET PASSWORD (Opcional) -->
        
            <hr class="my-4" />
            <h5 class="mb-2">Restablecer contraseña</h5>
            <p class="text-muted small">Cambia la contraseña del usuario (solo Admin).</p>

            @using (Html.BeginForm("ResetPassword", "AdminUsuarios", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />

                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-6">
                        <label class="form-label mb-1">Nueva contraseña</label>
                        <input class="form-control" name="newPassword" placeholder="Nueva contraseña..." />
                    </div>
                    <div class="col-12 col-md-3">
                        <button class="btn btn-danger w-100" type="submit"
                                onclick="return confirm('¿Seguro que deseas cambiar la contraseña?');">
                            Reset
                        </button>
                    </div>
                </div>
            }
        
    </div>
</div>