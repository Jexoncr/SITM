@model IEnumerable<turistico.Controllers.UsuarioRowVM>
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var q = ViewBag.Query as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">Usuarios</h3>
        <div class="text-muted">Administración de accesos, roles y estado de cuenta.</div>
    </div>
    <div>
        <a class="btn btn-success" href="@Url.Action("Create","AdminUsuarios")">
            Crear usuario
        </a>
    </div>
</div>

@if (TempData["Ok"] != null)
{<div class="alert alert-success">@TempData["Ok"]</div>}
@if (TempData["Err"] != null)
{<div class="alert alert-danger">@TempData["Err"]</div>}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "AdminUsuarios", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-12 col-md-6">
                <label class="form-label mb-1">Buscar</label>
                <input class="form-control" type="text" name="q" value="@q" placeholder="Email, nombre, usuario..." />
            </div>
            <div class="col-12 col-md-3">
                <button class="btn btn-outline-success w-100" type="submit">Buscar</button>
            </div>
            <div class="col-12 col-md-3">
                <a class="btn btn-outline-secondary w-100" href="@Url.Action("Index","AdminUsuarios")">Limpiar</a>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Usuario</th>
                        <th>Teléfono</th>
                        <th>Roles</th>
                        <th>Estado</th>
                        <th class="text-end pe-3" style="width:260px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-semibold">@u.Email</div>
                                <div class="text-muted small">@($"{u.Nombre} {u.Apellido}".Trim())</div>
                            </td>

                            <td>@(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "-" : u.PhoneNumber)</td>

                            <td>
                                @if (u.Roles != null && u.Roles.Any())
                                {
                                    foreach (var r in u.Roles.OrderBy(x => x))
                                    {
                                        <span class="badge bg-secondary me-1">@r</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Sin roles</span>
                                }
                            </td>

                            <td>
                                @if (u.Bloqueado)
                                {
                                    <span class="badge bg-danger">Bloqueado</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                            </td>

                            <td class="text-end pe-3">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Edit","AdminUsuarios", new { id = u.Id })">
                                    Editar
                                </a>

                                @using (Html.BeginForm("Delete", "AdminUsuarios",
                                    new { id = u.Id },
                                    FormMethod.Post,
                                    new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('¿Seguro que deseas eliminar este usuario?');">
                                        Eliminar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>