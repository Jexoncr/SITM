<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Administración SITM</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        /* ================= BASE ================= */
        body {
            background: #f4f7f6;
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        /* ================= SIDEBAR ================= */
        .sidebar {
            width: 260px;
            min-height: 100vh;
            background: #0f3d2e;
            color: #fff;
            box-shadow: 6px 0 20px rgba(0,0,0,.12);
        }

        .sidebar h5 {
            font-weight: 700;
            letter-spacing: .5px;
        }

        .nav-admin a {
            position: relative;
            color: rgba(255,255,255,.75);
            text-decoration: none;
            padding: 12px 16px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all .25s ease;
        }

        .nav-admin a:hover {
            background: rgba(255,255,255,.08);
            color: #fff;
        }

        .nav-admin a.active {
            color: #fff;
            background: rgba(255,255,255,.12);
        }

        .nav-admin a.active::before {
            content: "";
            position: absolute;
            left: 0;
            top: 10%;
            height: 80%;
            width: 4px;
            background: #38d39f;
            border-radius: 4px;
        }

        /* LOGOUT */
        .logout-btn {
            width: 100%;
            border-radius: 10px;
        }

        /* ================= HEADER ================= */
        .header-admin {
            background: #fff;
            padding: 14px 24px;
            border-bottom: 1px solid #e5e5e5;
            box-shadow: 0 4px 10px rgba(0,0,0,.05);
        }

        /* ================= CONTENT ================= */
        main {
            animation: fadeUp .35s ease;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>

<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        // helper para marcar activo por controller/action
        Func<string, string, string> isActive = (ctrl, act) =>
            (string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) &&
             string.Equals(action, act, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
    }

    <div class="d-flex">

        <!-- SIDEBAR -->
        <aside class="sidebar p-4">
            <h5 class="mb-4">
                <i class="bi bi-buildings me-2"></i> Administración
            </h5>

            <nav class="nav-admin d-flex flex-column gap-2">

                <a href="@Url.Action("Dashboard","Admin")" class="@isActive("Admin","Dashboard")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <!-- Módulos (según tu proyecto actual, estos existen por lo que pegaste) -->
                <a href="@Url.Action("Index","AdminComercios")" class="@isActive("AdminComercios","Index")">
                    <i class="bi bi-shop"></i> Comercios
                </a>

                <a href="@Url.Action("Index","AdminEventos")" class="@isActive("AdminEventos","Index")">
                    <i class="bi bi-calendar-event"></i> Eventos
                </a>

                <a href="@Url.Action("Index","AdminResenas")" class="@isActive("AdminResenas","Index")">
                    <i class="bi bi-star-fill"></i> Reseñas
                </a>

                <a href="@Url.Action("Index","AdminUsuarios")" class="@isActive("AdminUsuarios","Index")">
                    <i class="bi bi-people"></i> Usuarios
                </a>

                <a href="@Url.Action("Index","AdminRoles")" class="@isActive("AdminRoles","Index")">
                    <i class="bi bi-shield-lock"></i> Roles
                </a>

                <hr class="border-light opacity-25 my-3">

                <!-- Sitio público -->
                <a href="@Url.Action("Index","Home")">
                    <i class="bi bi-globe"></i> Ver sitio web
                </a>

                <!-- LOGOUT REAL (POST) -->
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "mt-2" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm logout-btn">
                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                    </button>
                }
            </nav>
        </aside>

        <!-- CONTENIDO -->
        <div class="flex-fill d-flex flex-column">

            <header class="header-admin d-flex justify-content-between align-items-center">
                <span class="fw-semibold text-muted">@ViewBag.Title</span>

                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle fs-4 text-success"></i>
                    <span class="fw-semibold">Administrador</span>
                </div>
            </header>

            <main class="flex-fill p-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>