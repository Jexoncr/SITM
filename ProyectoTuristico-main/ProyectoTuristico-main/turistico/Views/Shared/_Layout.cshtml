<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - SITM</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            background-color: #f4f8f5;
            color: #333;
            padding-top: 0 !important;
        }

        /* ===== NAVBAR ===== */
        .navbar-sitm {
            background: linear-gradient(90deg, #0f7b57, #1fa37a);
            box-shadow: 0 6px 18px rgba(0,0,0,.18);
            transition: background .4s ease, box-shadow .4s ease;
        }

            .navbar-sitm .navbar-brand {
                font-weight: 700;
                letter-spacing: 1px;
            }

            .navbar-sitm .nav-link {
                color: #e9f7f2;
                padding: 8px 14px;
                border-radius: 6px;
                position: relative;
                transition: all .3s ease;
            }

                .navbar-sitm .nav-link:hover {
                    background-color: rgba(255,255,255,.15);
                    transform: translateY(-2px);
                }

                /* LINK ACTIVO */
                .navbar-sitm .nav-link.active {
                    background-color: #ffffff;
                    color: #0f7b57 !important;
                    font-weight: 600;
                    box-shadow: 0 4px 10px rgba(0,0,0,.15);
                }

            /* BOTÓN */
            .navbar-sitm .btn-outline-light {
                border-width: 2px;
                transition: all .3s ease;
            }

                .navbar-sitm .btn-outline-light:hover {
                    background-color: #ffffff;
                    color: #0f7b57;
                }

        #mainContent {
            padding-top: 80px;
        }

        /* FOOTER ICONOS */
        footer a i {
            transition: color .3s ease, transform .3s ease;
        }

        footer a:hover i {
            color: #66bb6a;
            transform: scale(1.2);
        }

        /* ===== EXCEPCIÓN PARA INDEX ===== */
        .home-page .navbar-sitm .nav-link.active {
            background-color: transparent;
            color: #ffffff !important;
            box-shadow: none;
        }
    </style>


</head>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


<body class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "home-page" : "")">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top navbar-sitm">

        <div class="container-fluid px-4">

            <!-- LOGO / NOMBRE -->
            <a class="navbar-brand fw-bold fs-4" href="/Home/Index">
                SITM
            </a>

            <!-- BOTÓN MÓVIL -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSITM">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENÚ -->
            <div class="collapse navbar-collapse" id="navbarSITM">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-2">

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           href="/Home/Index">
                            Inicio
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Mapa" ? "active" : "")"
                           href="/Home/Mapa">
                            Mapa Turístico
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Eventos" ? "active" : "")"
                           href="/Home/Eventos">
                            Eventos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Comercios" ? "active" : "")"
                           href="/Home/Comercios">
                            Comercios
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Resenas" ? "active" : "")"
                           href="/Home/Resenas">
                            Reseñas
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Perfil" ? "active" : "")"
                           href="/Home/Perfil">
                            Perfil
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MisReservas" ? "active" : "")"
                           href="/Home/MisReservas">
                            Mis Reservas
                        </a>
                    </li>

                    <!-- BOTÓN DESTACADO -->
                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-outline-light fw-semibold px-3"
                           href="/Home/Login">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>
                            Cerrar sesión
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>



    <!-- CONTENIDO -->
    <main id="mainContent" class="mb-5">
        @RenderBody()
    </main>



    <!-- FOOTER -->
    <footer style="background-color:#1f2f46; color:#fff;">
        <div class="container py-5">

            <div class="row gy-4">

                <!-- Idioma y moneda -->
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3">Idioma</h6>
                    <select class="form-select mb-3">
                        <option>Español (Costa Rica)</option>
                        <option>English</option>
                    </select>

                    <h6 class="fw-bold mb-3">Moneda</h6>
                    <select class="form-select">
                        <option>Colón costarricense (₡)</option>
                        <option>Dólar americano ($)</option>
                    </select>
                </div>

                <!-- Asistencia -->
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3">Asistencia</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white text-decoration-none">Contacto</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Información legal</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Política de privacidad</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Términos y condiciones</a></li>
                    </ul>
                </div>

                <!-- Empresa -->
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3">Municipalidad</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white text-decoration-none">Sobre el SITM</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Turismo local</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Eventos</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Comercios</a></li>
                    </ul>
                </div>

                <!-- Colaboradores -->
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3">Colaboración</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white text-decoration-none">Afiliados</a></li>
                    </ul>
                </div>

            </div>

            <hr class="border-light my-4">

            <!-- Parte inferior -->
            <div class="d-flex gap-4">
                <a href="#" class="text-white fs-4 text-decoration-none">
                    <i class="fa-solid fa-globe"></i>
                </a>

                <a href="#" class="text-white fs-4 text-decoration-none">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>

                <a href="#" class="text-white fs-4 text-decoration-none">
                    <i class="fa-brands fa-instagram"></i>
                </a>

                <a href="#" class="text-white fs-4 text-decoration-none">
                    <i class="fa-brands fa-x-twitter"></i>
                </a>
            </div>


        </div>
    </footer>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
