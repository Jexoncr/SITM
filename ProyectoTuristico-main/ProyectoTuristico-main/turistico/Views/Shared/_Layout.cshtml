<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - SITM</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet"href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
         * {
             margin: 0;
             padding: 0;
             box-sizing: border-box;
             font-family: 'Segoe UI', sans-serif;
         }

         body {
             background-color: #f4f8f5;
             color: #333;
             padding-top: 0 !important;
         }

         /* ===== NAVBAR ===== */
         .navbar-sitm {
             background: linear-gradient(90deg, #0f7b57, #1fa37a);
             box-shadow: 0 6px 18px rgba(0,0,0,.18);
             transition: background .4s ease, box-shadow .4s ease;
         }

             .navbar-sitm .navbar-brand {
                 font-weight: 700;
                 letter-spacing: 1px;
             }

             .navbar-sitm .nav-link {
                 color: #e9f7f2;
                 padding: 8px 14px;
                 border-radius: 6px;
                 position: relative;
                 transition: all .3s ease;
             }

                 .navbar-sitm .nav-link:hover {
                     background-color: rgba(255,255,255,.15);
                     transform: translateY(-2px);
                 }

                 /* LINK ACTIVO */
                 .navbar-sitm .nav-link.active {
                     background-color: #ffffff;
                     color: #0f7b57 !important;
                     font-weight: 600;
                     box-shadow: 0 4px 10px rgba(0,0,0,.15);
                 }

             /* BOTÓN */
             .navbar-sitm .btn-outline-light {
                 border-width: 2px;
                 transition: all .3s ease;
             }

                 .navbar-sitm .btn-outline-light:hover {
                     background-color: #ffffff;
                     color: #0f7b57;
                 }

         #mainContent {
             padding-top: 80px;
         }

         /* ===========================
        FOOTER SITM — Institucional
        Paleta: #0f3d2e / #145544
        =========================== */

         .sitm-footer {
             position: relative;
             background: radial-gradient(1200px 600px at 20% -10%, rgba(20,85,68,.45), transparent 60%), radial-gradient(900px 500px at 90% 0%, rgba(20,85,68,.25), transparent 55%), linear-gradient(180deg, #0f3d2e 0%, #0c3427 100%);
             color: rgba(255,255,255,.88);
             border-top: 1px solid rgba(255,255,255,.10);
         }

             .sitm-footer .footer-top {
                 padding: 3rem 0 1.25rem 0;
             }

             .sitm-footer .brand-badge {
                 display: inline-flex;
                 align-items: center;
                 gap: .6rem;
                 padding: .5rem .75rem;
                 border-radius: 14px;
                 background: rgba(255,255,255,.06);
                 border: 1px solid rgba(255,255,255,.10);
                 box-shadow: 0 10px 30px rgba(0,0,0,.12);
             }

                 .sitm-footer .brand-badge i {
                     font-size: 1.1rem;
                     color: rgba(255,255,255,.95);
                 }

             .sitm-footer .brand-title {
                 font-weight: 800;
                 letter-spacing: .2px;
                 margin: 0;
                 color: #fff;
                 font-size: 1.05rem;
                 line-height: 1.15;
             }

             .sitm-footer .brand-sub {
                 margin: .35rem 0 0 0;
                 color: rgba(255,255,255,.78);
                 font-size: .95rem;
                 max-width: 40ch;
             }

             .sitm-footer h6.footer-heading {
                 color: rgba(255,255,255,.92);
                 font-weight: 800;
                 letter-spacing: .3px;
                 margin-bottom: .85rem;
                 font-size: .95rem;
             }

             .sitm-footer .footer-links {
                 list-style: none;
                 padding: 0;
                 margin: 0;
                 display: grid;
                 gap: .55rem;
             }

                 .sitm-footer .footer-links a {
                     color: rgba(255,255,255,.78);
                     text-decoration: none;
                     display: inline-flex;
                     align-items: center;
                     gap: .5rem;
                     transition: color .2s ease, transform .2s ease;
                     font-size: .95rem;
                 }

                     .sitm-footer .footer-links a:hover {
                         color: #dff6ee;
                         transform: translateX(2px);
                     }

                     .sitm-footer .footer-links a i {
                         font-size: .95rem;
                         opacity: .9;
                     }

             .sitm-footer .contact-card {
                 padding: 1rem 1rem;
                 border-radius: 16px;
                 background: rgba(255,255,255,.06);
                 border: 1px solid rgba(255,255,255,.10);
             }

             .sitm-footer .contact-item {
                 display: flex;
                 gap: .75rem;
                 align-items: flex-start;
                 color: rgba(255,255,255,.80);
                 font-size: .95rem;
             }

                 .sitm-footer .contact-item i {
                     margin-top: .15rem;
                     font-size: 1.05rem;
                     color: rgba(255,255,255,.92);
                 }

             .sitm-footer .divider {
                 margin: 1.6rem 0 1rem 0;
                 border: 0;
                 height: 1px;
                 background: linear-gradient(90deg, rgba(255,255,255,.08), rgba(255,255,255,.18), rgba(255,255,255,.08));
             }

             .sitm-footer .footer-bottom {
                 padding: 1rem 0 1.4rem 0;
                 color: rgba(255,255,255,.74);
                 font-size: .9rem;
             }

             .sitm-footer .legal-links a {
                 color: rgba(255,255,255,.74);
                 text-decoration: none;
                 transition: color .2s ease;
                 white-space: nowrap;
             }

                 .sitm-footer .legal-links a:hover {
                     color: #dff6ee;
                 }

             .sitm-footer .social {
                 display: inline-flex;
                 gap: .6rem;
                 align-items: center;
                 justify-content: flex-end;
             }

                 .sitm-footer .social a {
                     width: 40px;
                     height: 40px;
                     border-radius: 12px;
                     display: inline-flex;
                     align-items: center;
                     justify-content: center;
                     background: rgba(255,255,255,.06);
                     border: 1px solid rgba(255,255,255,.10);
                     color: rgba(255,255,255,.90);
                     text-decoration: none;
                     transition: transform .2s ease, background .2s ease, border-color .2s ease;
                 }

                     .sitm-footer .social a:hover {
                         transform: translateY(-2px);
                         background: rgba(255,255,255,.10);
                         border-color: rgba(255,255,255,.18);
                     }

                     .sitm-footer .social a i {
                         font-size: 1.05rem;
                     }

         /* Mobile compact */
         @@media (max-width: 576px) {
             .sitm-footer .footer-top {
                 padding: 2.25rem 0 1rem 0;
             }

             .sitm-footer .brand-sub {
                 max-width: 100%;
             }

             .sitm-footer .footer-bottom {
                 padding: .9rem 0 1.2rem 0;
             }

             .sitm-footer .social {
                 justify-content: center;
             }
         }

         /* ===== EXCEPCIÓN PARA INDEX ===== */
         .home-page .navbar-sitm .nav-link.active {
             background-color: transparent;
             color: #ffffff !important;
             box-shadow: none;
         }
    </style>


</head>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


<body class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "home-page" : "")">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top navbar-sitm">

        <div class="container-fluid px-4">

            <!-- LOGO / NOMBRE -->
            <a class="navbar-brand fw-bold fs-4" href="/Home/Index">
                SITM
            </a>

            <!-- BOTÓN MÓVIL -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSITM">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENÚ -->
            <div class="collapse navbar-collapse" id="navbarSITM">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-2">

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           href="/Home/Index">
                            Inicio
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Mapa" ? "active" : "")"
                           href="/Home/Mapa">
                            Mapa Turístico
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Eventos" ? "active" : "")"
                           href="/Home/Eventos">
                            Eventos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Comercios" ? "active" : "")"
                           href="/Home/Comercios">
                            Comercios
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Resenas" ? "active" : "")"
                           href="/Home/Resenas">
                            Reseñas
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Perfil" ? "active" : "")"
                           href="/Home/Perfil">
                            Perfil
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MisReservas" ? "active" : "")"
                           href="/Home/MisReservas">
                            Mis Reservas
                        </a>
                    </li>

                    <!-- BOTÓN DESTACADO -->
                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-outline-light fw-semibold px-3"
                           href="/Home/Login">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>
                            Cerrar sesión
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>



    <!-- CONTENIDO -->
    <main id="mainContent" class="mb-5">
        @RenderBody()
    </main>



    <footer class="sitm-footer" role="contentinfo">
        <div class="container">
            <div class="footer-top">
                <div class="row g-4">

                    <!-- Identidad SITM -->
                    <div class="col-12 col-lg-4">
                        <div class="brand-badge mb-3">
                            <i class="bi bi-building"></i>
                            <div>
                                <p class="brand-title mb-0">SITM – Sistema de Información Turística Municipal</p>
                                <small class="text-white-50">Municipalidad</small>
                            </div>
                        </div>

                        <p class="brand-sub">
                            Portal institucional con información oficial para ciudadanos y visitantes:
                            comercios, eventos, reseñas y reservas municipales.
                        </p>

                        <!-- mini highlights (opcional y sobrio) -->
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <span class="badge rounded-pill" style="background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.10);">
                                <i class="bi bi-shield-check me-1"></i> Información verificada
                            </span>
                            <span class="badge rounded-pill" style="background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.10);">
                                <i class="bi bi-geo-alt me-1"></i> Turismo local
                            </span>
                        </div>
                    </div>

                    <!-- Enlaces rápidos -->
                    <div class="col-6 col-lg-2">
                        <h6 class="footer-heading">Enlaces</h6>
                        <ul class="footer-links">
                            <li><a href="@Url.Action("Index","Comercios")"><i class="bi bi-shop"></i> Comercios</a></li>
                            <li><a href="@Url.Action("Index","Eventos")"><i class="bi bi-calendar-event"></i> Eventos</a></li>
                            <li><a href="@Url.Action("Index","Resenas")"><i class="bi bi-chat-square-quote"></i> Reseñas</a></li>
                            <li><a href="@Url.Action("Index","Reservas")"><i class="bi bi-bookmark-check"></i> Mis reservas</a></li>
                            <li><a href="@Url.Action("Index","Perfil")"><i class="bi bi-person-circle"></i> Perfil</a></li>
                        </ul>
                    </div>

                    <!-- Soporte -->
                    <div class="col-6 col-lg-2">
                        <h6 class="footer-heading">Soporte</h6>
                        <ul class="footer-links">
                            <li><a href="@Url.Action("Contacto","Home")"><i class="bi bi-envelope"></i> Contacto</a></li>
                            <li><a href="@Url.Action("Preguntas","Home")"><i class="bi bi-patch-question"></i> Preguntas frecuentes</a></li>
                            <li><a href="@Url.Action("Accesibilidad","Home")"><i class="bi bi-universal-access"></i> Accesibilidad</a></li>
                            <li><a href="@Url.Action("Ayuda","Home")"><i class="bi bi-life-preserver"></i> Centro de ayuda</a></li>
                        </ul>
                    </div>

                    <!-- Contacto municipal -->
                    <div class="col-12 col-lg-4">
                        <h6 class="footer-heading">Contacto municipal</h6>

                        <div class="contact-card">
                            <div class="contact-item mb-2">
                                <i class="bi bi-geo-alt"></i>
                                <div>
                                    <div class="fw-semibold text-white">Sede municipal</div>
                                    <div class="text-white-50">San Carlos, Costa Rica</div>
                                </div>
                            </div>

                            <div class="contact-item mb-2">
                                <i class="bi bi-telephone"></i>
                                <div>
                                    <div class="fw-semibold text-white">Teléfono</div>
                                    <div class="text-white-50">+506 0000-0000</div>
                                </div>
                            </div>

                            <div class="contact-item">
                                <i class="bi bi-envelope"></i>
                                <div>
                                    <div class="fw-semibold text-white">Correo</div>
                                    <div class="text-white-50">sitm@municipalidad.go.cr</div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <a href="@Url.Action("Index","Comercios")"
                                   class="btn btn-sm"
                                   style="background:#145544; color:#fff; border-radius:12px; font-weight:800; padding:.55rem .85rem;">
                                    <i class="bi bi-compass me-1"></i> Explorar el portal
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

                <hr class="divider" />

                <!-- Footer bottom -->
                <div class="footer-bottom">
                    <div class="row align-items-center">

                        <!-- IZQUIERDA -->
                        <div class="col-12 col-md-7">
                            <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">
                                <span>© @DateTime.Now.Year Municipalidad — SITM</span>

                                <span class="d-none d-md-inline text-white-50">•</span>

                                <div class="legal-links d-flex flex-wrap gap-3">
                                    <a href="#">Política de privacidad</a>
                                    <a href="#">Términos de uso</a>
                                    <a href="#">Aviso legal</a>
                                </div>
                            </div>
                        </div>

                        <!-- DERECHA (REDES BIEN ALINEADAS) -->
                        <div class="col-12 col-md-5 text-md-end mt-3 mt-md-0">
                            <div class="social d-inline-flex">
                                <a href="#" aria-label="Sitio institucional"><i class="bi bi-globe2"></i></a>
                                <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                                <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                                <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </footer>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SECCIÓN DE SCRIPTS PERSONALIZADOS -->
    <!-- Esta línea es CRÍTICA para evitar el error -->
    @RenderSection("Scripts", required: false)

</body>
</html>
