</div>

<!-- =========================
     MODAL EVENTO (Crear/Editar)
========================= -->
<div class="modal fade" id="modalEvento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 18px; overflow:hidden;">
            <div class="modal-header ev-modal-header">
                <h5 id="evModalTitle" class="modal-title fw-bold">
                    <i class="bi bi-calendar2-event me-2"></i>
                    Evento
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <!-- Nota: listo para conectar a ViewModel / API -->
                <input type="hidden" id="evId" value="" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold ev-required">Nombre del evento</label>
                        <input id="evNombre" type="text" class="form-control" placeholder="Ej: Feria Artesanal Municipal" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold ev-required">Tipo de evento</label>
                        <select id="evTipoModal" class="form-select">
                            <option value="">Seleccione...</option>
                            <option>Cultural</option>
                            <option>Gastronómico</option>
                            <option>Turismo</option>
                            <option>Deportivo</option>
                            <option>Educativo</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold ev-required">Fecha</label>
                        <input id="evFecha" type="date" class="form-control" />
                        <small class="text-muted">Se usará para determinar si es Próximo o Finalizado (si lo automatizas luego).</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold ev-required">Ubicación</label>
                        <input id="evUbicacion" type="text" class="form-control" placeholder="Ej: Parque Central" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Descripción</label>
                        <textarea id="evDescripcion" class="form-control" rows="3" placeholder="Describe el evento de forma breve y clara..."></textarea>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-3" style="background: rgba(27,122,92,.06); border:1px dashed rgba(15,61,46,.18);">
                            <div class="d-flex gap-2 align-items-start">
                                <i class="bi bi-lightbulb" style="color: rgba(15,61,46,.6);"></i>
                                <div class="small text-muted">
                                    Sugerencia UX: más adelante puedes agregar <b>imagen del evento</b>, <b>organizador</b>, <b>cupos</b> y <b>enlace</b> para registro.
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button id="evSave" type="button" class="btn btn-ev text-white px-3">
                    <i class="bi bi-check2-circle me-1"></i>
                    Guardar
                </button>
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- =========================
     MODAL DETALLE (solo UI/UX)
========================= -->
<div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 18px; overflow:hidden;">
            <div class="modal-header" style="background: rgba(27,122,92,.10); border-bottom: 1px solid rgba(15,61,46,.12);">
                <h5 class="modal-title fw-bold" style="color: var(--ev-green-900);">
                    <i class="bi bi-eye me-2"></i>
                    Detalle del evento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <h5 id="detNombre" class="fw-bold mb-1" style="color: var(--ev-green-900);">—</h5>
                        <div class="d-flex flex-wrap gap-2">
                            <span id="detEstado" class="badge rounded-pill badge-soft">—</span>
                            <span id="detTipo" class="badge rounded-pill badge-soft">—</span>
                            <span id="detFecha" class="ev-date-chip"><i class="bi bi-calendar3"></i> —</span>
                            <span id="detUbicacion" class="ev-date-chip"><i class="bi bi-geo-alt"></i> —</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-3" style="border:1px solid rgba(15,61,46,.12); background:#fff;">
                            <div class="small text-muted mb-1">Descripción</div>
                            <div id="detDescripcion" class="mb-0">—</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Esto es UI mock. Luego lo conectas a tu ViewModel / BD / API sin cambiar el diseño.
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    // =========================
    // JS PURO - filtros + interacciones
    // Listo para reemplazar por datos reales del controlador / ViewModel / API
    // =========================

    (function () {
        const tbody = document.getElementById('evTbody');
        const rows = () => Array.from(tbody.querySelectorAll('.ev-row'));

        const search = document.getElementById('evSearch');
        const estado = document.getElementById('evEstado');
        const tipo = document.getElementById('evTipo');
        const clear = document.getElementById('evClear');
        const count = document.getElementById('evCount');
        const empty = document.getElementById('evEmpty');

        const modalEventoEl = document.getElementById('modalEvento');
        const modalDetalleEl = document.getElementById('modalDetalle');

        const evId = document.getElementById('evId');
        const evNombre = document.getElementById('evNombre');
        const evTipoModal = document.getElementById('evTipoModal');
        const evFecha = document.getElementById('evFecha');
        const evUbicacion = document.getElementById('evUbicacion');
        const evDescripcion = document.getElementById('evDescripcion');
        const evModalTitle = document.getElementById('evModalTitle');

        const btnNuevo = document.getElementById('btnNuevoEvento');
        const btnSave = document.getElementById('evSave');

        // Helpers
        function formatDateISOToCR(iso) {
            // iso: yyyy-mm-dd -> dd/mm/yyyy
            if (!iso || iso.length < 10) return '';
            const y = iso.slice(0, 4);
            const m = iso.slice(5, 7);
            const d = iso.slice(8, 10);
            return `${d}/${m}/${y}`;
        }

        function badgeForEstado(value) {
            const v = (value || '').toLowerCase();
            if (v === 'activo') return 'badge-soft';
            if (v === 'próximo' || v === 'proximo') return 'badge-soft-warning';
            if (v === 'finalizado') return 'badge-soft-secondary';
            if (v === 'inactivo') return 'badge-soft-secondary';
            return 'badge-soft';
        }

        function applyFilters() {
            const q = (search.value || '').trim().toLowerCase();
            const st = (estado.value || '').trim().toLowerCase();
            const tp = (tipo.value || '').trim().toLowerCase();

            let visible = 0;

            rows().forEach(r => {
                const nombre = (r.dataset.nombre || '').toLowerCase();
                const ubicacion = (r.dataset.ubicacion || '').toLowerCase();
                const est = (r.dataset.estado || '').toLowerCase();
                const tip = (r.dataset.tipo || '').toLowerCase();

                const matchQ = !q || nombre.includes(q) || ubicacion.includes(q);
                const matchE = !st || est === st;
                const matchT = !tp || tip === tp;

                const show = matchQ && matchE && matchT;
                r.classList.toggle('d-none', !show);
                if (show) visible++;
            });

            count.textContent = `Mostrando ${visible} evento${visible === 1 ? '' : 's'}`;
            empty.classList.toggle('d-none', visible !== 0);
        }

        function resetModal() {
            evId.value = '';
            evNombre.value = '';
            evTipoModal.value = '';
            evFecha.value = '';
            evUbicacion.value = '';
            evDescripcion.value = '';
            evModalTitle.innerHTML = `<i class="bi bi-plus-lg me-2"></i>Nuevo evento`;
        }

        function fillModalFromRow(row) {
            evId.value = row.dataset.id || '';
            evNombre.value = row.dataset.nombre || '';
            evTipoModal.value = row.dataset.tipo || '';
            evFecha.value = row.dataset.fecha || '';
            evUbicacion.value = row.dataset.ubicacion || '';
            evDescripcion.value = row.dataset.descripcion || '';
            evModalTitle.innerHTML = `<i class="bi bi-pencil-square me-2"></i>Editar evento`;
        }

        function openDetalle(row) {
            document.getElementById('detNombre').textContent = row.dataset.nombre || '—';

            const detEstado = document.getElementById('detEstado');
            detEstado.className = `badge rounded-pill ${badgeForEstado(row.dataset.estado)}`;
            detEstado.innerHTML = `<i class="bi bi-flag me-1"></i>${row.dataset.estado || '—'}`;

            const detTipo = document.getElementById('detTipo');
            detTipo.className = `badge rounded-pill ${badgeForEstado(row.dataset.tipo)}`; // sirve como "soft"
            detTipo.innerHTML = `<i class="bi bi-tag me-1"></i>${row.dataset.tipo || '—'}`;

            document.getElementById('detFecha').innerHTML = `<i class="bi bi-calendar3"></i> ${formatDateISOToCR(row.dataset.fecha) || '—'}`;
            document.getElementById('detUbicacion').innerHTML = `<i class="bi bi-geo-alt"></i> ${row.dataset.ubicacion || '—'}`;
            document.getElementById('detDescripcion').textContent = row.dataset.descripcion || '—';

            const modal = bootstrap.Modal.getOrCreateInstance(modalDetalleEl);
            modal.show();
        }

        // Tooltips (Bootstrap 5)
        function initTooltips() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (el) {
                new bootstrap.Tooltip(el);
            });
        }

        // Events
        search.addEventListener('input', applyFilters);
        estado.addEventListener('change', applyFilters);
        tipo.addEventListener('change', applyFilters);

        clear.addEventListener('click', function () {
            search.value = '';
            estado.value = '';
            tipo.value = '';
            applyFilters();
            search.focus();
        });

        btnNuevo.addEventListener('click', function () {
            resetModal();
        });

        // Delegación de eventos en tabla
        tbody.addEventListener('click', function (e) {
            const row = e.target.closest('.ev-row');
            if (!row) return;

            const btnView = e.target.closest('.ev-btn-view');
            const btnEdit = e.target.closest('.ev-btn-edit');
            const btnToggle = e.target.closest('.ev-btn-toggle');
            const btnDelete = e.target.closest('.ev-btn-delete');

            if (btnView) {
                openDetalle(row);
                return;
            }

            if (btnEdit) {
                fillModalFromRow(row);
                return;
            }

            if (btnToggle) {
                const current = row.dataset.estado || 'Inactivo';
                const isActive = current.toLowerCase() === 'activo';
                const next = isActive ? 'Inactivo' : 'Activo';

                // UI update (mock)
                row.dataset.estado = next;

                // Actualiza badge en la columna Estado
                const estadoCell = row.querySelector('td:nth-child(5) .badge');
                if (estadoCell) {
                    estadoCell.className = `badge rounded-pill ${badgeForEstado(next)}`;
                    estadoCell.innerHTML = (next.toLowerCase() === 'activo')
                        ? `<i class="bi bi-check2-circle me-1"></i>${next}`
                        : `<i class="bi bi-slash-circle me-1"></i>${next}`;
                }

                // Actualiza tooltip e icono del botón
                const icon = btnToggle.querySelector('i');
                if (icon) icon.className = isActive ? 'bi bi-play-circle' : 'bi bi-pause-circle';
                btnToggle.setAttribute('data-bs-title', isActive ? 'Activar' : 'Desactivar');

                // Re-inicializa tooltips para que tome el nuevo title
                initTooltips();

                // Reaplica filtros por si el usuario filtraba por estado
                applyFilters();
                return;
            }

            if (btnDelete) {
                const name = row.dataset.nombre || 'este evento';
                const ok = confirm(`¿Seguro que deseas eliminar "${name}"? Esta acción no se puede deshacer.`);
                if (!ok) return;

                // Mock delete
                row.remove();
                applyFilters();
                return;
            }
        });

        // Guardar (mock)
        btnSave.addEventListener('click', function () {
            // Validación mínima (mock)
            if (!evNombre.value.trim() || !evTipoModal.value.trim() || !evFecha.value || !evUbicacion.value.trim()) {
                alert('Completa los campos obligatorios: Nombre, Tipo, Fecha y Ubicación.');
                return;
            }

            // Aquí luego llamas a tu API / POST del controlador
            // Por ahora, cerramos modal (mock) y avisamos
            const modal = bootstrap.Modal.getOrCreateInstance(modalEventoEl);
            modal.hide();
            alert('Guardado (mock). Conecta esto a tu Controller/ViewModel cuando estés listo.');
        });

        // Al abrir modal por "Editar" el título ya se setea; si se abre sin data, se queda como Nuevo
        modalEventoEl.addEventListener('show.bs.modal', function () {
            // Si venía sin ID, estamos creando
            if (!evId.value) {
                // aseguremos estado limpio
                // (si el usuario abrió "Nuevo" y luego reabrió)
                if (!evNombre.value && !evTipoModal.value && !evFecha.value && !evUbicacion.value) {
                    resetModal();
                }
            }
        });

        // Init
        applyFilters();
        initTooltips();

    })();
</script>