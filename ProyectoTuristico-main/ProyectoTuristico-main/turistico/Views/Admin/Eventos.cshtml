                                <span class="ev-date-chip">
                                    <i class="bi bi-calendar3"></i>
                                    15/08/2025
                                </span>
                            </td>
                            <td>Parque Central</td>
                            <td>
                                <span class="badge rounded-pill badge-soft">
                                    <i class="bi bi-check2-circle me-1"></i>Activo
                                </span>
                            </td>
                            <td class="text-end ev-actions">
                                <button class="btn btn-outline-secondary btn-sm ev-btn-view"
                                        type="button"
