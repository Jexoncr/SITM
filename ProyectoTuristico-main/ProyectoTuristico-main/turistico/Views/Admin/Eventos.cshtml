                                </button>
                                <button class="btn btn-outline-success btn-sm ev-btn-toggle"
                                        type="button"
                                        data-bs-toggle="tooltip" data-bs-title="Activar">
                                    <i class="bi bi-play-circle"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm ev-btn-delete"
                                        type="button"
