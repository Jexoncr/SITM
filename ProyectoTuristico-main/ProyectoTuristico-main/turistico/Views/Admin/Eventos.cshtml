@{
    ViewBag.Title = "Gestión de Eventos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- =========================
     EVENTOS - ADMIN (SITM)
     Coherente con Dashboard/Comercios (verde institucional + neutros)
========================= -->

<style>
    /* Scoped: solo afecta esta vista (prefijo ev-) */
    :root {
        --ev-green-900: #0f3d2e; /* institucional oscuro */
        --ev-green-700: #1b7a5c;
        --ev-green-600: #238b6d;
        --ev-surface: #ffffff;
        --ev-muted: #6c757d;
        --ev-border: rgba(15,61,46,.12);
        --ev-shadow: 0 12px 30px rgba(0,0,0,.06);
        --ev-shadow-soft: 0 10px 24px rgba(0,0,0,.08);
        --ev-radius: 16px;
    }

    .ev-page {
        padding-bottom: 1rem;
    }

    .ev-header {
        background: linear-gradient(135deg, rgba(27,122,92,.14), rgba(255,255,255,0));
        border: 1px solid var(--ev-border);
        border-radius: var(--ev-radius);
        padding: 1.25rem 1.25rem;
        box-shadow: var(--ev-shadow);
        position: relative;
        overflow: hidden;
    }

        .ev-header::after {
            content: "";
            position: absolute;
            inset: -40% -30% auto auto;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle at 30% 30%, rgba(46,158,127,.25), transparent 60%);
            transform: rotate(18deg);
            pointer-events: none;
        }

    .ev-title {
        letter-spacing: .2px;
    }

    .ev-subtitle {
        max-width: 64ch;
    }

    .ev-toolbar {
        margin-top: 1rem;
        background: var(--ev-surface);
        border: 1px solid var(--ev-border);
        border-radius: var(--ev-radius);
        box-shadow: var(--ev-shadow);
        padding: .9rem;
    }

    .ev-input-icon {
        position: relative;
    }

        .ev-input-icon .bi {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(15,61,46,.55);
            font-size: 1.05rem;
            pointer-events: none;
        }

        .ev-input-icon input {
            padding-left: 2.35rem;
        }

    .ev-card {
        margin-top: 1rem;
        border: 1px solid var(--ev-border);
        border-radius: var(--ev-radius);
        box-shadow: var(--ev-shadow);
        overflow: hidden;
        background: var(--ev-surface);
    }

    .ev-table thead th {
        position: sticky;
        top: 0;
        background: rgba(27,122,92,.10);
        color: #123b2e;
        border-bottom: 1px solid rgba(15,61,46,.14) !important;
        font-weight: 700;
        letter-spacing: .2px;
        z-index: 1;
    }

    .ev-table tbody tr {
        transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease;
    }

        .ev-table tbody tr:hover {
            background: rgba(27,122,92,.045);
            box-shadow: 0 6px 18px rgba(0,0,0,.06);
            transform: translateY(-1px);
        }

    .ev-row-accent {
        width: 10px;
        border-radius: 999px;
        height: 44px;
        background: rgba(27,122,92,.18);
        display: inline-block;
        vertical-align: middle;
        margin-right: .65rem;
    }

    .ev-event-name {
        font-weight: 700;
        color: #1c2b2a;
        margin: 0;
        line-height: 1.15;
    }

    .ev-event-meta {
        font-size: .86rem;
        color: var(--ev-muted);
        margin: 0;
    }

    /* Badges "soft" coherentes */
    .badge-soft {
        border: 1px solid rgba(15,61,46,.18);
        background: rgba(27,122,92,.10);
        color: #0f3d2e;
        font-weight: 700;
        padding: .42rem .65rem;
    }

    .badge-soft-warning {
        border: 1px solid rgba(255,193,7,.35);
        background: rgba(255,193,7,.15);
        color: #7a5a00;
        font-weight: 700;
        padding: .42rem .65rem;
    }

    .badge-soft-secondary {
        border: 1px solid rgba(108,117,125,.35);
        background: rgba(108,117,125,.15);
        color: #495057;
        font-weight: 700;
        padding: .42rem .65rem;
    }

    .badge-soft-danger {
        border: 1px solid rgba(220,53,69,.30);
        background: rgba(220,53,69,.12);
        color: #b02a37;
        font-weight: 700;
        padding: .42rem .65rem;
    }

    .ev-date-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .34rem .55rem;
        border-radius: 999px;
        background: rgba(15,61,46,.06);
        border: 1px solid rgba(15,61,46,.12);
        color: #1f2d2b;
        font-weight: 600;
        font-size: .9rem;
        white-space: nowrap;
    }

    .ev-actions .btn {
        border-radius: 999px;
    }

    .btn-ev {
        background: linear-gradient(90deg, var(--ev-green-700), var(--ev-green-600));
        border: none;
        box-shadow: 0 10px 18px rgba(27,122,92,.18);
        transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
    }

        .btn-ev:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 22px rgba(27,122,92,.22);
            filter: saturate(1.02);
        }

        .btn-ev:active {
            transform: translateY(0);
            box-shadow: 0 10px 18px rgba(27,122,92,.18);
        }

    .ev-empty {
        padding: 2.4rem 1.5rem;
        text-align: center;
        color: var(--ev-muted);
    }

    .ev-modal-header {
        background: linear-gradient(90deg, var(--ev-green-700), var(--ev-green-600));
        color: #fff;
    }

    .ev-required::after {
        content: " *";
        color: #dc3545;
        font-weight: 700;
    }

    /* Pequeña animación de aparición */
    .ev-fade-up {
        animation: evFadeUp .35s ease both;
    }

    @@keyframes evFadeUp {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* En móviles: acciones se apilan mejor */
    @@media (max-width: 576px) {
        .ev-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .4rem;
            justify-content: flex-end;
        }

        .ev-date-chip {
            font-size: .85rem;
        }
    }
</style>

<div class="ev-page container-fluid px-0">

    <!-- Header -->
    <div class="ev-header ev-fade-up">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div>
                <h2 class="ev-title fw-bold mb-1" style="color: var(--ev-green-900);">
                    <i class="bi bi-calendar2-event me-2"></i>
                    Gestión de Eventos y Actividades
                </h2>
                <p class="ev-subtitle text-muted mb-0">
                    Administra ferias, actividades culturales, deportivas y eventos turísticos del cantón con estados claros y acciones rápidas.
                </p>
            </div>

            <!-- CTA Nuevo -->
            <div class="d-flex gap-2">
                <button id="btnNuevoEvento"
                        class="btn btn-ev text-white px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#modalEvento">
                    <i class="bi bi-plus-lg me-1"></i>
                    Nuevo evento
