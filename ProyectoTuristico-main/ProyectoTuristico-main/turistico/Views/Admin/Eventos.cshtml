            </div>

            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small id="evCount" class="text-muted">
                        Mostrando 0 eventos
                    </small>

                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Tip: pasa el mouse sobre una fila para ver el efecto “admin moderno”.
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla (Card) -->
    <div class="ev-card ev-fade-up">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table ev-table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="min-width: 320px;">Evento</th>
                            <th style="min-width: 140px;">Tipo</th>
                            <th style="min-width: 160px;">Fecha</th>
                            <th style="min-width: 190px;">Ubicación</th>
                            <th style="min-width: 140px;">Estado</th>
                            <th class="text-end" style="min-width: 240px;">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="evTbody">

                        <!-- MOCK ROW 1 -->
                        <tr class="ev-row"
