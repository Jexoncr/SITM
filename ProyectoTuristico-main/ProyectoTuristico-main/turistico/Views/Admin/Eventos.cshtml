                        <!-- MOCK ROW 2 -->
                        <tr class="ev-row"
                            data-id="2"
                            data-nombre="Feria Gastronómica"
                            data-tipo="Gastronómico"
                            data-fecha="2025-09-22"
                            data-ubicacion="Plaza Municipal"
                            data-estado="Próximo"
                            data-descripcion="Feria con emprendimientos, degustaciones y música en vivo.">
                            <td>
                                <span class="ev-row-accent"></span>
                                <div class="d-inline-block align-middle">
                                    <p class="ev-event-name">Feria Gastronómica</p>
                                    <p class="ev-event-meta">
                                        <i class="bi bi-geo-alt me-1"></i>Plaza Municipal
                                    </p>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill badge-soft-warning">
                                    <i class="bi bi-egg-fried me-1"></i>Gastronómico
                                </span>
                            </td>
                            <td>
                                <span class="ev-date-chip">
                                    <i class="bi bi-calendar3"></i>
                                    22/09/2025
                                </span>
                            </td>
                            <td>Plaza Municipal</td>
                            <td>
                                <span class="badge rounded-pill badge-soft-warning">
                                    <i class="bi bi-clock-history me-1"></i>Próximo
                                </span>
                            </td>
                            <td class="text-end ev-actions">
                                <button class="btn btn-outline-secondary btn-sm ev-btn-view"
                                        type="button"
                                        data-bs-toggle="tooltip" data-bs-title="Ver detalle">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-outline-primary btn-sm ev-btn-edit"
                                        type="button"
