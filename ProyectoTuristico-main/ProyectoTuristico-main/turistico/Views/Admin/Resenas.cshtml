@{
    ViewBag.Title = "Moderación de Reseñas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    // 🔌 MOCK DATA (Reemplazar por tu ViewModel / DB / API cuando lo conectes)
    // Sugerencia futura: pasar una lista desde el Controller (Model o ViewBag).
    var mock = new[]
    {
        new { Id=101, Usuario="Juan Pérez",   Elemento="Hotel Mirador Verde",        Tipo="Comercio", Rating=5, Comentario="Excelente atención y muy buena ubicación.", Fecha="2026-02-01 10:15", Estado="Pendiente" },
        new { Id=102, Usuario="María González",Elemento="Festival Cultural Municipal",Tipo="Evento",   Rating=4, Comentario="Muy bien organizado, aunque había mucha gente.",   Fecha="2026-01-30 16:40", Estado="Aprobada"  },
        new { Id=103, Usuario="Carlos Rodríguez",Elemento="Restaurante Sabores Típicos",Tipo="Comercio",Rating=2, Comentario="La comida estuvo bien, pero el servicio fue lento.", Fecha="2026-01-28 12:05", Estado="Rechazada" },
        new { Id=104, Usuario="Ana Morales",  Elemento="Sendero Río Celeste (Sector Norte)", Tipo="Lugar", Rating=5, Comentario="Paisaje increíble. Señalización clara y segura.", Fecha="2026-01-27 08:22", Estado="Aprobada" },
        new { Id=105, Usuario="Luis Vargas",  Elemento="Parque Central",              Tipo="Lugar",    Rating=3, Comentario="Bonito, pero faltan basureros y mantenimiento.",      Fecha="2026-01-25 19:11", Estado="Pendiente" },
    };

    // Fuente de datos (mock por defecto). Si luego pasás algo en ViewBag.Resenas, lo toma.
    var resenas = (IEnumerable<dynamic>)(ViewBag.Resenas ?? mock);

    // KPIs rápidos (funcionan con mock; con Model también, si trae Estado)
    int total = 0, pendientes = 0, aprobadas = 0, rechazadas = 0;
    foreach (var r in resenas)
    {
        total++;
        var est = (string)r.Estado;
        if (est == "Pendiente")
        {
            pendientes++;
        }
        else if (est == "Aprobada")
        {
            aprobadas++;
        }
        else if (est == "Rechazada")
        {
            rechazadas++;
        }

    }

    // Helpers UI
    Func<string, string> estadoBadge = (estado) =>
    {
        switch (estado)
        {
            case "Pendiente": return "badge-soft-warning";
            case "Aprobada": return "badge-soft-success";
            case "Rechazada": return "badge-soft-danger";
            default: return "badge-soft-muted";
        }
    };

    Func<string, string> tipoChip = (tipo) =>
    {
        switch (tipo)
        {
            case "Comercio": return "chip-soft-primary";
            case "Evento": return "chip-soft-info";
            case "Lugar": return "chip-soft-secondary";
            default: return "chip-soft-muted";
        }
    };

    Func<string, string> initials = (name) =>
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ');
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper();
    };
}

<style>
    /* ====== Scoped styles para esta vista (alineado a panel admin moderno) ====== */
    .reviews-page {
        --sitm-green: #1b7a5c;
        --sitm-green-2: #2e9e7f;
        --ink: #0f172a;
        --muted: #64748b;
        --border: rgba(15, 23, 42, .08);
        --shadow: 0 10px 30px rgba(15, 23, 42, .08);
    }

        .reviews-page .page-title {
            letter-spacing: .2px;
        }

        .reviews-page .subtle {
            color: var(--muted);
        }

        .reviews-page .panel-card {
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: var(--shadow);
            overflow: hidden;
            background: #fff;
        }

        .reviews-page .toolbar {
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: .85rem;
            background: rgba(255,255,255,.9);
            backdrop-filter: blur(10px);
        }

        .reviews-page .kpi {
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 1rem;
            background: linear-gradient(180deg, rgba(27,122,92,.08), rgba(27,122,92,0));
            transition: transform .18s ease, box-shadow .18s ease;
        }

            .reviews-page .kpi:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 28px rgba(15, 23, 42, .08);
            }

            .reviews-page .kpi .kpi-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                background: rgba(27,122,92,.12);
                color: var(--sitm-green);
                flex: 0 0 auto;
            }

            .reviews-page .kpi .kpi-value {
                font-size: 1.35rem;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.1;
            }

            .reviews-page .kpi .kpi-label {
                font-size: .9rem;
                color: var(--muted);
                margin: 0;
            }

        /* Tabla moderna */
        .reviews-page .table-modern thead th {
            font-weight: 700;
            font-size: .9rem;
            color: rgba(255,255,255,.95);
            border: 0;
            background: linear-gradient(90deg, var(--sitm-green), var(--sitm-green-2));
        }

        .reviews-page .table-modern tbody tr {
            transition: transform .12s ease, background-color .12s ease;
        }

            .reviews-page .table-modern tbody tr:hover {
                background: rgba(27,122,92,.04);
            }

        .reviews-page .cell-user {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-width: 190px;
        }

        .reviews-page .avatar-initials {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-weight: 800;
            color: #fff;
            background: linear-gradient(180deg, var(--sitm-green), var(--sitm-green-2));
            box-shadow: 0 10px 18px rgba(27,122,92,.25);
            flex: 0 0 auto;
        }

        .reviews-page .comment-snippet {
            max-width: 420px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            color: var(--muted);
            font-size: .92rem;
        }

        .reviews-page .rating i {
            font-size: .95rem;
            vertical-align: -1px;
            margin-right: 1px;
        }

        .reviews-page .actions {
            display: inline-flex;
            gap: .4rem;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
        }

        .reviews-page .btn-icon {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: inline-grid;
            place-items: center;
            border: 1px solid var(--border);
            background: #fff;
            transition: transform .12s ease, box-shadow .12s ease, background-color .12s ease;
        }

            .reviews-page .btn-icon:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 18px rgba(15, 23, 42, .08);
                background: rgba(27,122,92,.04);
            }

            .reviews-page .btn-icon:active {
                transform: translateY(0);
            }

        /* Badges suaves (institucionales) */
        .reviews-page .badge-soft-success {
            background: rgba(34,197,94,.12);
            color: #15803d;
            border: 1px solid rgba(34,197,94,.25);
        }

        .reviews-page .badge-soft-warning {
            background: rgba(245,158,11,.14);
            color: #92400e;
            border: 1px solid rgba(245,158,11,.28);
        }

        .reviews-page .badge-soft-danger {
            background: rgba(239,68,68,.12);
            color: #b91c1c;
            border: 1px solid rgba(239,68,68,.25);
        }

        .reviews-page .badge-soft-muted {
            background: rgba(100,116,139,.12);
            color: #334155;
            border: 1px solid rgba(100,116,139,.24);
        }

        .reviews-page .chip {
            font-size: .78rem;
            padding: .35rem .6rem;
            border-radius: 999px;
            border: 1px solid transparent;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            white-space: nowrap;
        }

        .reviews-page .chip-soft-primary {
            background: rgba(59,130,246,.12);
            color: #1d4ed8;
            border-color: rgba(59,130,246,.22);
        }

        .reviews-page .chip-soft-info {
            background: rgba(14,165,233,.12);
            color: #0369a1;
            border-color: rgba(14,165,233,.22);
        }

        .reviews-page .chip-soft-secondary {
            background: rgba(99,102,241,.12);
            color: #4338ca;
            border-color: rgba(99,102,241,.22);
        }

        .reviews-page .chip-soft-muted {
            background: rgba(100,116,139,.10);
            color: #334155;
            border-color: rgba(100,116,139,.18);
        }

        /* Modal */
        .reviews-page .modal-header.sitm {
            background: linear-gradient(90deg, var(--sitm-green), var(--sitm-green-2));
            color: #fff;
            border: 0;
        }

        .reviews-page .modal-content {
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
        }

        .reviews-page .detail-block {
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: .85rem;
            background: rgba(15, 23, 42, .02);
        }

        .reviews-page .detail-label {
            color: var(--muted);
            font-size: .82rem;
            margin-bottom: .15rem;
        }

        .reviews-page .detail-value {
            color: var(--ink);
            font-weight: 700;
            margin: 0;
        }

        .reviews-page .fade-in {
            animation: sitmFade .45s ease both;
        }

    @@keyframes sitmFade {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="reviews-page">

    <!-- Header -->
    <div class="d-flex align-items-start align-items-md-center justify-content-between gap-3 mb-3 fade-in">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="rounded-3 d-inline-grid place-items-center"
                      style="width:40px;height:40px;background:rgba(27,122,92,.12);color:#1b7a5c;">
                    <i class="bi bi-chat-square-text fs-5"></i>
                </span>
                <div>
                    <h2 class="page-title fw-bold mb-1" style="color:#0f172a;">
                        Moderación de Opiniones y Reseñas
                    </h2>
                    <div class="subtle">
                        Gestión institucional de contenido: revisión, aprobación, rechazo y ocultamiento.
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-success rounded-pill px-3"
                    type="button" id="btnResetFilters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Restablecer
            </button>
            <button class="btn btn-success rounded-pill px-3"
                    type="button" id="btnExportMock">
                <i class="bi bi-download me-1"></i> Exportar (mock)
            </button>
        </div>
    </div>

    <!-- KPIs + Toolbar -->
    <div class="row g-3 mb-3 fade-in">
        <div class="col-12 col-lg-7">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="kpi d-flex align-items-center gap-2 h-100">
                        <div class="kpi-icon"><i class="bi bi-collection"></i></div>
                        <div>
                            <div class="kpi-value" id="kpiTotal">@total</div>
                            <p class="kpi-label mb-0">Total</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi d-flex align-items-center gap-2 h-100">
                        <div class="kpi-icon" style="background:rgba(245,158,11,.14);color:#92400e;">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div>
                            <div class="kpi-value" id="kpiPend">@pendientes</div>
                            <p class="kpi-label mb-0">Pendientes</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi d-flex align-items-center gap-2 h-100">
                        <div class="kpi-icon" style="background:rgba(34,197,94,.12);color:#15803d;">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <div>
                            <div class="kpi-value" id="kpiApro">@aprobadas</div>
                            <p class="kpi-label mb-0">Aprobadas</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi d-flex align-items-center gap-2 h-100">
                        <div class="kpi-icon" style="background:rgba(239,68,68,.12);color:#b91c1c;">
                            <i class="bi bi-x-circle"></i>
                        </div>
                        <div>
                            <div class="kpi-value" id="kpiRech">@rechazadas</div>
                            <p class="kpi-label mb-0">Rechazadas</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Toolbar filtros -->
        <div class="col-12 col-lg-5">
            <div class="toolbar h-100">
                <div class="row g-2 align-items-center">
                    <div class="col-12">
                        <div class="input-group">
                            <span class="input-group-text bg-white" style="border-color: rgba(15,23,42,.08);">
                                <i class="bi bi-search text-success"></i>
                            </span>
                            <input type="text" class="form-control"
                                   id="searchBox"
                                   placeholder="Buscar por usuario, elemento o comentario..."
                                   style="border-color: rgba(15,23,42,.08);" />
                        </div>
                    </div>

                    <div class="col-6">
                        <select class="form-select" id="filterEstado" style="border-color: rgba(15,23,42,.08);">
                            <option value="">Todos los estados</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Aprobada">Aprobada</option>
                            <option value="Rechazada">Rechazada</option>
                            <option value="Oculta">Oculta</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <select class="form-select" id="filterTipo" style="border-color: rgba(15,23,42,.08);">
                            <option value="">Todos los tipos</option>
                            <option value="Comercio">Comercio</option>
                            <option value="Evento">Evento</option>
                            <option value="Lugar">Lugar</option>
                        </select>
                    </div>

                    <div class="col-12 d-flex justify-content-between align-items-center mt-1">
                        <small class="subtle">
                            <i class="bi bi-shield-check me-1"></i>

                        </small>
                        <small class="subtle">
                            Mostrando: <span id="shownCount" class="fw-bold">0</span>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="panel-card fade-in">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-modern table-hover align-middle mb-0" id="reviewsTable">
                    <thead>
                        <tr>
                            <th class="ps-3">Usuario</th>
                            <th>Elemento</th>
                            <th>Tipo</th>
                            <th>Calificación</th>
                            <th>Comentario</th>
                            <th>Estado</th>
                            <th class="text-center pe-3">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var r in resenas)
                        {
                            string est = (string)r.Estado;
                            string tipo = (string)r.Tipo;
                            int rating = (int)r.Rating;
                            string comment = (string)r.Comentario;

                            <tr class="review-row"
                                data-id="@r.Id"
                                data-usuario="@r.Usuario"
                                data-elemento="@r.Elemento"
                                data-tipo="@tipo"
                                data-rating="@rating"
                                data-fecha="@r.Fecha"
                                data-estado="@est"
                                data-comentario="@comment">

                                <td class="ps-3">
                                    <div class="cell-user">
                                        <div class="avatar-initials">@initials((string)r.Usuario)</div>
                                        <div>
                                            <div class="fw-bold" style="color:#0f172a;">@r.Usuario</div>
                                            <small class="subtle">@r.Fecha</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-semibold" style="color:#0f172a;">@r.Elemento</div>
                                    <small class="subtle">ID Reseña: #@r.Id</small>
                                </td>

                                <td>
                                    <span class="chip @tipoChip(tipo)">
                                        <i class="bi bi-tag"></i> @tipo
                                    </span>
                                </td>

                                <td>
                                    <div class="rating" aria-label="Calificación @rating de 5">
                                        @{
                                            for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= rating)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-warning"></i>
                                                }
                                            }
                                        }
                                        <span class="ms-1 subtle fw-semibold">@rating/5</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="comment-snippet">@comment</div>
                                </td>

                                <td>
                                    <span class="badge @estadoBadge(est) px-3 py-2 rounded-pill fw-semibold">
                                        @est
                                    </span>
                                </td>

                                <td class="text-center pe-3">
                                    <div class="actions">
                                        <button type="button"
                                                class="btn-icon"
                                                data-action="ver"
                                                data-bs-toggle="tooltip"
                                                title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        <button type="button"
                                                class="btn-icon"
                                                data-action="aprobar"
                                                data-bs-toggle="tooltip"
                                                title="Aprobar"
                                                @(est == "Aprobada" ? "disabled" : "")>
                                            <i class="bi bi-check2-circle text-success"></i>
                                        </button>

                                        <button type="button"
                                                class="btn-icon"
                                                data-action="rechazar"
                                                data-bs-toggle="tooltip"
                                                title="Rechazar"
                                                @(est == "Rechazada" ? "disabled" : "")>
                                            <i class="bi bi-x-circle text-danger"></i>
                                        </button>

                                        <button type="button"
                                                class="btn-icon"
                                                data-action="ocultar"
                                                data-bs-toggle="tooltip"
                                                title="Ocultar">
                                            <i class="bi bi-eye-slash text-warning"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-3 py-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 border-top"
                 style="border-color: rgba(15,23,42,.08) !important;">
                <small class="subtle">
                    <i class="bi bi-info-circle me-1"></i>

                </small>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-success rounded-pill btn-sm px-3" type="button" id="btnMarkAllPending">
                        <i class="bi bi-arrow-repeat me-1"></i> Marcar visibles como Pendiente (mock)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal detalle -->
    <div class="modal fade" id="modalResena" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header sitm">
                    <div class="d-flex align-items-center gap-2">
                        <span class="rounded-3 d-inline-grid place-items-center"
                              style="width:38px;height:38px;background:rgba(255,255,255,.18);">
                            <i class="bi bi-clipboard-check"></i>
                        </span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Detalle de la Reseña</h5>
                            <small style="opacity:.9;">Revisión institucional / moderación</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="detailId" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="detail-block">
                                <div class="detail-label">Usuario</div>
                                <p class="detail-value" id="detailUsuario">—</p>
                                <div class="detail-label mt-2">Fecha</div>
                                <p class="detail-value" id="detailFecha">—</p>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="detail-block">
                                <div class="detail-label">Elemento evaluado</div>
                                <p class="detail-value" id="detailElemento">—</p>
                                <div class="detail-label mt-2">Tipo</div>
                                <p class="detail-value" id="detailTipo">—</p>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="detail-block">
                                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                                    <div>
                                        <div class="detail-label">Calificación</div>
                                        <div class="rating" id="detailRating" aria-label="Calificación">
                                            <!-- stars -->
                                        </div>
                                    </div>

                                    <div>
                                        <div class="detail-label">Estado</div>
                                        <span class="badge px-3 py-2 rounded-pill fw-semibold" id="detailEstadoBadge">—</span>
                                    </div>
                                </div>

                                <hr style="border-color: rgba(15,23,42,.08);">

                                <div class="detail-label">Comentario</div>
                                <p class="mb-0" id="detailComentario" style="color:#0f172a;">—</p>

                                <div class="mt-3 d-flex align-items-center gap-2 subtle">
                                    <i class="bi bi-shield-check"></i>
                                    <small>Validá lenguaje, ataques personales, spam y contenido sensible antes de publicar.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-success rounded-pill px-3" id="btnApproveFromModal">
                        <i class="bi bi-check2-circle me-1"></i> Aprobar
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-3" id="btnRejectFromModal">
                        <i class="bi bi-x-circle me-1"></i> Rechazar
                    </button>
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toasts (feedback inmediato) -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="sitmToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true"
             style="border-radius: 16px; box-shadow: 0 14px 30px rgba(15,23,42,.16);">
            <div class="d-flex">
                <div class="toast-body" id="toastBody">
                    Acción aplicada.
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // ===== Bootstrap tooltips =====
        (() => {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
        })();

        const table = document.getElementById('reviewsTable');
        const rows = () => Array.from(document.querySelectorAll('.review-row'));

        const searchBox = document.getElementById('searchBox');
        const filterEstado = document.getElementById('filterEstado');
        const filterTipo = document.getElementById('filterTipo');
        const shownCount = document.getElementById('shownCount');

        const kpiTotal = document.getElementById('kpiTotal');
        const kpiPend = document.getElementById('kpiPend');
        const kpiApro = document.getElementById('kpiApro');
        const kpiRech = document.getElementById('kpiRech');

        const modalEl = document.getElementById('modalResena');
        const modal = new bootstrap.Modal(modalEl);
        const toastEl = document.getElementById('sitmToast');
        const toast = new bootstrap.Toast(toastEl, { delay: 2200 });
        const toastBody = document.getElementById('toastBody');

        // Modal fields
        const detailId = document.getElementById('detailId');
        const detailUsuario = document.getElementById('detailUsuario');
        const detailFecha = document.getElementById('detailFecha');
        const detailElemento = document.getElementById('detailElemento');
        const detailTipo = document.getElementById('detailTipo');
        const detailRating = document.getElementById('detailRating');
        const detailComentario = document.getElementById('detailComentario');
        const detailEstadoBadge = document.getElementById('detailEstadoBadge');

        const btnApproveFromModal = document.getElementById('btnApproveFromModal');
        const btnRejectFromModal = document.getElementById('btnRejectFromModal');

        function showToast(message) {
            toastBody.textContent = message;
            toast.show();
        }

        function badgeClassFor(estado) {
            switch (estado) {
                case 'Pendiente': return 'badge-soft-warning';
                case 'Aprobada': return 'badge-soft-success';
                case 'Rechazada': return 'badge-soft-danger';
                case 'Oculta': return 'badge-soft-muted';
                default: return 'badge-soft-muted';
            }
        }

        function setRowEstado(tr, newEstado) {
            tr.dataset.estado = newEstado;

            const badge = tr.querySelector('td:nth-child(6) .badge');
            if (badge) {
                badge.className = `badge ${badgeClassFor(newEstado)} px-3 py-2 rounded-pill fw-semibold`;
                badge.textContent = newEstado;
            }

            // habilitar/deshabilitar botones según estado
            const btnAprobar = tr.querySelector('[data-action="aprobar"]');
            const btnRechazar = tr.querySelector('[data-action="rechazar"]');

            if (btnAprobar) btnAprobar.disabled = (newEstado === 'Aprobada');
            if (btnRechazar) btnRechazar.disabled = (newEstado === 'Rechazada');
        }

        function renderStars(container, rating) {
            const r = parseInt(rating || "0", 10);
            let html = '';
            for (let i = 1; i <= 5; i++) {
                html += (i <= r)
                    ? `<i class="bi bi-star-fill text-warning"></i>`
                    : `<i class="bi bi-star text-warning"></i>`;
            }
            html += `<span class="ms-2 subtle fw-semibold">${r}/5</span>`;
            container.innerHTML = html;
        }

        function applyFilters() {
            const q = (searchBox.value || '').trim().toLowerCase();
            const est = filterEstado.value;
            const tipo = filterTipo.value;

            let visible = 0;

            rows().forEach(tr => {
                const usuario = (tr.dataset.usuario || '').toLowerCase();
                const elemento = (tr.dataset.elemento || '').toLowerCase();
                const comentario = (tr.dataset.comentario || '').toLowerCase();
                const estado = tr.dataset.estado || '';
                const t = tr.dataset.tipo || '';

                const matchSearch = !q || usuario.includes(q) || elemento.includes(q) || comentario.includes(q);
                const matchEstado = !est || estado === est;
                const matchTipo = !tipo || t === tipo;

                const show = matchSearch && matchEstado && matchTipo;
                tr.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            shownCount.textContent = visible.toString();
        }

        function refreshKpis() {
            let total = 0, pend = 0, apro = 0, rech = 0;
            rows().forEach(tr => {
                total++;
                const est = tr.dataset.estado;
                if (est === 'Pendiente') pend++;
                else if (est === 'Aprobada') apro++;
                else if (est === 'Rechazada') rech++;
            });

            kpiTotal.textContent = total;
            kpiPend.textContent = pend;
            kpiApro.textContent = apro;
            kpiRech.textContent = rech;
        }

        function openDetailFromRow(tr) {
            detailId.value = tr.dataset.id || '';
            detailUsuario.textContent = tr.dataset.usuario || '—';
            detailFecha.textContent = tr.dataset.fecha || '—';
            detailElemento.textContent = tr.dataset.elemento || '—';
            detailTipo.textContent = tr.dataset.tipo || '—';
            detailComentario.textContent = tr.dataset.comentario || '—';

            const estado = tr.dataset.estado || '—';
            detailEstadoBadge.className = `badge ${badgeClassFor(estado)} px-3 py-2 rounded-pill fw-semibold`;
            detailEstadoBadge.textContent = estado;

            renderStars(detailRating, tr.dataset.rating || 0);

            // Modal action buttons: según estado
            btnApproveFromModal.disabled = (estado === 'Aprobada');
            btnRejectFromModal.disabled = (estado === 'Rechazada');

            modal.show();
        }

        function getRowById(id) {
            return rows().find(tr => tr.dataset.id === String(id));
        }

        // Eventos filtros
        searchBox.addEventListener('input', applyFilters);
        filterEstado.addEventListener('change', applyFilters);
        filterTipo.addEventListener('change', applyFilters);

        // Acciones de tabla
        table.addEventListener('click', (e) => {
            const btn = e.target.closest('button[data-action]');
            if (!btn) return;

            const tr = btn.closest('tr.review-row');
            if (!tr) return;

            const action = btn.dataset.action;

            if (action === 'ver') {
                openDetailFromRow(tr);
                return;
            }

            if (action === 'aprobar') {
                setRowEstado(tr, 'Aprobada');
                showToast(`Reseña #${tr.dataset.id} aprobada (mock).`);
            }

            if (action === 'rechazar') {
                setRowEstado(tr, 'Rechazada');
                showToast(`Reseña #${tr.dataset.id} rechazada (mock).`);
            }

            if (action === 'ocultar') {
                setRowEstado(tr, 'Oculta');
                showToast(`Reseña #${tr.dataset.id} marcada como Oculta (mock).`);
            }

            refreshKpis();
            applyFilters();
        });

        // Acciones desde modal
        btnApproveFromModal.addEventListener('click', () => {
            const tr = getRowById(detailId.value);
            if (!tr) return;
            setRowEstado(tr, 'Aprobada');
            showToast(`Reseña #${tr.dataset.id} aprobada (mock).`);
            refreshKpis();
            applyFilters();
            openDetailFromRow(tr); // refresca badge/btns
        });

        btnRejectFromModal.addEventListener('click', () => {
            const tr = getRowById(detailId.value);
            if (!tr) return;
            setRowEstado(tr, 'Rechazada');
            showToast(`Reseña #${tr.dataset.id} rechazada (mock).`);
            refreshKpis();
            applyFilters();
            openDetailFromRow(tr);
        });

        // Botones superiores
        document.getElementById('btnResetFilters').addEventListener('click', () => {
            searchBox.value = '';
            filterEstado.value = '';
            filterTipo.value = '';
            applyFilters();
            showToast('Filtros restablecidos.');
        });

        document.getElementById('btnExportMock').addEventListener('click', () => {
            // Mock (placeholder) — aquí luego llamás a tu endpoint real o generás CSV server-side.
            showToast('Exportar: acción mock lista para conectar a API/Controller.');
        });

        document.getElementById('btnMarkAllPending').addEventListener('click', () => {
            rows().forEach(tr => {
                if (tr.style.display !== 'none') setRowEstado(tr, 'Pendiente');
            });
            refreshKpis();
            applyFilters();
            showToast('Filas visibles marcadas como Pendiente (mock).');
        });

        // Init
        refreshKpis();
        applyFilters();
    </script>
}
