@model IEnumerable<turistico.Models.Comercio>

@{
    ViewBag.Title = "Validación de Comercios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="fw-bold text-success mb-2">Validación de Comercios</h2>
<p class="text-muted mb-4">
    Listado de comercios para aprobar o rechazar.
</p>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a href="@Url.Action("Create", "AdminComercios")" class="btn btn-success">
                    + Agregar comercio
                </a>
            </div>

            <div class="text-muted">
                Total: <strong>@(Model?.Count() ?? 0)</strong>
            </div>
        </div>

        <table class="table table-hover align-middle">
            <thead class="table-success">
                <tr>
                    <th style="width: 28%;">Comercio</th>
                    <th style="width: 14%;">Categoría</th>
                    <th style="width: 18%;">Dirección</th>
                    <th style="width: 10%;">Estado</th>
                    <th style="width: 10%;">Regulado</th>
                    <th class="text-center" style="width: 20%;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No hay comercios para mostrar.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var estado = item.Lugar != null ? item.Lugar.Estado : "Pendiente";
                        var esRegulado = item.ComercioRegulado != null;

                        <tr>
                            <td>
                                <div class="fw-semibold">@item.Nombre</div>
                                <div class="text-muted small">@item.Descripcion</div>
                            </td>

                            <td>
                                @(item.Lugar?.Categoria?.Nombre ?? "—")
                            </td>

                            <td>
                                @(item.Lugar?.Direccion ?? "—")
                            </td>

                            <td>
                                @if (estado == "Aprobado")
                                {
                                    <span class="badge bg-success">Aprobado</span>
                                }
                                else if (estado == "Rechazado")
                                {
                                    <span class="badge bg-danger">Rechazado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                            </td>

                            <td>
                                @if (esRegulado)
                                {
                                    <span class="badge bg-secondary">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">No</span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="d-flex justify-content-center flex-wrap gap-2">

                                    <a class="btn btn-outline-primary btn-sm"
                                       href="@Url.Action("Edit", "AdminComercios", new { id = item.Id })">
                                        Editar
                                    </a>

                                    @using (Html.BeginForm("Aprobar", "AdminComercios", new { id = item.Id }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                            Aprobar
                                        </button>
                                    }

                                    @using (Html.BeginForm("Rechazar", "AdminComercios", new { id = item.Id }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Rechazar
                                        </button>
                                    }

                                    @using (Html.BeginForm("Delete", "AdminComercios", new { id = item.Id }, FormMethod.Post, new { style = "display:inline", onsubmit = "return confirm('¿Eliminar este comercio?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Eliminar
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</div>