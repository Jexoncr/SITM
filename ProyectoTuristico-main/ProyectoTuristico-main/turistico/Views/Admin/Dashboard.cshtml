@model turistico.Models.AdminDashboardVM
@{
    ViewBag.Title = "Dashboard Administrativo";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .dash-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .dash-sub {
        color: #6c757d;
        margin-top: .25rem;
        font-size: .95rem;
    }

    .kpi-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,.06);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
        background: #fff;
    }

    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 35px rgba(0,0,0,.10);
    }

    .kpi-top {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .5rem;
    }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.25rem;
        background: rgba(56, 211, 159, 0.14);
        color: #0f3d2e;
        flex: 0 0 auto;
    }

    .kpi-label { color: #6c757d; font-size: .92rem; margin-bottom: .25rem; }
    .kpi-value { font-weight: 800; font-size: 1.7rem; margin: 0; line-height: 1.1; color: #0f3d2e; }

    .panel-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,.06);
        overflow: hidden;
        background: #fff;
    }

    .panel-head {
        padding: 16px 18px;
        border-bottom: 1px solid rgba(0,0,0,.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .panel-title {
        margin: 0;
        font-weight: 800;
        color: #0f3d2e;
        font-size: 1.05rem;
    }

    .panel-body { padding: 18px; }

    .quick-actions .btn {
        border-radius: 12px;
        padding: .65rem .9rem;
        font-weight: 700;
    }

    .mini-note { color: #6c757d; font-size: .9rem; }

    .status-pill {
        padding: .3rem .6rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: .8rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        white-space: nowrap;
    }

    .status-pill.aprobado { background: rgba(25,135,84,.12); color: #198754; }
    .status-pill.pendiente { background: rgba(255,193,7,.18); color: #946200; }
    .status-pill.rechazado { background: rgba(220,53,69,.12); color: #dc3545; }

    @@media (max-width: 991px) {
        .dash-title { flex-direction: column; align-items: flex-start; }
    }
</style>

<div class="dash-title">
    <div>
        <h2 class="fw-bold mb-0" style="color:#0f3d2e;">
            <i class="bi bi-speedometer2 me-2"></i> Panel de Administración
        </h2>
        <div class="dash-sub">Resumen rápido del sistema SITM: comercios, eventos, usuarios y actividad reciente.</div>
    </div>

    <div class="d-flex gap-2">
        <a href="/Admin/Eventos" class="btn btn-outline-success rounded-pill fw-semibold">
            <i class="bi bi-calendar-plus me-1"></i> Nuevo evento
        </a>
        <a href="/Admin/Comercios" class="btn btn-success rounded-pill fw-semibold">
            <i class="bi bi-shop-window me-1"></i> Revisar comercios
        </a>
    </div>
</div>

<!-- KPI CARDS (REALES DEL MODEL - como DEF) -->
<div class="row g-4 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card kpi-card">
            <div class="card-body p-4">
                <div class="kpi-top">
                    <div>
                        <div class="kpi-label">Comercios registrados</div>
                        <p class="kpi-value">@Model.ComerciosRegistrados</p>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-shop"></i></div>
                </div>
                <div class="mini-note">Total en el sistema</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card kpi-card">
            <div class="card-body p-4">
                <div class="kpi-top">
                    <div>
                        <div class="kpi-label">Comercios pendientes</div>
                        <p class="kpi-value text-warning mb-0">@Model.ComerciosPendientes</p>
                    </div>
                    <div class="kpi-icon" style="background: rgba(255,193,7,.18); color:#946200;">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <div class="mini-note">Requieren revisión</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card kpi-card">
            <div class="card-body p-4">
                <div class="kpi-top">
                    <div>
                        <div class="kpi-label">Comercios aprobados</div>
                        <p class="kpi-value text-success mb-0">@Model.ComerciosAprobados</p>
                    </div>
                    <div class="kpi-icon" style="background: rgba(25,135,84,.12); color:#198754;">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div class="mini-note">En producción</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card kpi-card">
            <div class="card-body p-4">
                <div class="kpi-top">
                    <div>
                        <div class="kpi-label">Usuarios registrados</div>
                        <p class="kpi-value text-dark mb-0">@Model.UsuariosRegistrados</p>
                    </div>
                    <div class="kpi-icon" style="background: rgba(33,37,41,.08); color:#212529;">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <div class="mini-note">Total de usuarios</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- ESTADO DE COMERCIOS (SIN CHART.JS, SOLO RESUMEN REAL) -->
    <div class="col-12 col-xl-4">
        <div class="panel-card">
            <div class="panel-head">
                <h5 class="panel-title"><i class="bi bi-pie-chart me-2"></i>Estado de comercios</h5>
                <a href="/Admin/Comercios" class="btn btn-sm btn-success rounded-pill">
                    Ver lista <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="panel-body">
                <div class="d-flex justify-content-between mini-note mb-2">
                    <span><i class="bi bi-check-circle text-success me-1"></i> Aprobados</span>
                    <strong>@Model.ComerciosAprobados</strong>
                </div>
                <div class="d-flex justify-content-between mini-note mb-2">
                    <span><i class="bi bi-hourglass text-warning me-1"></i> Pendientes</span>
                    <strong>@Model.ComerciosPendientes</strong>
                </div>
                <div class="d-flex justify-content-between mini-note">
                    <span><i class="bi bi-x-circle text-danger me-1"></i> Rechazados</span>
                    <strong>@Model.ComerciosRechazados</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- ACCIONES RÁPIDAS -->
    <div class="col-12 col-xl-4">
        <div class="panel-card">
            <div class="panel-head">
                <h5 class="panel-title"><i class="bi bi-lightning-charge me-2"></i>Acciones rápidas</h5>
            </div>
            <div class="panel-body quick-actions">
                <div class="d-grid gap-2">
                    <a class="btn btn-success" href="/Admin/Comercios">
                        <i class="bi bi-clipboard-check me-2"></i> Aprobar / Rechazar comercios
                    </a>
                    <a class="btn btn-outline-success" href="/Admin/Eventos">
                        <i class="bi bi-calendar-week me-2"></i> Administrar eventos
                    </a>
                    <a class="btn btn-outline-secondary" href="/Admin/Resenas">
                        <i class="bi bi-star me-2"></i> Moderar reseñas
                    </a>
                </div>

                <hr class="my-3">

                <div class="mini-note">
                    Tip: revisa primero los comercios <strong>pendientes</strong> para mantener el sistema al día.
                </div>
            </div>
        </div>
    </div>

    <!-- ACTIVIDAD RECIENTE (DEMO VISUAL, NO ROMPE NADA) -->
    <div class="col-12 col-xl-8">
        <div class="panel-card">
            <div class="panel-head">
                <h5 class="panel-title"><i class="bi bi-clock-history me-2"></i>Actividad reciente</h5>
                <span class="mini-note">Demo</span>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Detalle</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Hoy</td>
                                <td><i class="bi bi-shop me-1"></i> Comercio</td>
                                <td>Nuevo comercio enviado a revisión</td>
                                <td><span class="status-pill pendiente"><i class="bi bi-hourglass"></i> Pendiente</span></td>
                            </tr>
                            <tr>
                                <td>Ayer</td>
                                <td><i class="bi bi-calendar-event me-1"></i> Evento</td>
                                <td>Evento publicado</td>
                                <td><span class="status-pill aprobado"><i class="bi bi-check2-circle"></i> Activo</span></td>
                            </tr>
                            <tr>
                                <td>Hace 2 días</td>
                                <td><i class="bi bi-star me-1"></i> Reseña</td>
                                <td>Reseña reportada</td>
                                <td><span class="status-pill rechazado"><i class="bi bi-flag"></i> Revisar</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="mini-note mt-3">
                    Luego lo conectamos a auditoría si existe tabla/log.
                </div>
            </div>
        </div>
    </div>

</div>