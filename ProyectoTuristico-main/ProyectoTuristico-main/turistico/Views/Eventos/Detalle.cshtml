@model turistico.Controllers.EventoDetalleVM

@{
    ViewBag.Title = "Detalle del Evento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    @Html.Partial("_Alerts")

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <span class="badge bg-success-subtle text-success-emphasis rounded-pill mb-3">
                @Model.Categoria
            </span>

            <h2 class="fw-bold mb-3">@Model.Nombre</h2>
            <p class="mb-4">@Model.Descripcion</p>

            <div class="row g-3">
                <div class="col-md-7">
                    <div class="border rounded-4 p-3 h-100">
                        <h5 class="fw-bold">Información</h5>
                        <p class="mb-2"><strong>Comercio:</strong> @(string.IsNullOrWhiteSpace(Model.ComercioNombre) ? "-" : Model.ComercioNombre)</p>
                        <p class="mb-2"><strong>Lugar:</strong> @(string.IsNullOrWhiteSpace(Model.LugarNombre) ? "-" : Model.LugarNombre)</p>
                        <p class="mb-2"><strong>Dirección:</strong> @(string.IsNullOrWhiteSpace(Model.Direccion) ? "-" : Model.Direccion)</p>
                        <p class="mb-2"><strong>Fecha inicio:</strong> @(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
                        <p class="mb-2"><strong>Fecha fin:</strong> @(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
                        <p class="mb-0"><strong>Cupos disponibles:</strong> @Model.CuposDisponibles</p>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="border rounded-4 p-3 h-100">
                        <h5 class="fw-bold">Reservar evento</h5>

                        @if (User.Identity.IsAuthenticated)
                        {
                            using (Html.BeginForm("Reservar", "Eventos", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="EventoId" value="@Model.Id" />

                                <div class="mb-3">
                                    <label class="form-label">Cantidad de personas</label>
                                    <input type="number" name="NumeroPersonas" min="1" max="1000" value="1" class="form-control" required />
                                </div>

                                <button type="submit" class="btn btn-success rounded-pill w-100" @(Model.CuposDisponibles <= 0 ? "disabled" : "")>
                                    <i class="bi bi-calendar-check me-1"></i> Reservar
                                </button>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Inicia sesión para reservar este evento.</p>
                            <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Detalle", "Eventos", new { id = Model.Id }) })"
                               class="btn btn-success rounded-pill w-100">
                                Iniciar sesión
                            </a>
                        }

                        <hr />
                        <p class="mb-1"><strong>Teléfono:</strong> @(string.IsNullOrWhiteSpace(Model.Telefono) ? "-" : Model.Telefono)</p>
                        <p class="mb-1"><strong>WhatsApp:</strong> @(string.IsNullOrWhiteSpace(Model.WhatsApp) ? "-" : Model.WhatsApp)</p>
                        <p class="mb-0"><strong>Sitio web:</strong> @(string.IsNullOrWhiteSpace(Model.SitioWeb) ? "-" : Model.SitioWeb)</p>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("Index", "Eventos")" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>
            </div>
        </div>
    </div>
</div>