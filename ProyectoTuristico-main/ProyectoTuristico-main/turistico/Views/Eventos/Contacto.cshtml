@model turistico.Models.Evento
@{
    ViewBag.Title = "Contacto del Evento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-3">Contacto del Evento</h2>
            <p class="text-muted mb-4">Información de contacto relacionada con el evento seleccionado.</p>

            <div class="border rounded-4 p-3">
                <p class="mb-2"><strong>Evento:</strong> @Model.Nombre</p>
                <p class="mb-2"><strong>Comercio:</strong> @(Model.Comercio?.Nombre ?? "-")</p>
                <p class="mb-2"><strong>Teléfono:</strong> @(Model.Comercio?.Telefono ?? Model.Lugar?.Telefono ?? "-")</p>
                <p class="mb-2"><strong>WhatsApp:</strong> @(Model.Comercio?.LinkWhatsApp ?? "-")</p>
                <p class="mb-0"><strong>Sitio web:</strong> @(Model.Lugar?.SitioWeb ?? "-")</p>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("Detalle", "Eventos", new { id = Model.Id })" class="btn btn-success rounded-pill px-4">Volver al detalle</a>
            </div>
        </div>
    </div>
</div>