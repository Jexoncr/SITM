@model IEnumerable<turistico.Models.ComercioDTO>

@{
    ViewBag.Title = "Comercios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="fw-bold text-success mb-5">Comercios y Servicios Registrados</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3">
            @foreach (var comercio in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        @* Se usa Url.Content para que ASP.NET resuelva la ruta correctamente *@
                        <img src="@Url.Content("~" + comercio.ImagenUrl)"
                             class="card-img-top"
                             style="height:200px; object-fit:cover;"
                             alt="@comercio.Nombre"
                             onerror="this.onerror=null; this.src='@Url.Content("~/Content/img/default.jpg")';">

                        <div class="card-body d-flex flex-column">
                            <h4 class="fw-bold text-success">@comercio.Nombre</h4>
                            <p class="text-muted small">@comercio.Descripcion</p>

                            <ul class="list-unstyled mt-auto mb-4 small">
                                <li><strong>Categoría:</strong> @comercio.Categoria</li>
                             
                                        <p>&copy; Arobado por la municipalidad</p>
                                <li>📍 @comercio.Ubicacion</li>

                                @if (!string.IsNullOrEmpty(comercio.Telefono))
                                {
                                    <li>📞 @comercio.Telefono</li>
                                }
                            </ul>

                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Perfil", "Comercios", new { id = comercio.Id })"
                                   class="btn btn-outline-success btn-sm w-100">Ver perfil</a>
                                <a href="@Url.Action("Contacto", "Comercios", new { id = comercio.Id })"
                                   class="btn btn-success btn-sm w-100">Contactar</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>