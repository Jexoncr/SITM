@model turistico.Models.ComercioDTO

@{
    ViewBag.Title = "Detalles de " + Model.Nombre;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="mb-4">
        <a href="@Url.Action("Index", "Comercios")" class="text-success text-decoration-none fw-bold">
            <i class="fa-solid fa-arrow-left"></i> Volver al listado
        </a>
    </div>

    <div class="row g-5">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 overflow-hidden" style="border-radius: 20px;">
                <img src="@Url.Content(Model.ImagenUrl)"
                     class="img-fluid"
                     alt="@Model.Nombre"
                     style="width: 100%; height: 450px; object-fit: cover;"
                     onerror="this.src='@Url.Content("~/Content/img/comercios/default.jpg")'">
            </div>
        </div>

        <div class="col-lg-6">
            <div class="ps-lg-4">
                <span class="badge bg-success mb-2 px-3 py-2 fs-6">@Model.Categoria</span>
                <h1 class="fw-bold text-dark display-5 mb-3">@Model.Nombre</h1>

                <p class="text-muted fs-5 mb-4">
                    @Model.Descripcion
                </p>

                <hr class="my-4">

                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-light text-success p-3 rounded-circle me-3">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Ubicación</h6>
                            <p class="mb-0 text-muted">@Model.Ubicacion</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Telefono))
                    {
                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-light text-success p-3 rounded-circle me-3">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Teléfono</h6>
                                <p class="mb-0 text-muted">@Model.Telefono</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Horario))
                    {
                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-light text-success p-3 rounded-circle me-3">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Horario de atención</h6>
                                <p class="mb-0 text-muted">@Model.Horario</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-5 d-grid gap-2 d-md-flex">
                    <a href="@Url.Action("Contacto", "Comercios", new { id = Model.Id })" class="btn btn-success btn-lg px-5 py-3 fw-bold rounded-pill">
                        Contactar ahora
                    </a>
                    @if (!string.IsNullOrEmpty(Model.SitioWeb))
                    {
                        <a href="@(Model.SitioWeb.StartsWith("http") ? Model.SitioWeb : "http://" + Model.SitioWeb)"
                           target="_blank"
                           class="btn btn-outline-dark btn-lg px-5 py-3 fw-bold rounded-pill">
                            Visitar sitio web
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>