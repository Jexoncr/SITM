@using System
@using System.Collections.Generic
@using System.Linq

@{
    Layout = ViewBag.Layout ?? Layout;

    // =========================
    // Catálogo de Comercios (ViewBag o mock)
    // Espera: Id, Nombre, Tipo, Ubicacion
    // =========================
    IEnumerable<dynamic> comerciosBag = ViewBag.Comercios as IEnumerable<dynamic>;

    var comerciosMock = new List<dynamic>
{
        new { Id=1, Nombre="Hotel Central", Tipo="Hotel", Ubicacion="Centro" },
        new { Id=2, Nombre="Restaurante La Plaza", Tipo="Restaurante", Ubicacion="Barrio Norte" },
        new { Id=3, Nombre="Café Mirador", Tipo="Cafetería", Ubicacion="Mirador Municipal" },
        new { Id=4, Nombre="Soda El Parque", Tipo="Soda", Ubicacion="Parque Central" },
        new { Id=5, Nombre="Tour Río Verde", Tipo="Operador Turístico", Ubicacion="Zona Rural" },
    };

    var comercios = (comerciosBag != null) ? comerciosBag.ToList() : comerciosMock;

    // Tipos únicos
    var tipos = comercios.Select(c => (string)c.Tipo).Distinct().OrderBy(x => x).ToList();

    // =========================
    // Usuario actual (ajústalo a tu auth real)
    // =========================
    string currentUserKey = (string)(ViewBag.CurrentUserKey ?? "yo");

    // =========================
    // Reseñas (ViewBag o mock)
    // Espera: Id, ComercioId, ComercioNombre, Tipo, Ubicacion, UserKey, Usuario, Fecha, Rating, Comentario, Estado
    // Estado: "Publicada" | "Pendiente" | "Moderada"
    // =========================
    IEnumerable<dynamic> resenasBag = ViewBag.Resenas as IEnumerable<dynamic>;

    var resenasMock = new List<dynamic>
{
        new { Id=201, ComercioId=2, ComercioNombre="Restaurante La Plaza", Tipo="Restaurante", Ubicacion="Barrio Norte", UserKey="u2", Usuario="María G.", Fecha=DateTime.Now.AddDays(-2), Rating=5, Comentario="Excelente atención y limpieza. Volvería sin dudar.", Estado="Publicada" },
        new { Id=202, ComercioId=3, ComercioNombre="Café Mirador", Tipo="Cafetería", Ubicacion="Mirador Municipal", UserKey="u3", Usuario="Carlos R.", Fecha=DateTime.Now.AddDays(-4), Rating=4, Comentario="Buen café, linda vista. Un poco lleno en la tarde.", Estado="Publicada" },
        new { Id=203, ComercioId=2, ComercioNombre="Restaurante La Plaza", Tipo="Restaurante", Ubicacion="Barrio Norte", UserKey="yo", Usuario="Tú", Fecha=DateTime.Now.AddDays(-6), Rating=4, Comentario="Lugar muy ordenado. Personal amable. Podría mejorar el parqueo.", Estado="Pendiente" },
        new { Id=204, ComercioId=1, ComercioNombre="Hotel Central", Tipo="Hotel", Ubicacion="Centro", UserKey="u4", Usuario="Ana P.", Fecha=DateTime.Now.AddDays(-9), Rating=2, Comentario="No coincidió con la información del horario publicada.", Estado="Moderada" },
        new { Id=205, ComercioId=4, ComercioNombre="Soda El Parque", Tipo="Soda", Ubicacion="Parque Central", UserKey="u5", Usuario="Luis M.", Fecha=DateTime.Now.AddDays(-12), Rating=3, Comentario="Comida rica, porciones normales. Servicio un poco lento.", Estado="Publicada" },
    };

    var resenas = (resenasBag != null) ? resenasBag.ToList() : resenasMock;

    // =========================
    // Selección inicial (si viene por querystring o ViewBag)
    // =========================
    int selectedComercioId = 0;
    try { selectedComercioId = (int)(ViewBag.SelectedComercioId ?? 0); } catch { selectedComercioId = 0; }

    // Helpers
    Func<DateTime, string> fmtFecha = d => d.ToString("dd MMM yyyy");
}

<style>
    :root{
        --sitm-green:#0f3d2e;
        --sitm-ink:#0f172a;
        --sitm-muted:#64748b;
        --sitm-border:#e7ebf0;
        --sitm-card:#ffffff;
        --sitm-soft:#eef6f1;
        --sitm-gray:#f2f4f7;
        --sitm-warn:#8a6a00;
        --sitm-warn-bg:#fff7da;
        --sitm-danger:#8b1c1c;
        --sitm-danger-bg:#fdecec;
        --radius:16px;
    }

    .sitm-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;padding:.25rem 0 1rem;}
    .sitm-title{margin:0;font-weight:900;color:var(--sitm-ink);}
    .sitm-sub{color:var(--sitm-muted);margin:.15rem 0 0;font-size:.95rem;}
    .sitm-pill{display:inline-flex;align-items:center;gap:.45rem;padding:.35rem .6rem;border-radius:999px;background:var(--sitm-soft);color:var(--sitm-green);border:1px solid rgba(15,61,46,.12);font-weight:800;font-size:.85rem;white-space:nowrap;}

    .sitm-card{background:var(--sitm-card);border:1px solid var(--sitm-border);border-radius:var(--radius);box-shadow:0 10px 26px rgba(15,23,42,.06);}
    .sitm-card .card-header{background:transparent;border-bottom:1px solid var(--sitm-border);border-top-left-radius:var(--radius);border-top-right-radius:var(--radius);}

    .filters{padding:1rem;}
    .form-label{font-weight:900;color:var(--sitm-ink);}

    .sitm-main{display:grid;grid-template-columns:1.65fr .95fr;gap:1rem;margin-top:1rem;align-items:start;}
    @@media (max-width: 991.98px){ .sitm-main{grid-template-columns:1fr;} .sitm-sticky{position:static !important;top:auto !important;} }

    .sitm-sticky{position:sticky;top:92px;}

    /* Feed */
    .feed-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;}
    .feed-meta{color:var(--sitm-muted);font-size:.88rem;}

    .review{padding:1rem 1.05rem;border-bottom:1px solid var(--sitm-border);transition:background .12s ease;}
    .review:hover{background:rgba(246,248,251,.65);}
    .review:last-child{border-bottom:none;border-bottom-left-radius:var(--radius);border-bottom-right-radius:var(--radius);}

    .review-top{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;}
    .comercio-name{font-weight:950;color:var(--sitm-ink);margin:0;line-height:1.2;}
    .comercio-sub{color:var(--sitm-muted);font-size:.9rem;margin:.15rem 0 0;display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;}

    .badge-soft{border-radius:999px;padding:.32rem .55rem;font-weight:900;font-size:.76rem;border:1px solid transparent;display:inline-flex;align-items:center;gap:.35rem;white-space:nowrap;}
    .b-type{background:rgba(15,61,46,.06);color:var(--sitm-green);border-color:rgba(15,61,46,.12);}
    .b-loc{background:var(--sitm-gray);color:#334155;border-color:rgba(2,6,23,.06);}
    .b-pub{background:var(--sitm-soft);color:var(--sitm-green);border-color:rgba(15,61,46,.12);}
    .b-pen{background:var(--sitm-warn-bg);color:var(--sitm-warn);border-color:rgba(138,106,0,.18);}
    .b-mod{background:var(--sitm-danger-bg);color:var(--sitm-danger);border-color:rgba(139,28,28,.18);}

    .who{display:flex;align-items:center;gap:.65rem;margin-top:.65rem;}
    .avatar{width:34px;height:34px;border-radius:999px;background:rgba(15,61,46,.08);border:1px solid rgba(15,61,46,.12);display:grid;place-items:center;color:var(--sitm-green);font-weight:950;flex:0 0 auto;}
    .who-name{font-weight:900;color:var(--sitm-ink);line-height:1.1;}
    .who-date{color:var(--sitm-muted);font-size:.85rem;}

    .stars{display:inline-flex;align-items:center;gap:.1rem;line-height:1;}
    .stars i{font-size:1.02rem;color:rgba(15,61,46,.18);}
    .stars i.on{color:var(--sitm-green);}

    .review-body{margin-top:.65rem;color:#334155;}
    .my-tag{display:inline-flex;align-items:center;gap:.35rem;color:var(--sitm-green);font-weight:900;font-size:.85rem;}

    .btn-sitm{border-radius:12px;font-weight:900;padding:.5rem .75rem;}
    .btn-outline-sitm{border:1px solid rgba(15,61,46,.25);color:var(--sitm-green);background:#fff;}
    .btn-outline-sitm:hover{background:rgba(15,61,46,.06);border-color:rgba(15,61,46,.35);color:var(--sitm-green);}
    .btn-danger-soft{border:1px solid rgba(139,28,28,.22);color:var(--sitm-danger);background:#fff;}
    .btn-danger-soft:hover{background:rgba(139,28,28,.06);border-color:rgba(139,28,28,.32);color:var(--sitm-danger);}

    /* Form */
    .hint{color:var(--sitm-muted);font-size:.88rem;}
    .star-picker{display:flex;align-items:center;gap:.25rem;padding:.35rem .55rem;border:1px solid var(--sitm-border);border-radius:12px;background:#fff;}
    .star-btn{width:34px;height:34px;border-radius:10px;border:1px solid transparent;background:transparent;display:grid;place-items:center;cursor:pointer;transition:background .12s ease,transform .12s ease;}
    .star-btn:hover{background:rgba(15,61,46,.06);transform:translateY(-1px);}
    .star-btn i{font-size:1.05rem;color:rgba(15,61,46,.22);}
    .star-btn.on i{color:var(--sitm-green);}
    .star-btn:focus{outline:none;box-shadow:0 0 0 .2rem rgba(15,61,46,.12);}

    .empty{padding:1.2rem;text-align:center;color:var(--sitm-muted);}
    .empty i{font-size:1.5rem;color:rgba(15,61,46,.35);}
</style>

<div class="container-xxl py-3 py-lg-4">

    <!-- Header -->
    <div class="sitm-header">
        <div>
            <h2 class="sitm-title">Reseñas</h2>
            <p class="sitm-sub mb-0">
                Portal municipal para <span class="fw-semibold text-dark">Comercios</span> · Consulta y comparte experiencias
            </p>
            <div class="mt-2 d-flex flex-wrap gap-2">
                <span class="sitm-pill"><i class="bi bi-shield-check"></i> Confiable · Moderación institucional</span>
                <span class="sitm-pill"><i class="bi bi-funnel"></i> Filtros y selección de comercio</span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-light btn-sitm">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="sitm-card">
        <div class="card-header px-3 py-3 d-flex align-items-center justify-content-between">
            <div class="fw-bold text-dark"><i class="bi bi-sliders"></i> Filtros</div>
            <div class="feed-meta"><i class="bi bi-info-circle"></i> Puedes filtrar y luego seleccionar un comercio para opinar</div>
        </div>

        <div class="filters">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label class="form-label">Buscar</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input id="searchInput" type="text" class="form-control" placeholder="Comercio, usuario o comentario..." />
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label">Tipo de comercio</label>
                    <select id="tipoSelect" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var t in tipos)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label">Comercio</label>
                    <select id="comercioSelect" class="form-select">
                        <option value="0">Todos (ver feed completo)</option>
                        @foreach (var c in comercios.OrderBy(x => (string)x.Nombre))
                        {
                            <option value="@c.Id" @(c.Id == selectedComercioId ? "selected" : "")>
                                @c.Nombre
                            </option>
                        }
                    </select>
                    
                </div>

                <div class="col-12 col-lg-2">
                    <label class="form-label">Ordenar</label>
                    <select id="sortSelect" class="form-select">
                        <option value="recent">Más recientes</option>
                        <option value="best">Mejor puntuadas</option>
                        <option value="worst">Peor puntuadas</option>
                    </select>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" id="clearBtn" class="btn btn-light btn-sitm">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="sitm-main">

        <!-- Feed -->
        <div class="sitm-card p-0">
            <div class="card-header px-3 py-3">
                <div class="feed-head">
                    <div class="fw-bold text-dark"><i class="bi bi-chat-quote"></i> Reseñas de Comercios</div>
                    <div class="feed-meta">
                        <span id="resultsCount">0</span> resultado(s)
                    </div>
                </div>
            </div>

            <div id="feed">
                @{
                    // Render server-side con data-attributes para filtrar en JS
                    // Nota: el orden final lo hace JS según sortSelect
                    foreach (var r in resenas)
                    {
                        int id = (int)r.Id;
                        int comercioId = (int)r.ComercioId;
                        string comercioNombre = (string)r.ComercioNombre;
                        string tipo = (string)r.Tipo;
                        string ubic = (string)r.Ubicacion;
                        string userKey = (string)r.UserKey;
                        string usuario = (string)r.Usuario;
                        DateTime fecha = (DateTime)r.Fecha;
                        int rating = (int)r.Rating;
                        string comentario = (string)r.Comentario;
                        string estado = (string)r.Estado;

                        bool isMine = string.Equals(userKey, currentUserKey, StringComparison.OrdinalIgnoreCase);

                        string badgeClass = "b-pub";
                        string badgeIcon = "bi-check2-circle";
                        string badgeLabel = "Publicada";

                        if (estado == "Pendiente")
                        {
                            badgeClass = "b-pen";
                            badgeIcon = "bi-hourglass-split";
                            badgeLabel = "En revisión";
                        }
                        else if (estado == "Moderada")
                        {
                            badgeClass = "b-mod";
                            badgeIcon = "bi-shield-exclamation";
                            badgeLabel = "Moderada";
                        }

                        string initial = "U";
                        if (!string.IsNullOrWhiteSpace(usuario)) { initial = usuario.Substring(0, 1).ToUpper(); }

                        <div class="review"
                             data-id="@id"
                             data-comercioid="@comercioId"
                             data-comercio="@comercioNombre"
                             data-tipo="@tipo"
                             data-ubicacion="@ubic"
                             data-user="@usuario"
                             data-rating="@rating"
                             data-fecha="@fecha.Ticks"
                             data-comment="@comentario"
                             data-estado="@estado"
                             data-ismine="@(isMine ? "1" : "0")">

                            <div class="review-top">
                                <div>
                                    <h5 class="comercio-name">@comercioNombre</h5>
                                    <div class="comercio-sub">
                                        <span class="badge-soft b-type"><i class="bi bi-tag"></i> @tipo</span>
                                        <span class="badge-soft b-loc"><i class="bi bi-geo-alt"></i> @ubic</span>
                                        <span class="badge-soft @badgeClass"><i class="bi @badgeIcon"></i> @badgeLabel</span>

                                        @if (isMine)
                                        {
                                            <span class="my-tag"><i class="bi bi-person-check"></i> Tu reseña</span>
                                        }
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div class="stars" aria-label="@rating de 5">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <i class="bi bi-star-fill @(s <= rating ? "on" : "")"></i>
                                        }
                                    </div>
                                    <div class="who-date mt-1">@fmtFecha(fecha)</div>
                                </div>
                            </div>

                            <div class="who">
                                <div class="avatar">@initial</div>
                                <div>
                                    <div class="who-name">@usuario</div>
                                    <div class="who-date">Opinión ciudadana</div>
                                </div>
                            </div>

                            <div class="review-body">@comentario</div>

                            @if (isMine)
                            {
                                <div class="mt-3 d-flex justify-content-end gap-2 flex-wrap">
                                    <button type="button"
                                            class="btn btn-outline-sitm btn-sitm"
                                            data-edit="1"
                                            data-reviewid="@id">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger-soft btn-sitm"
                                            data-delete="1"
                                            data-reviewid="@id">
                                        <i class="bi bi-trash3"></i> Eliminar
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <div id="emptyState" class="empty d-none">
                <i class="bi bi-chat-square-text"></i>
                <div class="mt-2 fw-bold text-dark">No hay reseñas con esos filtros</div>
                <div class="mt-1">Prueba cambiando el tipo, el comercio o el texto de búsqueda.</div>
            </div>
        </div>

        <!-- Form -->
        <div class="sitm-card sitm-sticky">
            <div class="card-header px-3 py-3">
                <div class="fw-bold text-dark"><i class="bi bi-pencil"></i> Tu reseña</div>
                <div class="text-muted small" id="formSubtitle">Selecciona un comercio para opinar</div>
            </div>

            <div class="p-3">
                <form method="post" id="reviewForm" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="Command" id="Command" value="upsert" />
                    <input type="hidden" name="ReviewId" id="ReviewId" value="" />

                    <div class="mb-3">
                        <label class="form-label">Comercio</label>
                        <select class="form-select" id="formComercioSelect" name="ComercioId">
                            <option value="0">Seleccione un comercio...</option>
                            @foreach (var c in comercios.OrderBy(x => (string)x.Nombre))
                            {
                                <option value="@c.Id" @(c.Id == selectedComercioId ? "selected" : "")>
                                    @c.Nombre
                                </option>
                            }
                        </select>
                        <div class="hint mt-1">El comercio elegido define a quién va dirigida tu reseña.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Calificación</label>
                        <div class="star-picker" role="group" aria-label="Seleccionar calificación">
                            <input type="hidden" name="Rating" id="Rating" value="0" />

                            @for (int i = 1; i <= 5; i++)
                            {
                                <button type="button" class="star-btn" data-star="@i" aria-label="@i estrellas">
                                    <i class="bi bi-star-fill"></i>
                                </button>
                            }

                            <span class="ms-2 small text-muted" id="ratingText">Selecciona de 1 a 5</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Comentario" class="form-label">Comentario</label>
                        <textarea id="Comentario" name="Comentario" class="form-control"
                                  rows="4" placeholder="Describe tu experiencia (máx. 500 caracteres)"
                                  maxlength="500"></textarea>

                        <div class="d-flex justify-content-between mt-1">
                            <span class="hint">Evita datos personales y lenguaje ofensivo.</span>
                            <span class="hint" id="count">0/500</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit"
                                class="btn btn-sitm"
                                style="background:var(--sitm-green);border-color:var(--sitm-green);color:#fff;">
                            <i class="bi bi-send"></i> <span id="submitText">Publicar reseña</span>
                        </button>

                        <button type="button" class="btn btn-light btn-sitm d-none" id="cancelEdit">
                            <i class="bi bi-x-circle"></i> Cancelar edición
                        </button>
                    </div>
                </form>

                <hr class="my-3" />
                <div class="hint"><i class="bi bi-info-circle"></i> Algunas reseñas pueden pasar a <b>revisión</b> antes de publicarse.</div>
            </div>
        </div>
    </div>

    <!-- Delete form -->
    <form method="post" id="deleteForm" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Command" value="delete" />
        <input type="hidden" name="ReviewId" id="DeleteReviewId" value="" />
    </form>
</div>

<script>
    (function () {
        "use strict";

        // ---------- DOM ----------
        const feed = document.getElementById("feed");
        const items = Array.from(feed.querySelectorAll(".review"));
        const emptyState = document.getElementById("emptyState");
        const resultsCount = document.getElementById("resultsCount");

        const searchInput = document.getElementById("searchInput");
        const tipoSelect = document.getElementById("tipoSelect");
        const comercioSelect = document.getElementById("comercioSelect");
        const sortSelect = document.getElementById("sortSelect");
        const clearBtn = document.getElementById("clearBtn");

        // Form
        const formComercioSelect = document.getElementById("formComercioSelect");
        const formSubtitle = document.getElementById("formSubtitle");
        const reviewIdInput = document.getElementById("ReviewId");
        const submitText = document.getElementById("submitText");
        const cancelBtn = document.getElementById("cancelEdit");

        // Stars
        const ratingInput = document.getElementById("Rating");
        const ratingText = document.getElementById("ratingText");
        const starButtons = Array.from(document.querySelectorAll(".star-btn"));

        // Text counter
        const txt = document.getElementById("Comentario");
        const counter = document.getElementById("count");

        function normalize(s) {
            return (s || "").toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        }

        function setStars(val) {
            const v = parseInt(val || "0", 10);
            ratingInput.value = String(v);

            starButtons.forEach(btn => {
                const s = parseInt(btn.dataset.star, 10);
                if (s <= v) { btn.classList.add("on"); }
                else { btn.classList.remove("on"); }
            });

            ratingText.textContent = v > 0 ? (v + " / 5") : "Selecciona de 1 a 5";
        }

        starButtons.forEach(btn => btn.addEventListener("click", () => setStars(btn.dataset.star)));

        function updateCount() {
            counter.textContent = (txt.value || "").length + "/500";
        }
        txt.addEventListener("input", updateCount);
        updateCount();

        // ---------- Filtering & Sorting ----------
        function applyFilters() {
            const q = normalize(searchInput.value);
            const tipo = tipoSelect.value;
            const comercioId = parseInt(comercioSelect.value || "0", 10);
            const sort = sortSelect.value;

            // Filter
            let visible = items.filter(el => {
                const elTipo = el.dataset.tipo || "";
                const elComercioId = parseInt(el.dataset.comercioid || "0", 10);

                if (tipo && elTipo !== tipo) return false;
                if (comercioId > 0 && elComercioId !== comercioId) return false;

                if (q) {
                    const hay = normalize(el.dataset.comercio) + " " +
                        normalize(el.dataset.user) + " " +
                        normalize(el.dataset.comment);
                    if (!hay.includes(q)) return false;
                }
                return true;
            });

            // Sort
            visible.sort((a, b) => {
                const ra = parseInt(a.dataset.rating || "0", 10);
                const rb = parseInt(b.dataset.rating || "0", 10);
                const fa = parseInt(a.dataset.fecha || "0", 10);
                const fb = parseInt(b.dataset.fecha || "0", 10);

                if (sort === "best") return rb - ra || fb - fa;
                if (sort === "worst") return ra - rb || fb - fa;
                return fb - fa; // recent
            });

            // Re-render order: hide all then append visible in order
            items.forEach(el => el.classList.add("d-none"));
            visible.forEach(el => {
                el.classList.remove("d-none");
                feed.appendChild(el);
            });

            resultsCount.textContent = String(visible.length);
            if (visible.length === 0) emptyState.classList.remove("d-none");
            else emptyState.classList.add("d-none");
        }

        searchInput.addEventListener("input", applyFilters);
        tipoSelect.addEventListener("change", () => {
            // Opcional: si cambian tipo, podrías filtrar comercios del selector principal,
            // pero lo dejamos simple y robusto.
            applyFilters();
        });
        comercioSelect.addEventListener("change", () => {
            // Sincroniza el comercio seleccionado también en el formulario
            const id = parseInt(comercioSelect.value || "0", 10);
            if (id > 0) formComercioSelect.value = String(id);
            onFormComercioChange();
            applyFilters();
        });
        sortSelect.addEventListener("change", applyFilters);

        clearBtn.addEventListener("click", () => {
            searchInput.value = "";
            tipoSelect.value = "";
            comercioSelect.value = "0";
            sortSelect.value = "recent";
            applyFilters();
        });

        // ---------- Form commerce selection + detect my existing review ----------
        function findMyReviewForComercio(comercioId) {
            return items.find(el => (parseInt(el.dataset.comercioid || "0", 10) === comercioId) && (el.dataset.ismine === "1"));
        }

        function enterEditFromElement(el) {
            const id = el.dataset.id;
            const rating = parseInt(el.dataset.rating || "0", 10);
            const comment = el.dataset.comment || "";
            const comercioId = parseInt(el.dataset.comercioid || "0", 10);

            reviewIdInput.value = String(id || "");
            formComercioSelect.value = String(comercioId);
            setStars(rating);
            txt.value = comment;
            updateCount();

            submitText.textContent = "Guardar cambios";
            cancelBtn.classList.remove("d-none");

            const comercioName = el.dataset.comercio || "Comercio";
            formSubtitle.textContent = "Editando tu reseña para: " + comercioName;
            document.getElementById("reviewForm").scrollIntoView({ behavior: "smooth", block: "start" });
        }

        function exitEditMode() {
            reviewIdInput.value = "";
            setStars(0);
            txt.value = "";
            updateCount();

            submitText.textContent = "Publicar reseña";
            cancelBtn.classList.add("d-none");
            onFormComercioChange();
        }

        cancelBtn.addEventListener("click", exitEditMode);

        function onFormComercioChange() {
            const cid = parseInt(formComercioSelect.value || "0", 10);

            if (cid <= 0) {
                formSubtitle.textContent = "Selecciona un comercio para opinar";
                // Si estaba editando, lo dejamos como está (pero normalmente exitEditMode lo limpia)
                return;
            }

            const selectedText = formComercioSelect.options[formComercioSelect.selectedIndex].text;
            // Si NO estoy editando, y ya tengo reseña para ese comercio, precargo para editar
            if (!reviewIdInput.value) {
                const myEl = findMyReviewForComercio(cid);
                if (myEl) {
                    // Precarga modo edición pero sin forzar, puedes comentar esto si querés que el usuario le de "Editar"
                    enterEditFromElement(myEl);
                    return;
                }
            }

            formSubtitle.textContent = "Escribiendo reseña para: " + selectedText;
        }

        formComercioSelect.addEventListener("change", onFormComercioChange);

        // ---------- Buttons Edit/Delete inside feed ----------
        document.querySelectorAll("[data-edit='1']").forEach(btn => {
            btn.addEventListener("click", () => {
                const id = btn.dataset.reviewid;
                const el = items.find(x => x.dataset.id === id);
                if (!el) return;
                enterEditFromElement(el);
            });
        });

        const deleteForm = document.getElementById("deleteForm");
        const deleteId = document.getElementById("DeleteReviewId");

        document.querySelectorAll("[data-delete='1']").forEach(btn => {
            btn.addEventListener("click", () => {
                const id = btn.dataset.reviewid;
                if (!id) return;

                const ok = confirm("¿Eliminar tu reseña? Esta acción no se puede deshacer.");
                if (!ok) return;

                deleteId.value = String(id);
                deleteForm.submit();
            });
        });

        // ---------- Client validation ----------
        const form = document.getElementById("reviewForm");
        form.addEventListener("submit", (e) => {
            const cid = parseInt(formComercioSelect.value || "0", 10);
            const r = parseInt(ratingInput.value || "0", 10);
            const c = (txt.value || "").trim();

            if (cid <= 0) {
                e.preventDefault();
                alert("Selecciona un comercio para dejar tu reseña.");
                return;
            }
            if (r < 1 || r > 5) {
                e.preventDefault();
                alert("Selecciona una calificación de 1 a 5.");
                return;
            }
            if (c.length < 5) {
                e.preventDefault();
                alert("Escribe un comentario más descriptivo (mínimo 5 caracteres).");
                return;
            }
        });

        // Init
        setStars(0);
        applyFilters();

        // Si el select del form viene precargado, set subtitle
        onFormComercioChange();
    })();
</script>