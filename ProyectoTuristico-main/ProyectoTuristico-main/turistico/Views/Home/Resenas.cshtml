@model turistico.Controllers.ResenasPageVM
@using System
@using System.Linq
@using System.Collections.Generic

@{
    ViewBag.Title = "Reseñas";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var safeModel = Model ?? new turistico.Controllers.ResenasPageVM
    {
        Comercios = new List<turistico.Controllers.ComercioFiltroVM>(),
        Resenas = new List<turistico.Models.Resena>(),
        SelectedComercioId = 0,
        CurrentUserId = "",
        Search = "",
        Tipo = "",
        Sort = "recent",
        IsAuthenticated = false
    };

    Func<DateTime, string> fmtFecha = d => d.ToString("dd MMM yyyy");

    var tipos = safeModel.Comercios
        .Where(c => !string.IsNullOrWhiteSpace(c.Tipo))
        .Select(c => c.Tipo)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<style>
    :root {
        --sitm-green: #0f3d2e;
        --sitm-ink: #0f172a;
        --sitm-muted: #64748b;
        --sitm-border: #e7ebf0;
        --sitm-card: #ffffff;
        --sitm-soft: #eef6f1;
        --sitm-gray: #f2f4f7;
        --sitm-warn: #8a6a00;
        --sitm-warn-bg: #fff7da;
        --sitm-danger: #8b1c1c;
        --sitm-danger-bg: #fdecec;
        --radius: 16px;
    }

    .sitm-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: .25rem 0 1rem;
    }

    .sitm-title {
        margin: 0;
        font-weight: 900;
        color: var(--sitm-ink);
    }

    .sitm-sub {
        color: var(--sitm-muted);
        margin: .15rem 0 0;
        font-size: .95rem;
    }

    .sitm-pill {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .35rem .6rem;
        border-radius: 999px;
        background: var(--sitm-soft);
        color: var(--sitm-green);
        border: 1px solid rgba(15,61,46,.12);
        font-weight: 800;
        font-size: .85rem;
        white-space: nowrap;
    }

    .sitm-card {
        background: var(--sitm-card);
        border: 1px solid var(--sitm-border);
        border-radius: var(--radius);
        box-shadow: 0 10px 26px rgba(15,23,42,.06);
    }

        .sitm-card .card-header {
            background: transparent;
            border-bottom: 1px solid var(--sitm-border);
            border-top-left-radius: var(--radius);
            border-top-right-radius: var(--radius);
        }

    .filters {
        padding: 1rem;
    }

    .form-label {
        font-weight: 900;
        color: var(--sitm-ink);
    }

    .sitm-main {
        display: grid;
        grid-template-columns: 1.65fr .95fr;
        gap: 1rem;
        margin-top: 1rem;
        align-items: start;
    }

    @@media (max-width: 991.98px) {
        .sitm-main {
            grid-template-columns: 1fr;
        }

        .sitm-sticky {
            position: static !important;
            top: auto !important;
        }

        .sitm-header {
            flex-direction: column;
        }
    }

    .sitm-sticky {
        position: sticky;
        top: 92px;
    }

    .feed-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .feed-meta {
        color: var(--sitm-muted);
        font-size: .88rem;
    }

    .review {
        padding: 1rem 1.05rem;
        border-bottom: 1px solid var(--sitm-border);
        transition: background .12s ease;
    }

        .review:hover {
            background: rgba(246,248,251,.65);
        }

        .review:last-child {
            border-bottom: none;
            border-bottom-left-radius: var(--radius);
            border-bottom-right-radius: var(--radius);
        }

    .review-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .comercio-name {
        font-weight: 950;
        color: var(--sitm-ink);
        margin: 0;
        line-height: 1.2;
    }

    .comercio-sub {
        color: var(--sitm-muted);
        font-size: .9rem;
        margin: .15rem 0 0;
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .badge-soft {
        border-radius: 999px;
        padding: .32rem .55rem;
        font-weight: 900;
        font-size: .76rem;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        white-space: nowrap;
    }

    .b-type {
        background: rgba(15,61,46,.06);
        color: var(--sitm-green);
        border-color: rgba(15,61,46,.12);
    }

    .b-loc {
        background: var(--sitm-gray);
        color: #334155;
        border-color: rgba(2,6,23,.06);
    }

    .b-pub {
        background: var(--sitm-soft);
        color: var(--sitm-green);
        border-color: rgba(15,61,46,.12);
    }

    .b-pen {
        background: var(--sitm-warn-bg);
        color: var(--sitm-warn);
        border-color: rgba(138,106,0,.18);
    }

    .b-mod {
        background: var(--sitm-danger-bg);
        color: var(--sitm-danger);
        border-color: rgba(139,28,28,.18);
    }

    .who {
        display: flex;
        align-items: center;
        gap: .65rem;
        margin-top: .65rem;
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        background: rgba(15,61,46,.08);
        border: 1px solid rgba(15,61,46,.12);
        display: grid;
        place-items: center;
        color: var(--sitm-green);
        font-weight: 950;
        flex: 0 0 auto;
    }

    .who-name {
        font-weight: 900;
        color: var(--sitm-ink);
        line-height: 1.1;
    }

    .who-date {
        color: var(--sitm-muted);
        font-size: .85rem;
    }

    .stars {
        display: inline-flex;
        align-items: center;
        gap: .1rem;
        line-height: 1;
    }

        .stars i {
            font-size: 1.02rem;
            color: rgba(15,61,46,.18);
        }

            .stars i.on {
                color: var(--sitm-green);
            }

    .review-body {
        margin-top: .65rem;
        color: #334155;
    }

    .my-tag {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: var(--sitm-green);
        font-weight: 900;
        font-size: .85rem;
    }

    .btn-sitm {
        border-radius: 12px;
        font-weight: 900;
        padding: .5rem .75rem;
    }

    .btn-outline-sitm {
        border: 1px solid rgba(15,61,46,.25);
        color: var(--sitm-green);
        background: #fff;
    }

        .btn-outline-sitm:hover {
            background: rgba(15,61,46,.06);
            border-color: rgba(15,61,46,.35);
            color: var(--sitm-green);
        }

    .btn-danger-soft {
        border: 1px solid rgba(139,28,28,.22);
        color: var(--sitm-danger);
        background: #fff;
    }

        .btn-danger-soft:hover {
            background: rgba(139,28,28,.06);
            border-color: rgba(139,28,28,.32);
            color: var(--sitm-danger);
        }

    .hint {
        color: var(--sitm-muted);
        font-size: .88rem;
    }

    .empty {
        padding: 1.2rem;
        text-align: center;
        color: var(--sitm-muted);
    }

        .empty i {
            font-size: 1.5rem;
            color: rgba(15,61,46,.35);
        }

    .login-box {
        text-align: center;
        padding: 1rem;
        border: 1px dashed rgba(15,61,46,.18);
        border-radius: 14px;
        background: rgba(15,61,46,.03);
    }

    .sitm-modal .modal-content {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(15, 23, 42, .18);
    }

    .sitm-modal .modal-header {
        background: linear-gradient(135deg, #fff5f5, #fdecec);
        border-bottom: 1px solid #f3d2d2;
    }

    .sitm-modal .modal-title {
        font-weight: 900;
        color: #7f1d1d;
    }

    .sitm-modal .modal-body {
        color: #334155;
    }
</style>

<div class="container-xxl py-3 py-lg-4">
    @Html.Partial("_Alerts")

    <div class="sitm-header">
        <div>
            <h2 class="sitm-title">Reseñas</h2>
            <p class="sitm-sub mb-0">
                Portal municipal para <span class="fw-semibold text-dark">Comercios</span> · Consulta y comparte experiencias
            </p>
            <div class="mt-2 d-flex flex-wrap gap-2">
                <span class="sitm-pill"><i class="bi bi-shield-check"></i> Confiable · Moderación institucional</span>
                <span class="sitm-pill"><i class="bi bi-funnel"></i> Filtros y selección de comercio</span>
                <a href="@Url.Action("Index", "Resenas")" class="btn btn-outline-sitm btn-sitm">
                    <i class="bi bi-chat-quote"></i> Ver todas las reseñas
                </a>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-light btn-sitm">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    <div class="sitm-card">
        <div class="card-header px-3 py-3 d-flex align-items-center justify-content-between">
            <div class="fw-bold text-dark"><i class="bi bi-sliders"></i> Filtros</div>
            <div class="feed-meta"><i class="bi bi-info-circle"></i> Puedes filtrar y luego seleccionar un comercio para opinar</div>
        </div>

        <div class="filters">
            <form method="get" action="@Url.Action("Index", "Resenas")">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-4">
                        <label class="form-label">Buscar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" name="q" value="@safeModel.Search" placeholder="Comercio, usuario o comentario..." />
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label">Tipo de comercio</label>
                        <select class="form-select" name="tipo">
                            <option value="">Todos</option>
                            @foreach (var t in tipos)
                            {
                                <option value="@t" @(safeModel.Tipo == t ? "selected" : "")>@t</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label">Comercio</label>
                        <select class="form-select" name="comercioId">
                            <option value="0">Todos (ver feed completo)</option>
                            @foreach (var c in safeModel.Comercios.OrderBy(x => x.Nombre))
                            {
                                <option value="@c.Id" @(c.Id == safeModel.SelectedComercioId ? "selected" : "")>@c.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <label class="form-label">Ordenar</label>
                        <select class="form-select" name="sort">
                            <option value="recent" @(safeModel.Sort == "recent" ? "selected" : "")>Más recientes</option>
                            <option value="best" @(safeModel.Sort == "best" ? "selected" : "")>Mejor puntuadas</option>
                            <option value="worst" @(safeModel.Sort == "worst" ? "selected" : "")>Peor puntuadas</option>
                        </select>
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-success btn-sitm">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                        <a href="@Url.Action("Index", "Resenas")" class="btn btn-light btn-sitm">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="sitm-main">
        <div class="sitm-card p-0">
            <div class="card-header px-3 py-3">
                <div class="feed-head">
                    <div class="fw-bold text-dark"><i class="bi bi-chat-quote"></i> Reseñas de Comercios</div>
                    <div class="feed-meta">
                        @(safeModel.Resenas != null ? safeModel.Resenas.Count : 0) resultado(s)
                    </div>
                </div>
            </div>

            <div id="feed">
                @if (safeModel.Resenas != null && safeModel.Resenas.Any())
                {
                    foreach (var r in safeModel.Resenas)
                    {
                        var comercioNombre = r.Comercio != null ? r.Comercio.Nombre : "Comercio";

                        var tipoComercio =
                            (r.Comercio != null && r.Comercio.Lugar != null && r.Comercio.Lugar.Categoria != null)
                            ? r.Comercio.Lugar.Categoria.Nombre
                            : "Sin tipo";

                        var ubicacion =
                            (r.Comercio != null && r.Comercio.Lugar != null && !string.IsNullOrWhiteSpace(r.Comercio.Lugar.Direccion))
                            ? r.Comercio.Lugar.Direccion
                            : "Ubicación no disponible";

                        var nombreUser = r.User != null ? (r.User.Nombre ?? "") : "";
                        var apellidoUser = r.User != null ? (r.User.Apellido ?? "") : "";
                        var usuario = (nombreUser + " " + apellidoUser).Trim();

                        if (string.IsNullOrWhiteSpace(usuario))
                        {
                            usuario = r.User != null ? (r.User.Email ?? "Usuario") : "Usuario";
                        }

                        bool isMine = r.UserId == safeModel.CurrentUserId;

                        string badgeClass = "b-pub";
                        string badgeIcon = "bi-check2-circle";
                        string badgeLabel = "Publicada";

                        if (r.Estado == "Pendiente")
                        {
                            badgeClass = "b-pen";
                            badgeIcon = "bi-hourglass-split";
                            badgeLabel = "En revisión";
                        }
                        else if (r.Estado == "Rechazada" || r.Estado == "Oculta")
                        {
                            badgeClass = "b-mod";
                            badgeIcon = "bi-shield-exclamation";
                            badgeLabel = r.Estado;
                        }

                        string initial = string.IsNullOrWhiteSpace(usuario) ? "U" : usuario.Substring(0, 1).ToUpper();

                        <div class="review">
                            <div class="review-top">
                                <div>
                                    <h5 class="comercio-name">@comercioNombre</h5>
                                    <div class="comercio-sub">
                                        <span class="badge-soft b-type"><i class="bi bi-tag"></i> @tipoComercio</span>
                                        <span class="badge-soft b-loc"><i class="bi bi-geo-alt"></i> @ubicacion</span>
                                        <span class="badge-soft @badgeClass"><i class="bi @badgeIcon"></i> @badgeLabel</span>

                                        @if (isMine)
                                        {
                                            <span class="my-tag"><i class="bi bi-person-check"></i> Tu reseña</span>
                                        }
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div class="stars" aria-label="@r.Calificacion de 5">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <i class="bi bi-star-fill @(s <= r.Calificacion ? "on" : "")"></i>
                                        }
                                    </div>
                                    <div class="who-date mt-1">@fmtFecha(r.Fecha)</div>
                                </div>
                            </div>

                            <div class="who">
                                <div class="avatar">@initial</div>
                                <div>
                                    <div class="who-name">@usuario</div>
                                    <div class="who-date">Opinión ciudadana</div>
                                </div>
                            </div>

                            <div class="review-body">@r.Comentario</div>

                            @if (isMine && safeModel.IsAuthenticated)
                            {
                                <div class="mt-3 d-flex justify-content-end gap-2 flex-wrap">
                                    <button type="button"
                                            class="btn btn-danger-soft btn-sitm btn-open-delete"
                                            data-review-id="@r.Id"
                                            data-comercio="@comercioNombre">
                                        <i class="bi bi-trash3"></i> Eliminar
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty">
                        <i class="bi bi-chat-square-text"></i>
                        <div class="mt-2 fw-bold text-dark">No hay reseñas con esos filtros</div>
                        <div class="mt-1">Prueba cambiando el comercio, el tipo o el texto de búsqueda.</div>
                    </div>
                }
            </div>
        </div>

        <div class="sitm-card sitm-sticky">
            <div class="card-header px-3 py-3">
                <div class="fw-bold text-dark"><i class="bi bi-pencil"></i> Tu reseña</div>
                <div class="text-muted small">
                    @(safeModel.IsAuthenticated ? "Selecciona un comercio para opinar" : "Inicia sesión para publicar tu reseña")
                </div>
            </div>

            <div class="p-3">
                @if (safeModel.IsAuthenticated)
                {
                    using (Html.BeginForm("Guardar", "Resenas", FormMethod.Post, new { autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Comercio</label>
                            <select class="form-select" name="ComercioId" required>
                                <option value="">Seleccione un comercio...</option>
                                @foreach (var c in safeModel.Comercios.OrderBy(x => x.Nombre))
                                {
                                    <option value="@c.Id" @(c.Id == safeModel.SelectedComercioId ? "selected" : "")>@c.Nombre</option>
                                }
                            </select>
                            <div class="hint mt-1">El comercio elegido define a quién va dirigida tu reseña.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Calificación</label>
                            <select class="form-select" name="Rating" required>
                                <option value="">Seleccione...</option>
                                <option value="1">1 estrella</option>
                                <option value="2">2 estrellas</option>
                                <option value="3">3 estrellas</option>
                                <option value="4">4 estrellas</option>
                                <option value="5">5 estrellas</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="Comentario" class="form-label">Comentario</label>
                            <textarea id="Comentario" name="Comentario" class="form-control"
                                      rows="4"
                                      placeholder="Describe tu experiencia (máx. 500 caracteres)"
                                      maxlength="500"
                                      required></textarea>

                            <div class="d-flex justify-content-between mt-1">
                                <span class="hint">Evita datos personales y lenguaje ofensivo.</span>
                                <span class="hint">Máximo 500 caracteres</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit"
                                    class="btn btn-sitm"
                                    style="background:var(--sitm-green);border-color:var(--sitm-green);color:#fff;">
                                <i class="bi bi-send"></i> Publicar reseña
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="login-box">
                        <p class="text-muted mb-3">
                            Puedes ver todas las reseñas sin iniciar sesión.
                            Para publicar la tuya, primero debes ingresar.
                        </p>

                        <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Index", "Resenas") })"
                           class="btn btn-success btn-sitm w-100 mb-2">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión para opinar
                        </a>

                        <a href="@Url.Action("Index", "Resenas")"
                           class="btn btn-outline-sitm btn-sitm w-100">
                            <i class="bi bi-chat-quote"></i> Ver todas las reseñas
                        </a>
                    </div>
                }

                <hr class="my-3" />
                <div class="hint"><i class="bi bi-info-circle"></i> Algunas reseñas pueden pasar a <b>revisión</b> antes de publicarse.</div>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm("Delete", "Resenas", FormMethod.Post, new { id = "deleteReviewForm" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="reviewId" id="deleteReviewId" />
}

<div class="modal fade sitm-modal" id="deleteReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Eliminar reseña
                    </h5>
                    <div class="small text-muted">Esta acción no se puede deshacer.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Vas a eliminar tu reseña del comercio:</p>
                <div class="fw-bold text-dark" id="deleteReviewCommerceName">—</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-sitm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sitm" id="confirmDeleteReviewBtn">
                    <i class="bi bi-trash3 me-1"></i> Sí, eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modalEl = document.getElementById('deleteReviewModal');
            const reviewIdInput = document.getElementById('deleteReviewId');
            const commerceNameEl = document.getElementById('deleteReviewCommerceName');
            const confirmBtn = document.getElementById('confirmDeleteReviewBtn');
            const form = document.getElementById('deleteReviewForm');

            if (!modalEl || !confirmBtn || !form) return;

            const deleteModal = new bootstrap.Modal(modalEl);

            document.querySelectorAll('.btn-open-delete').forEach(btn => {
                btn.addEventListener('click', function () {
                    const reviewId = this.getAttribute('data-review-id');
                    const comercio = this.getAttribute('data-comercio');

                    reviewIdInput.value = reviewId || '';
                    commerceNameEl.textContent = comercio || 'Comercio';

                    deleteModal.show();
                });
            });

            confirmBtn.addEventListener('click', function () {
                form.submit();
            });
        })();
    </script>
}