@model turistico.Models.MapaTuristicoVM
@using System.Globalization

@{
    ViewBag.Title = "Mapa Turístico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Leaflet CSS (CDN) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    /* =========================
       LOOK & FEEL (FROG THEME)
       ========================= */

    :root {
        --g1: #1b7a5c;
        --g2: #2e9e7f;
        --ink: #0f172a;
        --muted: rgba(15, 23, 42, .65);
        --card: rgba(255,255,255,.86);
        --stroke: rgba(15, 23, 42, .08);
        --shadow: 0 14px 45px rgba(2, 8, 23, .10);
        --shadow-soft: 0 10px 30px rgba(2, 8, 23, .08);
        --radius: 18px;
    }

    body {
        background: linear-gradient(rgba(248,250,252,.4), rgba(243,247,246,.45)), url('/Content/im/img1.png'), radial-gradient(circle at 10% 10%, rgba(46,158,127,.10), transparent 40%), radial-gradient(circle at 90% 30%, rgba(27,122,92,.10), transparent 45%), radial-gradient(circle at 50% 100%, rgba(46,158,127,.08), transparent 50%);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .frog-stage {
        position: relative;
        isolation: isolate;
        overflow: visible;
    }

    .frog {
        position: absolute;
        z-index: 2;
        width: 150px;
        opacity: 0.35;
        pointer-events: none;
        animation: frogFloat 7s ease-in-out infinite;
    }

        .frog.f1 {
            top: 120px;
            right: -90px;
        }

        .frog.f2 {
            bottom: 60px;
            left: -100px;
            width: 180px;
        }

        .frog.f3 {
            top: 55%;
            right: -120px;
            width: 140px;
            opacity: 0.28;
        }

    @@keyframes frogFloat {
        0% {
            transform: translateY(0) rotate(-2deg);
        }

        50% {
            transform: translateY(-10px) rotate(2deg);
        }

        100% {
            transform: translateY(0) rotate(-2deg);
        }
    }

    .hero-map {
        position: relative;
        z-index: 2;
        background: linear-gradient(135deg, rgba(27,122,92,.75), rgba(27,122,92,.55));
        border: 1px solid rgba(255,255,255,.25);
        border-radius: var(--radius);
        padding: 24px;
        box-shadow: 0 18px 50px rgba(0,0,0,.25);
        backdrop-filter: blur(6px);
        color: #fff;
        overflow: hidden;
        animation: popIn .55s ease-out both;
    }

    @@keyframes popIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .search-wrap {
        position: relative;
    }

    .search-pill {
        border-radius: 999px !important;
        padding-left: 48px !important;
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: 0 10px 25px rgba(2,8,23,.08);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .search-pill:focus {
            border-color: rgba(46,158,127,.45);
            box-shadow: 0 14px 36px rgba(2,8,23,.12);
            transform: translateY(-1px);
        }

    .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        opacity: .6;
        pointer-events: none;
    }

    .filter-card, .map-card, .place-card {
        border-radius: 16px;
        border: 1px solid var(--stroke);
        background: var(--card);
        box-shadow: var(--shadow-soft);
        backdrop-filter: blur(10px);
    }

    .filter-card {
        position: sticky;
        top: 92px;
    }

    .badge-soft {
        background: rgba(25,135,84,.12) !important;
        color: #198754 !important;
        border: 1px solid rgba(25,135,84,.20);
    }

    .btn-soft-success {
        background: rgba(25,135,84,.10);
        color: #198754;
        border: 1px solid rgba(25,135,84,.25);
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

        .btn-soft-success:hover {
            background: rgba(25,135,84,.16);
            color: #146c43;
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(2,8,23,.10);
        }

    .map-card {
        overflow: hidden;
        transform: translateZ(0);
    }

    #leafletMap {
        width: 100%;
        height: 370px;
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,.08);
    }

    /* Controles Leaflet más “pro” */
    .leaflet-control-layers,
    .leaflet-bar {
        border-radius: 14px !important;
        overflow: hidden;
        border: 1px solid rgba(15,23,42,.12) !important;
        box-shadow: 0 12px 30px rgba(2,8,23,.12) !important;
    }

        .leaflet-control-layers-toggle,
        .leaflet-bar a {
            width: 34px;
            height: 34px;
            line-height: 34px;
        }

    .place-title {
        line-height: 1.2;
    }

    .place-card {
        position: relative;
        overflow: hidden;
        transform: translateZ(0);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .place-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 55px rgba(0,0,0,.18);
            border-color: rgba(46,158,127,.35);
        }

    .place-thumb {
        width: 100%;
        height: 120px;
        border-radius: 14px;
        object-fit: cover;
        margin-bottom: 10px;
        border: 1px solid rgba(15,23,42,.10);
    }

    .place-card .btn-outline-success {
        border-color: rgba(27,122,92,.6);
        color: #1b7a5c;
        background: transparent;
        transition: all .2s ease;
    }

        .place-card .btn-outline-success:hover {
            background: rgba(27,122,92,.1);
            color: #145c45;
            transform: translateY(-1px);
        }

    .place-card .btn-success {
        background: linear-gradient(135deg, #1b7a5c, #2e9e7f);
        border: none;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .place-card .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(27,122,92,.4);
        }

    .reveal {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity .55s ease, transform .55s ease;
    }

        .reveal.show {
            opacity: 1;
            transform: translateY(0);
        }

    .btn-hero-clear {
        background: rgba(255,255,255,.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,.4);
        backdrop-filter: blur(4px);
        transition: all .2s ease;
    }

        .btn-hero-clear:hover {
            background: rgba(255,255,255,.28);
            color: #0f5132;
            border-color: rgba(255,255,255,.6);
        }

    .bubble-title {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        background: linear-gradient(135deg, #ff9f43, #ff7a18);
        color: #ffffff;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
        box-shadow: 0 6px 18px rgba(255,122,24,.35);
    }

    .bubble-count {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        background: linear-gradient(135deg, #ffb703, #fb8500);
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 600;
        box-shadow: 0 4px 14px rgba(251,133,0,.35);
        white-space: nowrap;
    }
</style>

<div class="container py-3 py-lg-4 frog-stage">

    <img class="frog f1" alt="Frog decoration"
         src="https://png.pngtree.com/png-clipart/20230912/original/pngtree-red-eyed-tree-frog-agalychnis-callidryas-isolated-copy-picture-image_13031778.png">
    <img class="frog f2" alt="Frog decoration"
         src="https://png.pngtree.com/png-clipart/20230912/original/pngtree-red-eyed-tree-frog-agalychnis-callidryas-isolated-copy-picture-image_13031778.png">
    <img class="frog f3" alt="Frog decoration"
         src="https://reptichip.com/cdn/shop/articles/Best_substrate_for_a_Red-eyed_tree_frog_Agalychnis_callidryas_ReptiChip_80942433-5f3f-4b05-865e-c6a8d49ad24b_600x.png?v=1755698331">

    <div class="hero-map mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <div class="reveal hero-text">
                <h2 class="fw-bold mb-1">Mapa Turístico</h2>
                <p class="fs-6 mb-0">
                    Explorá atractivos del cantón con búsqueda, categorías y ubicación en el mapa.
                </p>
            </div>

            <form class="w-100 w-lg-50 reveal" onsubmit="return false;">
                <div class="search-wrap">
                    <span class="search-icon">🔎</span>
                    <input id="searchInput" type="text"
                           class="form-control form-control-lg search-pill"
                           placeholder="Buscar lugares (ej: cascada, hotel, restaurante ...)">
                </div>

                <div class="d-flex gap-2 mt-2 flex-wrap">
                    <button id="btnClear" class="btn btn-sm btn-hero-clear rounded-pill" type="button">
                        Limpiar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">

        <!-- FILTROS (desde BD) -->
        <div class="col-lg-3 reveal">
            <div class="card filter-card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="fw-bold text-success mb-0">Filtros</h5>
                        <span class="badge badge-soft rounded-pill">Categorías</span>
                    </div>

                    <div class="vstack gap-2 mt-3">
                        @{
                            var i = 0;
                        }
                        @foreach (var cat in Model.Categorias)
                        {
                            i++;
                            <div class="form-check">
                                <input class="form-check-input filterCheck" type="checkbox" value="@cat" checked id="f@i">
                                <label class="form-check-label" for="f@i">@cat</label>
                            </div>
                        }
                    </div>

                    <hr class="my-3">

                    <button id="btnApply" class="btn btn-success w-100 rounded-pill" type="button">
                        Aplicar filtros
                    </button>

                    <button id="btnReset" class="btn btn-soft-success w-100 rounded-pill mt-2" type="button">
                        Restablecer
                    </button>
                </div>
            </div>
        </div>

        <!-- MAPA + LISTADO -->
        <div class="col-lg-9">

            <!-- MAPA Leaflet -->
            <div class="card map-card mb-4 reveal">
                <div class="card-body p-2 p-md-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <div class="fw-semibold text-success">Mapa</div>
                        <div class="text-muted small">Arrastrá y hacé zoom / cambiá el estilo del mapa.</div>
                    </div>

                    <div id="leafletMap"></div>
                </div>
            </div>

            <!-- LISTADO -->
            <div class="d-flex align-items-center gap-2 mb-3 reveal">
                <h5 class="fw-bold mb-0 bubble-title">Lugares</h5>
                <span id="resultCount" class="bubble-count">@Model.Lugares.Count resultado(s)</span>
            </div>

            <div id="placesGrid" class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3">
                @foreach (var l in Model.Lugares)
                {
                    var latStr = l.Latitud.HasValue ? l.Latitud.Value.ToString(CultureInfo.InvariantCulture) : "";
                    var lngStr = l.Longitud.HasValue ? l.Longitud.Value.ToString(CultureInfo.InvariantCulture) : "";

                    <div class="col place-item reveal"
                         data-id="@l.Id"
                         data-name="@l.Nombre"
                         data-cat="@l.Categoria"
                         data-lat="@latStr"
                         data-lng="@lngStr">

                        <div class="card place-card h-100">
                            <div class="card-body">
                                @if (!string.IsNullOrWhiteSpace(l.ImagenUrl))
                                {
                                    <img class="place-thumb" src="@l.ImagenUrl" alt="@l.Nombre" loading="lazy" />
                                }

                                <h6 class="fw-bold text-success place-title mb-2">@l.Nombre</h6>
                                <p class="text-muted mb-2">@l.Descripcion</p>
                                <span class="badge rounded-pill badge-soft">@l.Categoria</span>

                                <div class="mt-3 d-flex gap-2 flex-wrap">
                                    @if (l.EsComercio)
                                    {
                                        <a href="@Url.Action("Detalles", "Comercios", new { id = l.Id })"
                                           class="btn btn-outline-success btn-sm rounded-pill">
                                            Ver detalle
                                        </a>
                                    }

                                    <button type="button" class="btn btn-success btn-sm rounded-pill btnUbicar">
                                        Ubicar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- Leaflet JS (CDN) -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    // Helpers: parsear números aunque vengan con coma "10,09"
    function toNum(v) {
        if (!v) return NaN;
        return parseFloat(String(v).replace(",", "."));
    }

    // ====== 1) MAPA Leaflet (centrado en San Carlos) ======
    const SAN_CARLOS_CENTER = { lat: 10.3266, lng: -84.432 };

    const map = L.map('leafletMap', {
        scrollWheelZoom: true,
        zoomControl: false
    }).setView([SAN_CARLOS_CENTER.lat, SAN_CARLOS_CENTER.lng], 11);

    // Zoom “pro” a la derecha
    L.control.zoom({ position: 'topright' }).addTo(map);

    // Capas (para que se vea más profesional)
    const cartoLight = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        maxZoom: 20,
        attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
    });

    const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
    });

    const esriSat = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 20,
        attribution: 'Tiles &copy; Esri'
    });

    // Por defecto (más “clean”)
    cartoLight.addTo(map);

    L.control.layers({
        "Claro (pro)": cartoLight,
        "OpenStreetMap": osm,
        "Satélite": esriSat
    }, null, { collapsed: true, position: 'topright' }).addTo(map);

    L.control.scale({ metric: true, imperial: false }).addTo(map);

    // Marcador centro (opcional)
    const cantonMarker = L.marker([SAN_CARLOS_CENTER.lat, SAN_CARLOS_CENTER.lng])
        .addTo(map)
        .bindPopup('Centro de San Carlos (Ciudad Quesada)');

    // Marcadores por lugar
    const markersByEl = new Map();

    document.querySelectorAll(".place-item").forEach(el => {
        const lat = toNum(el.dataset.lat);
        const lng = toNum(el.dataset.lng);

        if (!Number.isNaN(lat) && !Number.isNaN(lng)) {
            const title = el.dataset.name || "Lugar";
            const cat = el.dataset.cat || "";
            const marker = L.marker([lat, lng]).bindPopup(`<strong>${title}</strong><br>${cat}`);
            marker.addTo(map);
            markersByEl.set(el, marker);
        }
    });

    // ====== 2) Buscador + filtros ======
    const searchInput = document.getElementById("searchInput");
    const btnClear = document.getElementById("btnClear");
    const btnApply = document.getElementById("btnApply");
    const btnReset = document.getElementById("btnReset");
    const resultCount = document.getElementById("resultCount");

    function getSelectedCategories() {
        return Array.from(document.querySelectorAll(".filterCheck"))
            .filter(cb => cb.checked)
            .map(cb => cb.value);
    }

    function applyFilters() {
        const q = (searchInput.value || "").trim().toLowerCase();
        const cats = getSelectedCategories();
        const items = Array.from(document.querySelectorAll(".place-item"));

        let visible = 0;

        items.forEach(el => {
            const name = (el.getAttribute("data-name") || "").toLowerCase();
            const cat = el.getAttribute("data-cat") || "";

            const matchSearch = q === "" || name.includes(q);
            const matchCat = cats.length === 0 ? true : cats.includes(cat);

            const show = matchSearch && matchCat;

            el.style.display = show ? "" : "none";
            if (show) visible++;

            const marker = markersByEl.get(el);
            if (marker) {
                const isOnMap = map.hasLayer(marker);
                if (show && !isOnMap) marker.addTo(map);
                if (!show && isOnMap) map.removeLayer(marker);
            }
        });

        resultCount.textContent = `${visible} resultado(s)`;
    }

    searchInput.addEventListener("input", applyFilters);

    btnClear.addEventListener("click", () => {
        searchInput.value = "";
        applyFilters();
        searchInput.focus();
    });

    btnApply.addEventListener("click", applyFilters);

    btnReset.addEventListener("click", () => {
        document.querySelectorAll(".filterCheck").forEach(cb => cb.checked = true);
        searchInput.value = "";
        applyFilters();
    });

    // ====== Reveal scroll ======
    const revealEls = document.querySelectorAll(".reveal");
    const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add("show");
                io.unobserve(e.target);
            }
        });
    }, { threshold: 0.12 });

    revealEls.forEach(el => io.observe(el));

    // ====== 3) Botón Ubicar ======
    document.querySelectorAll(".btnUbicar").forEach(btn => {
        btn.addEventListener("click", (e) => {
            const placeEl = e.target.closest(".place-item");
            if (!placeEl) return;

            const lat = toNum(placeEl.dataset.lat);
            const lng = toNum(placeEl.dataset.lng);

            if (Number.isNaN(lat) || Number.isNaN(lng)) {
                map.setView([SAN_CARLOS_CENTER.lat, SAN_CARLOS_CENTER.lng], 11);
                cantonMarker.openPopup();
                return;
            }

            map.setView([lat, lng], 15);

            const marker = markersByEl.get(placeEl);
            if (marker) marker.openPopup();
        });
    });

    // Inicial
    applyFilters();
</script>