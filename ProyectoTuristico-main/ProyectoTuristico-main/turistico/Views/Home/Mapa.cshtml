@{
    ViewBag.Title = "Mapa Turístico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* =========================
       LOOK & FEEL (FROG THEME)
       ========================= */

    :root {
        --g1: #1b7a5c;
        --g2: #2e9e7f;
        --ink: #0f172a;
        --muted: rgba(15, 23, 42, .65);
        --card: rgba(255,255,255,.86);
        --stroke: rgba(15, 23, 42, .08);
        --shadow: 0 14px 45px rgba(2, 8, 23, .10);
        --shadow-soft: 0 10px 30px rgba(2, 8, 23, .08);
        --radius: 18px;
    }

    /* Fondo con patrón sutil */
    body {
        background:
        /* overlay MUCHO más ligero */
        linear-gradient(rgba(248,250,252,.4), rgba(243,247,246,.45)),
        /* imagen */
        url('/Content/im/img1.png'),
        /* gradientes decorativos */
        radial-gradient(circle at 10% 10%, rgba(46,158,127,.10), transparent 40%), radial-gradient(circle at 90% 30%, rgba(27,122,92,.10), transparent 45%), radial-gradient(circle at 50% 100%, rgba(46,158,127,.08), transparent 50%);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }



    /* Contenedor decorativo para ranas */
    .frog-stage {
        position: relative;
        isolation: isolate;
        overflow: visible;
    }


    /* “Stickers” de ranas (decoración) */
    .frog {
        position: absolute;
        z-index: 2; /* . ahora por ENCIMA del fondo */
        width: 150px;
        opacity: 0.35; /* más visibles */
        filter: none; /* . sin blur */
        pointer-events: none;
        animation: frogFloat 7s ease-in-out infinite;
    }

        .frog.f1 {
            top: 120px;
            right: -90px; /* . sobresale */
        }

        .frog.f2 {
            bottom: 60px;
            left: -100px;
            width: 180px;
        }

        .frog.f3 {
            top: 55%;
            right: -120px;
            width: 140px;
            opacity: 0.28;
        }




    @@keyframes frogFloat {
        0% {
            transform: translateY(0) rotate(-2deg);
        }

        50% {
            transform: translateY(-10px) rotate(2deg);
        }

        100% {
            transform: translateY(0) rotate(-2deg);
        }
    }

    /* HERO */
    .hero-map {
        position: relative;
        z-index: 2;
        /* Fondo más sólido */
        background: linear-gradient( 135deg, rgba(27,122,92,.75), rgba(27,122,92,.55) );
        border: 1px solid rgba(255,255,255,.25);
        border-radius: var(--radius);
        padding: 24px;
        box-shadow: 0 18px 50px rgba(0,0,0,.25);
        /* Glass más sutil */
        backdrop-filter: blur(6px);
        color: #fff;
        overflow: hidden;
        animation: popIn .55s ease-out both;
    }

        .hero-map h2 {
            color: #ffffff;
        }

        .hero-map p {
            color: rgba(255,255,255,.85);
        }

    .hero-title {
        color: #ffffff;
    }

    .hero-subtitle {
        color: rgba(255,255,255,.85);
    }


    @@keyframes popIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-map h2 {
        letter-spacing: .2px;
    }

    /* Barra de búsqueda mejor */
    .search-wrap {
        position: relative;
    }

    .search-pill {
        border-radius: 999px !important;
        padding-left: 48px !important;
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: 0 10px 25px rgba(2,8,23,.08);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .search-pill:focus {
            border-color: rgba(46,158,127,.45);
            box-shadow: 0 14px 36px rgba(2,8,23,.12);
            transform: translateY(-1px);
        }

    .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        opacity: .6;
        pointer-events: none;
    }

    /* Cards base */
    .filter-card, .map-card, .place-card {
        border-radius: 16px;
        border: 1px solid var(--stroke);
        background: var(--card);
        box-shadow: var(--shadow-soft);
        backdrop-filter: blur(10px);
    }

    /* Sidebar Filtros (más premium) */
    .filter-card {
        position: sticky;
        top: 92px; 
    }

        .filter-card .card-body {
            position: relative;
            z-index: 1;
        }

    .badge-soft {
        background: rgba(25,135,84,.12) !important;
        color: #198754 !important;
        border: 1px solid rgba(25,135,84,.20);
    }

    .btn-soft-success {
        background: rgba(25,135,84,.10);
        color: #198754;
        border: 1px solid rgba(25,135,84,.25);
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

        .btn-soft-success:hover {
            background: rgba(25,135,84,.16);
            color: #146c43;
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(2,8,23,.10);
        }

    /* Mapa */
    .map-card {
        overflow: hidden;
        transform: translateZ(0);
    }

        .map-card iframe {
            border: 0;
            width: 100%;
            height: 370px;
            border-radius: 16px;
            transition: transform .35s ease;
        }

        .map-card:hover iframe {
            transform: scale(1.01);
        }

    /* Lugares: animación hover + brillo */
    .place-title {
        line-height: 1.2;
    }

    .place-card {
        position: relative;
        overflow: hidden;
        transform: translateZ(0);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }



        .place-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow);
            border-color: rgba(46,158,127,.25);
        }

    .place-card {
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .place-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 55px rgba(0,0,0,.18);
            border-color: rgba(46,158,127,.35);
        }


        /* Botones con “bounce” sutil */
        .place-card .btn-outline-success {
            border-color: rgba(27,122,92,.6);
            color: #1b7a5c;
            background: transparent;
            transition: all .2s ease;
        }

            .place-card .btn-outline-success:hover {
                background: rgba(27,122,92,.1);
                color: #145c45;
                transform: translateY(-1px);
            }

        .place-card .btn-success {
            background: linear-gradient(135deg, #1b7a5c, #2e9e7f);
            border: none;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .place-card .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(27,122,92,.4);
            }

        .place-card:hover .btn {
            transform: translateY(-1px);
        }


    .btn {
        transition: transform .12s ease, box-shadow .12s ease;
    }

        .btn:active {
            transform: translateY(1px) scale(.99);
        }

    /* Animación entrada al hacer scroll */
    .reveal {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity .55s ease, transform .55s ease;
    }

        .reveal.show {
            opacity: 1;
            transform: translateY(0);
        }

    /* Micro-detalle: separadores suaves */
    hr {
        opacity: .12;
    }

    .btn-hero-clear {
        background: rgba(255,255,255,.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,.4);
        backdrop-filter: blur(4px);
        transition: all .2s ease;
    }


        .btn-hero-clear:hover {
            background: rgba(255,255,255,.28);
            color: #0f5132;
            border-color: rgba(255,255,255,.6);
        }

    .bubble-title {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px; /* forma burbuja */
        background: linear-gradient(135deg, #ff9f43, #ff7a18);
        color: #ffffff;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
        box-shadow: 0 6px 18px rgba(255,122,24,.35);
    }

    .bubble-title {
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .bubble-title:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(255,122,24,.45);
        }



    /* Reduce motion */
    @@media (prefers-reduced-motion: reduce) {
        .frog,
        .hero-map,
        .place-card,
        .map-card iframe,
        .reveal {
            animation: none !important;
            transition: none !important;
        }
    }

    .bubble-count {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        background: linear-gradient(135deg, #ffb703, #fb8500);
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 600;
        box-shadow: 0 4px 14px rgba(251,133,0,.35);
        white-space: nowrap;
    }
</style>

<div class="container py-3 py-lg-4 frog-stage">

    <!-- RANAS DECORATIVAS (puedes cambiar links) -->
    <img class="frog f1" alt="Frog decoration"
         src="https://png.pngtree.com/png-clipart/20230912/original/pngtree-red-eyed-tree-frog-agalychnis-callidryas-isolated-copy-picture-image_13031778.png">
    <img class="frog f2" alt="Frog decoration"
         src="https://png.pngtree.com/png-clipart/20230912/original/pngtree-red-eyed-tree-frog-agalychnis-callidryas-isolated-copy-picture-image_13031778.png">
    <img class="frog f3" alt="Frog decoration"
         src="https://reptichip.com/cdn/shop/articles/Best_substrate_for_a_Red-eyed_tree_frog_Agalychnis_callidryas_ReptiChip_80942433-5f3f-4b05-865e-c6a8d49ad24b_600x.png?v=1755698331">

    <!-- HERO / CABECERA -->
    <div class="hero-map mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <div class="reveal hero-text">
                <h2 class="fw-bold mb-1">Mapa Turístico</h2>
                <p class="fs-6 mb-0">
                    Explorá atractivos del cantón con búsqueda, categorías y ubicación en el mapa.
                </p>
            </div>


            <!-- BUSCADOR -->
            <form class="w-100 w-lg-50 reveal" onsubmit="return false;">
                <div class="search-wrap">
                    <span class="search-icon">🔎</span>
                    <input id="searchInput" type="text"
                           class="form-control form-control-lg search-pill"
                           placeholder="Buscar lugares (ej: cascada, hotel, restaurante ...)">
                </div>

                <div class="d-flex gap-2 mt-2 flex-wrap">
                    <button id="btnClear" class="btn btn-sm btn-hero-clear rounded-pill" type="button">

                        Limpiar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">

        <!-- FILTROS -->
        <div class="col-lg-3 reveal">
            <div class="card filter-card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="fw-bold text-success mb-0">Filtros</h5>
                        <span class="badge badge-soft rounded-pill">Categorías</span>
                    </div>

                    <div class="vstack gap-2 mt-3">
                        <div class="form-check">
                            <input class="form-check-input filterCheck" type="checkbox" value="Naturaleza" checked id="f1">
                            <label class="form-check-label" for="f1">Naturaleza</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input filterCheck" type="checkbox" value="Gastronomía" checked id="f2">
                            <label class="form-check-label" for="f2">Gastronomía</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input filterCheck" type="checkbox" value="Cultura" checked id="f3">
                            <label class="form-check-label" for="f3">Cultura</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input filterCheck" type="checkbox" value="Hospedaje" checked id="f4">
                            <label class="form-check-label" for="f4">Hospedaje</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input filterCheck" type="checkbox" value="Aventura" checked id="f5">
                            <label class="form-check-label" for="f5">Aventura</label>
                        </div>
                    </div>

                    <hr class="my-3">

                    <button id="btnApply" class="btn btn-success w-100 rounded-pill" type="button">
                        Aplicar filtros
                    </button>

                    <button id="btnReset" class="btn btn-soft-success w-100 rounded-pill mt-2" type="button">
                        Restablecer
                    </button>
                </div>
            </div>
        </div>

        <!-- MAPA + LISTADO -->
        <div class="col-lg-9">

            <!-- MAPA -->
            <div class="card map-card mb-4 reveal">
                <div class="card-body p-2 p-md-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <div class="fw-semibold text-success">Mapa</div>
                        <div class="text-muted small">Podés incrustar el mapa del cantón (o un lugar específico).</div>
                    </div>

                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d62945.40272181664!2d-84.5246177!3d10.3320378!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa0f5a2e9c6a93f%3A0x6b5c4e2b9b5a6c7!2sSan%20Carlos%2C%20Alajuela!5e0!3m2!1ses!2scr!4v1700000000000"
                            width="100%"
                            height="370"
                            style="border:0; border-radius:16px;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>

            <!-- LISTADO -->
            <div class="d-flex align-items-center gap-2 mb-3 reveal">
                <h5 class="fw-bold mb-0 bubble-title">Lugares</h5>
                <span id="resultCount" class="bubble-count">5 resultados</span>
            </div>




            <div id="placesGrid" class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3">

                <!-- LUGAR 1 -->
                <div class="col place-item reveal" data-name="Cascada El Encanto" data-cat="Naturaleza">
                    <div class="card place-card h-100">
                        <div class="card-body">
                            <h6 class="fw-bold text-success place-title mb-2">Cascada El Encanto</h6>
                            <p class="text-muted mb-2">Atractivo natural rodeado de bosque.</p>
                            <span class="badge rounded-pill badge-soft">Naturaleza</span>

                            <div class="mt-3 d-flex gap-2">
                                <a href="#" class="btn btn-outline-success btn-sm rounded-pill">Ver detalle</a>
                                <button type="button" class="btn btn-success btn-sm rounded-pill">Ubicar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LUGAR 2 -->
                <div class="col place-item reveal" data-name="Restaurante Sabores Típicos" data-cat="Gastronomía">
                    <div class="card place-card h-100">
                        <div class="card-body">
                            <h6 class="fw-bold text-success place-title mb-2">Restaurante Sabores Típicos</h6>
                            <p class="text-muted mb-2">Comida tradicional costarricense.</p>
                            <span class="badge rounded-pill badge-soft">Gastronomía</span>

                            <div class="mt-3 d-flex gap-2">
                                <a href="#" class="btn btn-outline-success btn-sm rounded-pill">Ver detalle</a>
                                <button type="button" class="btn btn-success btn-sm rounded-pill">Ubicar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LUGAR 3 -->
                <div class="col place-item reveal" data-name="Casa Histórica Municipal" data-cat="Cultura">
                    <div class="card place-card h-100">
                        <div class="card-body">
                            <h6 class="fw-bold text-success place-title mb-2">Casa Histórico Municipal</h6>
                            <p class="text-muted mb-2">Patrimonio cultural del cantón.</p>
                            <span class="badge rounded-pill badge-soft">Cultura</span>

                            <div class="mt-3 d-flex gap-2">
                                <a href="#" class="btn btn-outline-success btn-sm rounded-pill">Ver detalle</a>
                                <button type="button" class="btn btn-success btn-sm rounded-pill">Ubicar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LUGAR 4 -->
                <div class="col place-item reveal" data-name="Hotel Mirador Verde" data-cat="Hospedaje">
                    <div class="card place-card h-100">
                        <div class="card-body">
                            <h6 class="fw-bold text-success place-title mb-2">Hotel Mirador Verde</h6>
                            <p class="text-muted mb-2">Hospedaje con vista panorámica.</p>
                            <span class="badge rounded-pill badge-soft">Hospedaje</span>

                            <div class="mt-3 d-flex gap-2">
                                <a href="#" class="btn btn-outline-success btn-sm rounded-pill">Ver detalle</a>
                                <button type="button" class="btn btn-success btn-sm rounded-pill">Ubicar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LUGAR 5 -->
                <div class="col place-item reveal" data-name="Sendero Los Robles" data-cat="Aventura">
                    <div class="card place-card h-100">
                        <div class="card-body">
                            <h6 class="fw-bold text-success place-title mb-2">Sendero Los Robles</h6>
                            <p class="text-muted mb-2">Ruta de caminata ecológica.</p>
                            <span class="badge rounded-pill badge-soft">Aventura</span>

                            <div class="mt-3 d-flex gap-2">
                                <a href="#" class="btn btn-outline-success btn-sm rounded-pill">Ver detalle</a>
                                <button type="button" class="btn btn-success btn-sm rounded-pill">Ubicar</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
    // ====== Buscador + filtros (front-end simple) ======
    const searchInput = document.getElementById("searchInput");
    const btnClear = document.getElementById("btnClear");
    const btnApply = document.getElementById("btnApply");
    const btnReset = document.getElementById("btnReset");
    const resultCount = document.getElementById("resultCount");

    function getSelectedCategories() {
        return Array.from(document.querySelectorAll(".filterCheck"))
            .filter(cb => cb.checked)
            .map(cb => cb.value);
    }

    function applyFilters() {
        const q = (searchInput.value || "").trim().toLowerCase();
        const cats = getSelectedCategories();
        const items = Array.from(document.querySelectorAll(".place-item"));

        let visible = 0;

        items.forEach(el => {
            const name = (el.getAttribute("data-name") || "").toLowerCase();
            const cat = el.getAttribute("data-cat") || "";

            const matchSearch = q === "" || name.includes(q);
            const matchCat = cats.length === 0 ? true : cats.includes(cat);

            const show = matchSearch && matchCat;

            el.style.display = show ? "" : "none";
            if (show) visible++;
        });

        resultCount.textContent = `${visible} resultado(s)`;
    }

    // Buscar en tiempo real
    searchInput.addEventListener("input", applyFilters);

    // Botones
    btnClear.addEventListener("click", () => {
        searchInput.value = "";
        applyFilters();
        searchInput.focus();
    });

    btnApply.addEventListener("click", applyFilters);

    btnReset.addEventListener("click", () => {
        document.querySelectorAll(".filterCheck").forEach(cb => cb.checked = true);
        searchInput.value = "";
        applyFilters();
    });

    // ====== Animación reveal al hacer scroll (sin librerías) ======
    const revealEls = document.querySelectorAll(".reveal");
    const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add("show");
                io.unobserve(e.target);
            }
        });
    }, { threshold: 0.12 });

    revealEls.forEach(el => io.observe(el));

    // Inicial
    applyFilters();
</script>
