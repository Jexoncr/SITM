@* ============================
    SITM - MisReservas.cshtml
    UI institucional (usuario final)
    Bootstrap 5 + Bootstrap Icons
    JS puro (sin jQuery)
    ============================ *@

@{
    ViewBag.Title = "Mis Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* ---------------------------------------------
    A futuro (cuando tengas ViewModel real):
    @model IEnumerable<SITM.ViewModels.ReservaUsuarioVM>
    --------------------------------------------- *@

@* MOCK DATA (temporal) - Reemplazar por Model *@
@{
    // Estados esperados: Confirmada, Pendiente, Cancelada, Finalizada
    var reservas = new object[]
    {
        new {
            Id = 101,
            Titulo = "Hotel Mirador Verde",
            Tipo = "Hotel",
            FechaInicio = new DateTime(2025, 08, 10),
            FechaFin = new DateTime(2025, 08, 12),
            Personas = 2,
            Plan = "Todo incluido",
            Estado = "Confirmada",
            PuedeCancelar = true
        },
        new {
            Id = 102,
            Titulo = "Restaurante Sabores Típicos",
            Tipo = "Restaurante",
            FechaInicio = new DateTime(2025, 08, 20),
            FechaFin = (DateTime?)null,
            Personas = 4,
            Plan = "Cena especial",
            Estado = "Pendiente",
            PuedeCancelar = true
        },
        new {
            Id = 103,
            Titulo = "Tour Catarata Escondida",
            Tipo = "Tour",
            FechaInicio = new DateTime(2025, 09, 05),
            FechaFin = (DateTime?)null,
            Personas = 3,
            Plan = "Paquete guiado",
            Estado = "Cancelada",
            PuedeCancelar = false
        },
        new {
            Id = 104,
            Titulo = "Evento Cultural Plaza Central",
            Tipo = "Evento",
            FechaInicio = new DateTime(2025, 07, 02),
            FechaFin = (DateTime?)null,
            Personas = 2,
            Plan = "Entrada general",
            Estado = "Finalizada",
            PuedeCancelar = false
        }
            };

    Func<string, string> estadoClass = (estado) =>
    {
        switch ((estado ?? "").Trim().ToLowerInvariant())
        {
            case "confirmada": return "status-confirmada";
            case "pendiente": return "status-pendiente";
            case "cancelada": return "status-cancelada";
            case "finalizada": return "status-finalizada";
            default: return "status-neutro";
        }
    };

    Func<string, string> estadoIcon = (estado) =>
    {
        switch ((estado ?? "").Trim().ToLowerInvariant())
        {
            case "confirmada": return "bi-check-circle";
            case "pendiente": return "bi-hourglass-split";
            case "cancelada": return "bi-x-circle";
            case "finalizada": return "bi-flag";
            default: return "bi-info-circle";
        }
    };

    Func<DateTime, string> fmt = (d) => d.ToString("dd/MM/yyyy");
}

<style>
    /* =========================
       Scoped UI (institucional)
       ========================= */

    :root {
        --sitm-green-900: #0f3d2e; /* verde institucional oscuro */
        --sitm-green-700: #155a43;
        --sitm-green-50: #eef6f1;
        --sitm-text: #1f2937;
        --sitm-muted: #6b7280;
        --sitm-border: #e5e7eb;
        --sitm-shadow: 0 8px 24px rgba(17, 24, 39, .08);
        --sitm-radius: 14px;
    }

    .sitm-page {
        color: var(--sitm-text);
    }

    .sitm-hero {
        background: linear-gradient(135deg, rgba(15,61,46,.10), rgba(21,90,67,.06));
        border: 1px solid rgba(21,90,67,.12);
        border-radius: var(--sitm-radius);
        padding: 1.25rem 1.25rem;
        box-shadow: 0 10px 26px rgba(15, 61, 46, .06);
    }

        .sitm-hero .title {
            font-weight: 800;
            letter-spacing: .2px;
            margin: 0;
            color: var(--sitm-green-900);
        }

        .sitm-hero .subtitle {
            color: var(--sitm-muted);
            margin: .25rem 0 0;
        }

    .sitm-toolbar {
        background: #fff;
        border: 1px solid var(--sitm-border);
        border-radius: var(--sitm-radius);
        box-shadow: 0 10px 22px rgba(17,24,39,.05);
    }

    .sitm-input-group .input-group-text {
        background: #fff;
        border-right: 0;
    }

    .sitm-input-group .form-control {
        border-left: 0;
    }

    .sitm-chip {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .875rem;
        color: var(--sitm-muted);
        background: #fff;
        border: 1px solid var(--sitm-border);
        border-radius: 999px;
        padding: .35rem .75rem;
    }

    .sitm-card {
        border: 1px solid var(--sitm-border);
        border-radius: var(--sitm-radius);
        box-shadow: var(--sitm-shadow);
        overflow: hidden;
        background: #fff;
    }

    .sitm-list-item {
        border-bottom: 1px solid var(--sitm-border);
        padding: 1rem 1rem;
        transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease;
    }

        .sitm-list-item:hover {
            background: rgba(15,61,46,.02);
        }

        .sitm-list-item:last-child {
            border-bottom: 0;
        }

    .sitm-name {
        font-weight: 700;
        margin: 0;
        color: #0b2f23;
    }

    .sitm-meta {
        color: var(--sitm-muted);
        font-size: .9rem;
        margin-top: .2rem;
    }

    /* Status badges - suaves */
    .sitm-status {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .35rem .6rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: .85rem;
        border: 1px solid transparent;
        user-select: none;
        white-space: nowrap;
    }

    .status-confirmada {
        background: rgba(22,163,74,.10);
        color: #166534;
        border-color: rgba(22,163,74,.22);
    }

    .status-pendiente {
        background: rgba(245,158,11,.12);
        color: #92400e;
        border-color: rgba(245,158,11,.24);
    }

    .status-cancelada {
        background: rgba(239,68,68,.12);
        color: #991b1b;
        border-color: rgba(239,68,68,.22);
    }

    .status-finalizada {
        background: rgba(59,130,246,.10);
        color: #1e3a8a;
        border-color: rgba(59,130,246,.22);
    }

    .status-neutro {
        background: rgba(107,114,128,.10);
        color: #374151;
        border-color: rgba(107,114,128,.22);
    }

    .sitm-kpi {
        border: 1px dashed rgba(21,90,67,.28);
        background: rgba(238,246,241,.55);
        border-radius: 12px;
        padding: .75rem .9rem;
    }

        .sitm-kpi .val {
            font-weight: 800;
            color: var(--sitm-green-900);
            line-height: 1;
        }

        .sitm-kpi .lbl {
            color: var(--sitm-muted);
            font-size: .85rem;
            margin-top: .2rem;
        }

    .btn-sitm {
        border-radius: 10px;
        font-weight: 600;
    }

    .btn-sitm-outline {
        border-color: rgba(15,61,46,.35);
        color: var(--sitm-green-900);
    }

        .btn-sitm-outline:hover {
            background: rgba(15,61,46,.06);
            border-color: rgba(15,61,46,.45);
            color: var(--sitm-green-900);
        }

    .btn-cancel {
        border-radius: 10px;
        font-weight: 700;
    }

    .sitm-empty {
        border: 1px dashed rgba(107,114,128,.35);
        border-radius: var(--sitm-radius);
        background: rgba(249,250,251,.8);
        padding: 2rem 1.25rem;
        text-align: center;
    }

        .sitm-empty i {
            font-size: 2rem;
            color: rgba(15,61,46,.55);
        }

        .sitm-empty h5 {
            margin-top: .75rem;
            font-weight: 800;
            color: var(--sitm-green-900);
        }

        .sitm-empty p {
            color: var(--sitm-muted);
            margin-bottom: 1rem;
        }

    /* Responsive: acciones apilan bien */
    @@media (max-width: 576px) {
        .sitm-actions {
            width: 100%;
        }

            .sitm-actions .btn {
                width: 100%;
            }
    }
    .sitm-meta {
        font-size: .9rem;
        color: #6b7280;
    }

    .meta-label {
        font-weight: 600;
        color: #4b5563;
    }

    .meta-value {
        color: #1f2937;
        font-weight: 500;
    }

    .meta-separator {
        width: 1px;
        height: 16px;
        background: #e5e7eb;
    }
</style>

<div class="container my-4 my-lg-5 sitm-page">

    <!-- HERO / HEADER -->
    <div class="sitm-hero mb-3 mb-lg-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div>
                <h2 class="title">Mis Reservas</h2>
                <p class="subtitle mb-0">Consultá el estado de tus reservas y administrá tus planes turísticos.</p>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="sitm-chip">
                    <i class="bi bi-shield-check"></i>
                    Portal SITM
                </span>
                <span class="sitm-chip">
                    <i class="bi bi-clock-history"></i>
                    Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>
        </div>
    </div>

    <!-- TOOLBAR: filtros / búsqueda -->
    <div class="sitm-toolbar p-3 p-lg-4 mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-5">
                <label class="form-label fw-semibold">Buscar</label>
                <div class="input-group sitm-input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input id="txtBuscar" type="text" class="form-control"
                           placeholder="Comercio, evento, plan o tipo..." autocomplete="off" />
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <label class="form-label fw-semibold">Estado</label>
                <select id="selEstado" class="form-select">
                    <option value="">Todos</option>
                    <option value="Confirmada">Confirmada</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Cancelada">Cancelada</option>
                    <option value="Finalizada">Finalizada</option>
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label fw-semibold">Tipo</label>
                <select id="selTipo" class="form-select">
                    <option value="">Todos</option>
                    <option value="Hotel">Hotel</option>
                    <option value="Restaurante">Restaurante</option>
                    <option value="Tour">Tour</option>
                    <option value="Evento">Evento</option>
                </select>
            </div>

            <div class="col-12 col-lg-2 d-grid">
                <button id="btnLimpiar" type="button" class="btn btn-light btn-sitm">
                    <i class="bi bi-eraser me-1"></i> Limpiar
                </button>
            </div>

            <div class="col-12">
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                    <div class="d-flex gap-2 flex-wrap">
                        <div class="sitm-kpi">
                            <div id="kpiTotal" class="val">@reservas.Length</div>
                            <div class="lbl">Reservas totales</div>
                        </div>
                        <div class="sitm-kpi">
                            <div id="kpiMostrando" class="val">@reservas.Length</div>
                            <div class="lbl">Mostrando</div>
                        </div>
                    </div>

                    <div class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        Podés cancelar solo reservas <span class="fw-semibold">Pendientes</span> o <span class="fw-semibold">Confirmadas</span> (según política).
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LISTA -->
    <div class="sitm-card" id="listaReservas">

        @if (reservas == null || reservas.Length == 0)
        {
            <div class="sitm-empty m-3">
                <i class="bi bi-calendar-x"></i>
                <h5>No tenés reservas todavía</h5>
                <p>Cuando realicés una reserva, la vas a ver reflejada aquí con su estado y opciones disponibles.</p>
                <a href="@Url.Action("Index","Home")" class="btn btn-sitm btn-sitm-outline">
                    <i class="bi bi-compass me-1"></i> Explorar destinos
                </a>
            </div>
        }
        else
        {
            foreach (dynamic r in reservas)
            {
                var rango = (r.FechaFin != null)
                    ? $"{fmt((DateTime)r.FechaInicio)} – {fmt((DateTime)r.FechaFin)}"
                    : fmt((DateTime)r.FechaInicio);

                <div class="sitm-list-item"
                     data-id="@r.Id"
                     data-titulo="@r.Titulo"
                     data-tipo="@r.Tipo"
                     data-plan="@r.Plan"
                     data-estado="@r.Estado">
                    <div class="row g-3 align-items-center">
                        <!-- Info principal -->
                        <div class="col-12 col-lg-6">
                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-3 d-inline-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;background:rgba(15,61,46,.08);border:1px solid rgba(15,61,46,.12);">
                                    <i class="bi bi-bookmark-star" style="color:var(--sitm-green-900);font-size:1.2rem;"></i>
                                </div>

                                <div class="min-w-0">
                                    <p class="sitm-name mb-0 text-truncate">@r.Titulo</p>
                                    <div class="sitm-meta d-flex flex-wrap align-items-center gap-3 mt-1">

                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-tag text-muted"></i>
                                            <span class="meta-label">Tipo:</span>
                                            <span class="meta-value">@r.Tipo</span>
                                        </div>

                                        <div class="meta-separator"></div>

                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-people text-muted"></i>
                                            <span class="meta-label">Personas:</span>
                                            <span class="meta-value">@r.Personas</span>
                                        </div>

                                        <div class="meta-separator"></div>

                                        <div class="d-flex align-items-center gap-1 text-truncate" style="max-width: 350px;">
                                            <i class="bi bi-bag-check text-muted"></i>
                                            <span class="meta-label">Plan:</span>
                                            <span class="meta-value text-truncate">@r.Plan</span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fechas -->
                        <div class="col-12 col-lg-3">
                            <div class="text-muted small mb-1">Fecha</div>
                            <div class="fw-semibold">
                                <i class="bi bi-calendar-event me-1"></i>@rango
                            </div>
                        </div>

                        <!-- Estado -->
                        <div class="col-12 col-lg-3">
                            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-sm-between gap-2">
                                <div>
                                    <div class="text-muted small mb-1">Estado</div>
                                    <span class="sitm-status @estadoClass((string)r.Estado)">
                                        <i class="bi @estadoIcon((string)r.Estado)"></i> @r.Estado
                                    </span>
                                </div>

                                <!-- Acciones -->
                                <div class="sitm-actions d-flex gap-2 justify-content-sm-end">
                                    <a class="btn btn-sm btn-sitm btn-sitm-outline"
                                       href="@Url.Action("DetalleReserva", "Reservas", new { id = (int)r.Id })">
                                        <i class="bi bi-eye me-1"></i> Detalle
                                    </a>

                                    @if ((bool)r.PuedeCancelar)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-cancel js-cancelar"
                                                data-id="@r.Id"
                                                data-titulo="@r.Titulo">
                                            <i class="bi bi-x-octagon me-1"></i> Cancelar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-secondary" disabled>
                                            <i class="bi bi-slash-circle me-1"></i> No disponible
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
    </div>

    <!-- EMPTY RESULT (por filtros) -->
    <div id="emptyFiltrado" class="sitm-empty mt-3 d-none">
        <i class="bi bi-funnel"></i>
        <h5>Sin resultados</h5>
        <p>No hay reservas que coincidan con tu búsqueda o filtros actuales.</p>
        <button type="button" id="btnResetDesdeEmpty" class="btn btn-sitm btn-sitm-outline">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Restablecer filtros
        </button>
    </div>

</div>

<!-- MODAL CONFIRMAR CANCELACIÓN -->
<div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="modalCancelarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--sitm-radius);">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalCancelarLabel">
                    Confirmar cancelación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Vas a cancelar la reserva de:</p>
                <div class="p-3 rounded-3" style="background: rgba(239,68,68,.06); border: 1px solid rgba(239,68,68,.15);">
                    <div class="fw-bold" id="cancelTitulo">—</div>
                    <div class="text-muted small">Esta acción puede ser irreversible según políticas del comercio.</div>
                </div>

                <div class="alert alert-light border mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Si el sistema requiere validación, el estado puede pasar a <span class="fw-semibold">Cancelada</span> tras confirmación.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-sitm" data-bs-dismiss="modal">
                    Volver
                </button>

                @* PREPARADO PARA MVC POST REAL *@
                @*
                    Cuando tengas el endpoint real, usá un form POST:
                    @using (Html.BeginForm("CancelarReserva", "Reservas", FormMethod.Post, new { id="frmCancelar" })) {
                       @Html.AntiForgeryToken()
                       <input type="hidden" name="id" id="cancelId" />
                       <button type="submit" class="btn btn-danger btn-sitm">Confirmar cancelación</button>
                    }
                *@

                <button type="button" id="btnConfirmarCancelar" class="btn btn-danger btn-sitm">
                    <i class="bi bi-trash3 me-1"></i> Confirmar cancelación
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // Elementos
        const txtBuscar = document.getElementById('txtBuscar');
        const selEstado = document.getElementById('selEstado');
        const selTipo = document.getElementById('selTipo');
        const btnLimpiar = document.getElementById('btnLimpiar');

        const kpiTotal = document.getElementById('kpiTotal');
        const kpiMostrando = document.getElementById('kpiMostrando');

        const lista = document.getElementById('listaReservas');
        const items = Array.from(lista.querySelectorAll('.sitm-list-item'));
        const emptyFiltrado = document.getElementById('emptyFiltrado');
        const btnResetDesdeEmpty = document.getElementById('btnResetDesdeEmpty');

        // Modal cancelar (Bootstrap 5)
        const modalEl = document.getElementById('modalCancelar');
        const modal = modalEl ? new bootstrap.Modal(modalEl) : null;

        const cancelTitulo = document.getElementById('cancelTitulo');
        const btnConfirmarCancelar = document.getElementById('btnConfirmarCancelar');

        let cancelIdActual = null;

        // Helpers
        function normalizar(s) {
            return (s || '').toString().toLowerCase().trim();
        }

        function aplicarFiltros() {
            const q = normalizar(txtBuscar.value);
            const estado = (selEstado.value || '').trim();
            const tipo = (selTipo.value || '').trim();

            let visibles = 0;

            items.forEach(it => {
                const t = normalizar(it.dataset.titulo);
                const tp = normalizar(it.dataset.tipo);
                const pl = normalizar(it.dataset.plan);
                const st = (it.dataset.estado || '').trim();

                const matchTexto = !q || (t.includes(q) || tp.includes(q) || pl.includes(q));
                const matchEstado = !estado || st === estado;
                const matchTipo = !tipo || it.dataset.tipo === tipo;

                const show = matchTexto && matchEstado && matchTipo;

                it.classList.toggle('d-none', !show);
                if (show) visibles++;
            });

            kpiTotal.textContent = items.length.toString();
            kpiMostrando.textContent = visibles.toString();

            const hay = visibles > 0;
            emptyFiltrado.classList.toggle('d-none', hay);
        }

        function limpiarFiltros() {
            txtBuscar.value = '';
            selEstado.value = '';
            selTipo.value = '';
            aplicarFiltros();
            txtBuscar.focus();
        }

        // Eventos filtros
        if (txtBuscar) txtBuscar.addEventListener('input', aplicarFiltros);
        if (selEstado) selEstado.addEventListener('change', aplicarFiltros);
        if (selTipo) selTipo.addEventListener('change', aplicarFiltros);
        if (btnLimpiar) btnLimpiar.addEventListener('click', limpiarFiltros);
        if (btnResetDesdeEmpty) btnResetDesdeEmpty.addEventListener('click', limpiarFiltros);

        // Delegación: abrir modal cancelar
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.js-cancelar');
            if (!btn) return;

            cancelIdActual = btn.getAttribute('data-id');
            const titulo = btn.getAttribute('data-titulo') || 'Reserva';

            if (cancelTitulo) cancelTitulo.textContent = titulo;

            if (modal) modal.show();
        });

        // Confirmar cancelación (MOCK)
        if (btnConfirmarCancelar) {
            btnConfirmarCancelar.addEventListener('click', function () {
                if (!cancelIdActual) return;

                // Aquí se conectaría al POST real (fetch o submit de form).
                // Por ahora: simulación UI -> marcar como cancelada y deshabilitar botón.
                const target = items.find(x => x.dataset.id === cancelIdActual);
                if (target) {
                    // Update badge
                    target.dataset.estado = 'Cancelada';

                    const badge = target.querySelector('.sitm-status');
                    if (badge) {
                        badge.className = 'sitm-status status-cancelada';
                        badge.innerHTML = '<i class="bi bi-x-circle"></i> Cancelada';
                    }

                    // Replace actions
                    const btnCancelar = target.querySelector('.js-cancelar');
                    if (btnCancelar) {
                        const parent = btnCancelar.parentElement;
                        btnCancelar.remove();

                        const disabled = document.createElement('button');
                        disabled.type = 'button';
                        disabled.className = 'btn btn-sm btn-secondary';
                        disabled.disabled = true;
                        disabled.innerHTML = '<i class="bi bi-slash-circle me-1"></i> No disponible';
                        parent.appendChild(disabled);
                    }
                }

                cancelIdActual = null;
                if (modal) modal.hide();
                aplicarFiltros();
            });
        }

        // Inicial
        aplicarFiltros();
    })();
</script>
