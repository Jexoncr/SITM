@model IEnumerable<turistico.Controllers.ReservaUsuarioVM>
@using System
@using System.Linq

@{
    ViewBag.Title = "Mis Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var reservas = Model ?? new List<turistico.Controllers.ReservaUsuarioVM>();

    Func<string, string> estadoClass = (estado) =>
    {
        switch ((estado ?? "").Trim().ToLowerInvariant())
        {
            case "confirmada": return "status-confirmada";
            case "pendiente": return "status-pendiente";
            case "cancelada": return "status-cancelada";
            case "finalizada": return "status-finalizada";
            default: return "status-neutro";
        }
    };

    Func<string, string> estadoIcon = (estado) =>
    {
        switch ((estado ?? "").Trim().ToLowerInvariant())
        {
            case "confirmada": return "bi-check-circle-fill";
            case "pendiente": return "bi-hourglass-split";
            case "cancelada": return "bi-x-circle-fill";
            case "finalizada": return "bi-flag-fill";
            default: return "bi-info-circle-fill";
        }
    };

    Func<string, string> tipoIcon = (tipo) =>
    {
        switch ((tipo ?? "").Trim().ToLowerInvariant())
        {
            case "evento": return "bi-calendar-event";
            case "hotel": return "bi-building";
            case "restaurante": return "bi-cup-hot";
            case "tour": return "bi-compass";
            default: return "bi-bookmark-star";
        }
    };

    Func<DateTime, string> fmt = (d) => d.ToString("dd/MM/yyyy");
    var total = reservas.Count();
    var confirmadas = reservas.Count(x => (x.Estado ?? "").Equals("Confirmada", StringComparison.OrdinalIgnoreCase));
    var pendientes = reservas.Count(x => (x.Estado ?? "").Equals("Pendiente", StringComparison.OrdinalIgnoreCase));
}

<style>
    :root {
        --sitm-green-900: #0f3d2e;
        --sitm-green-700: #155a43;
        --sitm-green-50: #eef6f1;
        --sitm-text: #1f2937;
        --sitm-muted: #6b7280;
        --sitm-border: #e5e7eb;
        --sitm-shadow: 0 10px 28px rgba(17, 24, 39, .08);
        --sitm-radius: 18px;
    }

    .sitm-page {
        color: var(--sitm-text);
    }

    .sitm-hero {
        background: radial-gradient(circle at top right, rgba(21, 90, 67, .10), transparent 30%), linear-gradient(135deg, rgba(15,61,46,.10), rgba(21,90,67,.05));
        border: 1px solid rgba(21,90,67,.10);
        border-radius: 24px;
        padding: 1.5rem;
        box-shadow: 0 14px 34px rgba(15, 61, 46, .07);
    }

    .sitm-title {
        font-weight: 900;
        color: var(--sitm-green-900);
        margin: 0;
        letter-spacing: .2px;
    }

    .sitm-subtitle {
        color: var(--sitm-muted);
        margin: .35rem 0 0;
        font-size: 1rem;
    }

    .sitm-badge-soft {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: rgba(255,255,255,.8);
        border: 1px solid rgba(15,61,46,.10);
        color: var(--sitm-green-900);
        padding: .5rem .8rem;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 700;
    }

    .sitm-kpis {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.25rem;
    }

    .sitm-kpi {
        background: #fff;
        border: 1px solid var(--sitm-border);
        border-radius: 18px;
        padding: 1rem 1.1rem;
        box-shadow: 0 8px 22px rgba(17,24,39,.05);
    }

        .sitm-kpi .label {
            color: var(--sitm-muted);
            font-size: .88rem;
            margin-bottom: .3rem;
        }

        .sitm-kpi .value {
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--sitm-green-900);
            line-height: 1;
        }

    .sitm-card {
        border: 1px solid var(--sitm-border);
        border-radius: 22px;
        box-shadow: var(--sitm-shadow);
        background: #fff;
        overflow: hidden;
    }

    .sitm-card-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--sitm-border);
        background: linear-gradient(180deg, rgba(248,250,252,.9), rgba(255,255,255,1));
    }

        .sitm-card-header h4 {
            margin: 0;
            font-weight: 800;
            color: var(--sitm-green-900);
        }

        .sitm-card-header p {
            margin: .2rem 0 0;
            color: var(--sitm-muted);
            font-size: .92rem;
        }

    .sitm-reserva {
        padding: 1.15rem 1.25rem;
        border-bottom: 1px solid var(--sitm-border);
        transition: all .18s ease;
    }

        .sitm-reserva:last-child {
            border-bottom: none;
        }

        .sitm-reserva:hover {
            background: rgba(15,61,46,.02);
        }

    .sitm-reserva-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(15,61,46,.08);
        color: var(--sitm-green-900);
        border: 1px solid rgba(15,61,46,.10);
        font-size: 1.2rem;
        flex: 0 0 auto;
    }

    .sitm-name {
        font-weight: 800;
        margin: 0;
        color: #0b2f23;
    }

    .sitm-meta {
        color: var(--sitm-muted);
        font-size: .92rem;
        margin-top: .25rem;
    }

        .sitm-meta strong {
            color: #374151;
        }

    .sitm-status {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .45rem .75rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: .85rem;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .status-confirmada {
        background: rgba(22,163,74,.10);
        color: #166534;
        border-color: rgba(22,163,74,.20);
    }

    .status-pendiente {
        background: rgba(245,158,11,.12);
        color: #92400e;
        border-color: rgba(245,158,11,.24);
    }

    .status-cancelada {
        background: rgba(239,68,68,.12);
        color: #991b1b;
        border-color: rgba(239,68,68,.22);
    }

    .status-finalizada {
        background: rgba(59,130,246,.10);
        color: #1e3a8a;
        border-color: rgba(59,130,246,.22);
    }

    .status-neutro {
        background: rgba(107,114,128,.10);
        color: #374151;
        border-color: rgba(107,114,128,.22);
    }

    .sitm-date-box {
        background: #fafafa;
        border: 1px solid var(--sitm-border);
        border-radius: 14px;
        padding: .85rem 1rem;
    }

        .sitm-date-box .small-label {
            color: var(--sitm-muted);
            font-size: .8rem;
            margin-bottom: .2rem;
        }

        .sitm-date-box .date-value {
            font-weight: 700;
            color: #111827;
        }

    .btn-sitm {
        border-radius: 12px;
        font-weight: 700;
        padding: .55rem .9rem;
    }

    .btn-sitm-outline {
        border-color: rgba(15,61,46,.25);
        color: var(--sitm-green-900);
        background: #fff;
    }

        .btn-sitm-outline:hover {
            background: rgba(15,61,46,.05);
            border-color: rgba(15,61,46,.35);
            color: var(--sitm-green-900);
        }

    .sitm-empty {
        text-align: center;
        padding: 3rem 1.5rem;
        background: linear-gradient(180deg, rgba(249,250,251,.7), rgba(255,255,255,1));
    }

    .sitm-empty-icon {
        width: 76px;
        height: 76px;
        border-radius: 22px;
        margin: 0 auto 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(15,61,46,.08);
        color: var(--sitm-green-900);
        font-size: 2rem;
    }

    .sitm-empty h4 {
        font-weight: 900;
        color: var(--sitm-green-900);
    }

    .sitm-empty p {
        color: var(--sitm-muted);
        max-width: 520px;
        margin: .5rem auto 1.25rem;
    }

    @@media (max-width: 991.98px) {
        .sitm-kpis {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container my-4 my-lg-5 sitm-page">
    @Html.Partial("_Alerts")

    <div class="sitm-hero mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div>
                <h2 class="sitm-title">Mis Reservas</h2>
                <p class="sitm-subtitle">Consulta tus reservas activas, revisa su estado y administra tus planes turísticos.</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <span class="sitm-badge-soft">
                    <i class="bi bi-shield-check"></i>
                    Portal SITM
                </span>
                <span class="sitm-badge-soft">
                    <i class="bi bi-calendar2-check"></i>
                    Historial del usuario
                </span>
            </div>
        </div>

        <div class="sitm-kpis">
            <div class="sitm-kpi">
                <div class="label">Reservas totales</div>
                <div class="value">@total</div>
            </div>
            <div class="sitm-kpi">
                <div class="label">Confirmadas</div>
                <div class="value">@confirmadas</div>
            </div>
            <div class="sitm-kpi">
                <div class="label">Pendientes</div>
                <div class="value">@pendientes</div>
            </div>
        </div>
    </div>

    <div class="sitm-card">
        <div class="sitm-card-header">
            <h4>Listado de reservas</h4>
            <p>Aquí puedes ver cada reserva con su fecha, tipo, cantidad de personas y estado actual.</p>
        </div>

        @if (!reservas.Any())
        {
            <div class="sitm-empty">
                <div class="sitm-empty-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h4>No tienes reservas todavía</h4>
                <p>Cuando realices una reserva de evento o actividad turística, aparecerá aquí con toda su información y estado.</p>
                <a href="@Url.Action("Index", "Eventos")" class="btn btn-success btn-sitm px-4">
                    <i class="bi bi-compass me-1"></i> Explorar eventos
                </a>
            </div>
        }
        else
        {
            foreach (var r in reservas)
            {
                var rango = r.FechaFin.HasValue
                    ? $"{fmt(r.FechaInicio)} – {fmt(r.FechaFin.Value)}"
                    : fmt(r.FechaInicio);

                <div class="sitm-reserva">
                    <div class="row g-3 align-items-center">
                        <div class="col-12 col-xl-5">
                            <div class="d-flex align-items-start gap-3">
                                <div class="sitm-reserva-icon">
                                    <i class="bi @tipoIcon(r.Tipo)"></i>
                                </div>

                                <div>
                                    <p class="sitm-name">@r.Titulo</p>
                                    <div class="sitm-meta">
                                        <strong>Tipo:</strong> @r.Tipo
                                        · <strong>Personas:</strong> @r.Personas
                                        · <strong>Plan:</strong> @r.Plan
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="sitm-date-box">
                                <div class="small-label">Fecha de la reserva</div>
                                <div class="date-value">
                                    <i class="bi bi-calendar-event me-1"></i>@rango
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-2">
                            <span class="sitm-status @estadoClass(r.Estado)">
                                <i class="bi @estadoIcon(r.Estado)"></i> @r.Estado
                            </span>
                        </div>

                        <div class="col-12 col-xl-2">
                            <div class="d-flex flex-wrap gap-2 justify-content-xl-end">
                                <a href="@Url.Action("DetalleReserva", "Reservas", new { id = r.Id })"
                                   class="btn btn-sm btn-sitm btn-sitm-outline">
                                    <i class="bi bi-eye me-1"></i> Detalle
                                </a>

                                @if (r.PuedeCancelar)
                                {
                                    using (Html.BeginForm("CancelarReserva", "Reservas", FormMethod.Post, new { style = "display:inline-block" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger btn-sitm">
                                            <i class="bi bi-x-octagon me-1"></i> Cancelar
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>