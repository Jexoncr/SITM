@model IEnumerable<turistico.Models.ComercioDTO>


@{
    ViewBag.Title = "Comercios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container">

    <h2 class="fw-bold text-success mb-3">Comercios y Servicios Registrados</h2>
    <p class="text-muted mb-5 fs-5">
        Listado de comercios locales registrados y regulados por la municipalidad.
    </p>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3">

            @foreach (var comercio in Model)
            {
                
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@comercio.ImagenUrl"
                             class="card-img-top"
                             style="height:160px; object-fit:cover;"
                             alt="@comercio.Nombre"
                             onerror="this.src='@Url.Content("~/Content/img/comercios/default.jpg")'">

                        <div class="card-body d-flex flex-column">
                            <h4 class="fw-bold text-success">@comercio.Nombre</h4>
                            <p class="fs-6">
                                @comercio.Descripcion
                                <p>Aprovado por la Municipalidad. <p>
                            </p>
                            <ul class="list-unstyled fs-6">
                                <li>
                                    @switch (comercio.Categoria)
                                    {
                                        case "Restaurante":
                                            @:🍽️
                                            break;
                                        case "Hotel":
                                            @:🏨
                                            break;
                                        case "Termales":
                                            @:♨️
                                            break;
                                        default:
                                            @:🏢
                                            break;
                                    }
                                    Categoría: @comercio.Categoria
                                </li>
                                <li>📍 @comercio.Ubicacion</li>
                                @if (!string.IsNullOrEmpty(comercio.Telefono))
                                {
                                    <li>📞 @comercio.Telefono</li>
                                }
                                @if (!string.IsNullOrEmpty(comercio.Horario))
                                {
                                    <li>🕐 @comercio.Horario</li>
                                }
                            </ul>

                            <div class="mt-auto d-flex gap-2">
                                <a href="@Url.Action("Perfil", "Comercios", new { id = comercio.Id })"
                                   class="btn btn-outline-success">Ver perfil</a>

                                @* Lógica dinámica de WhatsApp basada en tu Excel *@
                                @if (!string.IsNullOrEmpty(comercio.LinkWhatsApp))
                                {
                                    <a href="@comercio.LinkWhatsApp"
                                       target="_blank"
                                       class="btn btn-success">
                                        <i class="fab fa-whatsapp"></i> Contactar
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled title="WhatsApp no disponible">
                                        Sin WhatsApp
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No hay comercios disponibles</h4>
            <p>Actualmente no hay comercios registrados en el sistema.</p>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('.card-img-top');
            images.forEach(img => {
                img.addEventListener('error', function() {
                    this.src = '@Url.Content("~/Content/img/comercios/default.jpg")';
                });
            });
        });
    </script>
}