@model turistico.Models.ApplicationUser

@{
    ViewBag.Title = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --pf-green-900: #0f3d2e;
        --pf-green-800: #145544;
        --pf-green-700: #1b6b55;
        --pf-green-soft: rgba(20,85,68,.08);
        --pf-ink: #0f172a;
        --pf-muted: #64748b;
        --pf-border: rgba(15,23,42,.08);
        --pf-card: rgba(255,255,255,.96);
        --pf-shadow: 0 20px 48px rgba(15,23,42,.07);
        --pf-shadow-soft: 0 10px 24px rgba(15,23,42,.05);
        --pf-radius-xl: 30px;
        --pf-radius-lg: 22px;
        --pf-radius-md: 16px;
    }

    .profile-page {
        background: radial-gradient(circle at top left, rgba(20,85,68,.07), transparent 30%), radial-gradient(circle at top right, rgba(46,158,127,.08), transparent 24%), linear-gradient(180deg, #fbfdfc 0%, #f4f8f6 50%, #eef4f1 100%);
        min-height: 100%;
    }

    .profile-shell {
        max-width: 1360px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
    }

    .profile-hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--pf-radius-xl);
        padding: 2rem 1.4rem 1.7rem;
        margin-bottom: 1.15rem;
        background: radial-gradient(circle at top right, rgba(46,158,127,.12), transparent 30%), linear-gradient(135deg, #ffffff 0%, #f7fbf8 55%, #eef7f2 100%);
        border: 1px solid rgba(15,23,42,.06);
        box-shadow: 0 20px 46px rgba(15,23,42,.06);
    }

        .profile-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(20,85,68,.04), transparent 24%);
            pointer-events: none;
        }

    .profile-hero-inner {
        position: relative;
        z-index: 2;
    }

    .profile-badge {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .54rem .86rem;
        border-radius: 999px;
        background: rgba(20,85,68,.08);
        color: var(--pf-green-800);
        border: 1px solid rgba(20,85,68,.10);
        font-weight: 800;
        font-size: .8rem;
        margin-bottom: .85rem;
    }

    .profile-hero h1 {
        margin: 0 0 .5rem;
        font-weight: 950;
        letter-spacing: -.03em;
        color: var(--pf-ink);
        line-height: 1.02;
        font-size: clamp(2rem, 3vw, 3rem);
    }

    .profile-hero p {
        margin: 0;
        max-width: 860px;
        color: var(--pf-muted);
        line-height: 1.85;
        font-size: .96rem;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 1rem;
        align-items: start;
    }

    @@media (max-width: 991.98px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    .profile-panel {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: var(--pf-radius-lg);
        background: var(--pf-card);
        box-shadow: var(--pf-shadow);
        overflow: hidden;
    }

    .profile-panel-head {
        padding: 1rem 1rem .95rem;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.96));
    }

    .profile-panel-title {
        margin: 0;
        color: var(--pf-ink);
        font-weight: 950;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

    .profile-panel-sub {
        color: var(--pf-muted);
        font-size: .84rem;
        margin-top: .25rem;
        line-height: 1.6;
    }

    .profile-panel-body {
        padding: 1rem;
    }

    .profile-field {
        margin-bottom: 1rem;
    }

        .profile-field:last-child {
            margin-bottom: 0;
        }

    .profile-label {
        font-weight: 900;
        color: var(--pf-ink);
        margin-bottom: .45rem;
        font-size: .83rem;
        display: block;
    }

    .profile-input,
    .profile-select {
        border-radius: 16px;
        min-height: 50px;
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: none !important;
        font-size: .92rem;
        background: #fff;
    }

        .profile-input:focus,
        .profile-select:focus {
            border-color: #1f8a6c;
            box-shadow: 0 0 0 .2rem rgba(31,138,108,.12) !important;
        }

    .profile-readonly {
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%) !important;
        color: #475569;
    }

    .profile-stack {
        display: grid;
        gap: 1rem;
    }

    .profile-box {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 20px;
        padding: 1rem;
        background: linear-gradient(180deg, rgba(248,250,252,.78), rgba(255,255,255,1));
        box-shadow: var(--pf-shadow-soft);
    }

    .profile-box-title {
        font-weight: 900;
        color: var(--pf-ink);
        margin-bottom: .25rem;
        font-size: .95rem;
    }

    .profile-box-sub {
        color: var(--pf-muted);
        font-size: .82rem;
        margin-bottom: .9rem;
        line-height: 1.6;
    }

    .pref-grid {
        display: grid;
        gap: .75rem;
    }

    .pref-item {
        display: flex;
        align-items: center;
        gap: .75rem;
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 16px;
        padding: .78rem .82rem;
        background: #fff;
        transition: all .18s ease;
    }

        .pref-item:hover {
            border-color: rgba(20,85,68,.14);
            background: rgba(20,85,68,.025);
        }

    .profile-check {
        border-radius: 7px;
        box-shadow: none !important;
        width: 1.05rem;
        height: 1.05rem;
        margin-top: 0;
        flex: 0 0 auto;
    }

        .profile-check:checked {
            background-color: #145544;
            border-color: #145544;
        }

    .pref-text {
        line-height: 1.4;
    }

    .pref-title {
        color: var(--pf-ink);
        font-weight: 850;
        font-size: .9rem;
    }

    .pref-sub {
        color: var(--pf-muted);
        font-size: .78rem;
        margin-top: .1rem;
    }

    .profile-actions {
        margin-top: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: .7rem;
    }

    .save-btn {
        min-height: 52px;
        border-radius: 999px;
        font-weight: 850;
        padding: .9rem 1.3rem;
    }

    .profile-summary {
        display: grid;
        gap: .85rem;
    }

    .summary-item {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 18px;
        padding: .9rem 1rem;
        background: #fff;
        box-shadow: var(--pf-shadow-soft);
    }

    .summary-label {
        color: var(--pf-muted);
        font-size: .76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .15rem;
    }

    .summary-value {
        color: var(--pf-ink);
        font-weight: 900;
        line-height: 1.45;
        font-size: .95rem;
    }
</style>

<div class="profile-page">
    <div class="profile-shell">
        @Html.Partial("_Alerts")

        <section class="profile-hero">
            <div class="profile-hero-inner">
                <span class="profile-badge">
                    <i class="bi bi-person-circle"></i> Perfil personal
                </span>

                <h1>Mi perfil</h1>
                <p>
                    Actualiza tu información personal, tus datos de contacto y tus preferencias turísticas desde una vista más clara, elegante y ordenada.
                </p>
            </div>
        </section>

        @using (Html.BeginForm("Perfil", "Home", FormMethod.Post, new { autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()

            <div class="profile-grid">
                <div class="profile-panel">
                    <div class="profile-panel-head">
                        <h2 class="profile-panel-title">
                            <i class="bi bi-pencil-square"></i> Información personal
                        </h2>
                        <div class="profile-panel-sub">
                            Completa o actualiza tus datos básicos dentro del sistema.
                        </div>
                    </div>

                    <div class="profile-panel-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="profile-field">
                                    <label class="profile-label">Nombre</label>
                                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control profile-input", placeholder = "Tu nombre" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="profile-field">
                                    <label class="profile-label">Apellido</label>
                                    @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control profile-input", placeholder = "Tu apellido" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="profile-field">
                                    <label class="profile-label">Correo electrónico</label>
                                    <input type="text" class="form-control profile-input profile-readonly" value="@Model.Email" disabled />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="profile-field">
                                    <label class="profile-label">Teléfono</label>
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control profile-input", placeholder = "Tu teléfono" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="profile-field">
                                    <label class="profile-label">Cantón</label>
                                    @Html.TextBoxFor(m => m.Canton, new { @class = "form-control profile-input", placeholder = "Cantón" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="profile-field">
                                    <label class="profile-label">Idioma</label>
                                    @Html.TextBoxFor(m => m.Idioma, new { @class = "form-control profile-input", placeholder = "Idioma preferido" })
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="profile-field">
                                    <label class="profile-label">Tipo de notificación</label>
                                    @Html.TextBoxFor(m => m.TipoNotificacion, new { @class = "form-control profile-input", placeholder = "Correo, push, ambos..." })
                                </div>
                            </div>
                        </div>

                        <div class="profile-actions">
                            <button type="submit" class="btn btn-success save-btn">
                                <i class="bi bi-check2-circle me-1"></i> Guardar cambios
                            </button>
                        </div>
                    </div>
                </div>

                <div class="profile-stack">
                    <div class="profile-panel">
                        <div class="profile-panel-head">
                            <h2 class="profile-panel-title">
                                <i class="bi bi-stars"></i> Preferencias turísticas
                            </h2>
                            <div class="profile-panel-sub">
                                Personaliza el tipo de contenido que más te interesa.
                            </div>
                        </div>

                        <div class="profile-panel-body">
                            <div class="pref-grid">
                                <label class="pref-item">
                                    @Html.CheckBoxFor(m => m.PrefEventos, new { @class = "form-check-input profile-check" })
                                    <div class="pref-text">
                                        <div class="pref-title">Interés en eventos</div>
                                        <div class="pref-sub">Actividades, festivales y agenda municipal.</div>
                                    </div>
                                </label>

                                <label class="pref-item">
                                    @Html.CheckBoxFor(m => m.PrefEcologico, new { @class = "form-check-input profile-check" })
                                    <div class="pref-text">
                                        <div class="pref-title">Turismo ecológico</div>
                                        <div class="pref-sub">Naturaleza, senderos y experiencias sostenibles.</div>
                                    </div>
                                </label>

                                <label class="pref-item">
                                    @Html.CheckBoxFor(m => m.PrefGastronomia, new { @class = "form-check-input profile-check" })
                                    <div class="pref-text">
                                        <div class="pref-title">Gastronomía</div>
                                        <div class="pref-sub">Comida local, restaurantes y experiencias culinarias.</div>
                                    </div>
                                </label>

                                <label class="pref-item">
                                    @Html.CheckBoxFor(m => m.PrefAventura, new { @class = "form-check-input profile-check" })
                                    <div class="pref-text">
                                        <div class="pref-title">Aventura</div>
                                        <div class="pref-sub">Recorridos activos, tours y experiencias dinámicas.</div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="profile-panel">
                        <div class="profile-panel-head">
                            <h2 class="profile-panel-title">
                                <i class="bi bi-info-circle"></i> Resumen rápido
                            </h2>
                            <div class="profile-panel-sub">
                                Vista compacta de tu información actual.
                            </div>
                        </div>

                        <div class="profile-panel-body">
                            <div class="profile-summary">
                                <div class="summary-item">
                                    <div class="summary-label">Usuario</div>
                                    <div class="summary-value">@((Model.Nombre ?? "") + " " + (Model.Apellido ?? ""))</div>
                                </div>

                                <div class="summary-item">
                                    <div class="summary-label">Correo</div>
                                    <div class="summary-value">@Model.Email</div>
                                </div>

                                <div class="summary-item">
                                    <div class="summary-label">Ubicación</div>
                                    <div class="summary-value">@(string.IsNullOrWhiteSpace(Model.Canton) ? "Sin definir" : Model.Canton)</div>
                                </div>

                                <div class="summary-item">
                                    <div class="summary-label">Idioma</div>
                                    <div class="summary-value">@(string.IsNullOrWhiteSpace(Model.Idioma) ? "Sin definir" : Model.Idioma)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>