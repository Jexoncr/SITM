@model turistico.Models.ApplicationUser

@{
    ViewBag.Title = "Perfil de Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">

    <!-- TÍTULO -->
    <h2 class="fw-bold text-success mb-3">Perfil y Preferencias del Usuario</h2>
    <p class="text-muted fs-5 mb-5">
        Información personal y configuración de preferencias turísticas del usuario.
    </p>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">
            @ViewBag.Success
        </div>
    }

    @using (Html.BeginForm("Perfil", "Home", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row g-4">

            <!-- PERFIL DEL USUARIO -->
            <div class="col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="fw-bold text-success mb-3">Información del Perfil</h4>

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Nombre" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Apellido</label>
                            @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control", placeholder = "Apellido" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Teléfono</label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Teléfono" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cantón</label>
                            @Html.TextBoxFor(m => m.Canton, new { @class = "form-control", placeholder = "Cantón" })
                        </div>

                        <button type="submit" class="btn btn-outline-success">
                            Guardar perfil
                        </button>
                    </div>
                </div>
            </div>

            <!-- PREFERENCIAS -->
            <div class="col-lg-7">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="fw-bold text-success mb-3">Preferencias Turísticas</h4>

                        <!-- CATEGORÍAS -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Tipos de actividades preferidas
                            </label>

                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.PrefEventos, new { @class = "form-check-input", id = "prefEventos" })
                                <label class="form-check-label" for="prefEventos">Eventos culturales</label>
                            </div>

                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.PrefEcologico, new { @class = "form-check-input", id = "prefEco" })
                                <label class="form-check-label" for="prefEco">Turismo ecológico</label>
                            </div>

                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.PrefGastronomia, new { @class = "form-check-input", id = "prefGas" })
                                <label class="form-check-label" for="prefGas">Gastronomía local</label>
                            </div>

                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.PrefAventura, new { @class = "form-check-input", id = "prefAvent" })
                                <label class="form-check-label" for="prefAvent">Aventura y deportes</label>
                            </div>
                        </div>

                        <!-- NOTIFICACIONES -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Preferencias de notificación
                            </label>

                            @Html.DropDownListFor(
                                m => m.TipoNotificacion,
                                new SelectList(new[]
                                {
                                    new { Value = "Correo", Text = "Recibir notificaciones por correo" },
                                    new { Value = "Sistema", Text = "Recibir notificaciones dentro del sistema" },
                                    new { Value = "Ninguna", Text = "No recibir notificaciones" }
                                }, "Value", "Text", Model.TipoNotificacion),
                                new { @class = "form-select" }
                            )
                        </div>

                        <!-- IDIOMA -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Idioma preferido
                            </label>

                            @Html.DropDownListFor(
                                m => m.Idioma,
                                new SelectList(new[]
                                {
                                    new { Value = "Español", Text = "Español" },
                                    new { Value = "Inglés", Text = "Inglés" }
                                }, "Value", "Text", Model.Idioma),
                                new { @class = "form-select" }
                            )
                        </div>

                        <button type="submit" class="btn btn-success">
                            Guardar preferencias
                        </button>
                    </div>
                </div>
            </div>

        </div>
    }

</div>
