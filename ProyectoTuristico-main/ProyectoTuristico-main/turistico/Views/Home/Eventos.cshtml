@model IEnumerable<turistico.Controllers.EventoListaVM>

@{
    ViewBag.Title = "Eventos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="eventos-hero text-white d-flex align-items-center">
    <div class="container text-center">
        <h1 class="fw-bold display-5 mb-3">Eventos y Actividades Turísticas</h1>
        <p class="fs-5 opacity-90">
            Conocé y reservá cupos en los principales eventos del cantón.
        </p>
    </div>
</section>

<div class="container my-5">
    @Html.Partial("_Alerts")

    <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3">
        @if (Model != null && Model.Any())
        {
            foreach (var e in Model)
            {
                <div class="col">
                    <div class="evento-card h-100">
                        <div class="evento-body d-flex flex-column">
                            <span class="evento-tag">@e.Categoria</span>
                            <h4 class="fw-bold mt-2">@e.Nombre</h4>

                            <p>@(string.IsNullOrWhiteSpace(e.Descripcion) ? "Evento turístico disponible." : e.Descripcion)</p>

                            <ul class="list-unstyled small text-muted">
                                <li>📍 @e.LugarNombre</li>
                                <li>📅 @(e.FechaInicio.HasValue ? e.FechaInicio.Value.ToString("dd/MM/yyyy HH:mm") : "Fecha por confirmar")</li>
                                <li>👥 Cupos disponibles: @e.CuposDisponibles</li>
                            </ul>

                            <div class="mt-auto d-flex gap-2 flex-wrap">
                                <a href="@Url.Action("Detalle", "Eventos", new { id = e.Id })"
                                   class="btn btn-outline-success rounded-pill flex-fill">
                                    Detalles
                                </a>

                                <a href="@Url.Action("Contacto", "Eventos", new { id = e.Id })"
                                   class="btn btn-success rounded-pill flex-fill">
                                    Contactar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light border shadow-sm rounded-4 text-center py-4">
                    No hay eventos registrados en este momento.
                </div>
            </div>
        }
    </div>
</div>

<style>
    .eventos-hero {
        min-height: 60vh;
        margin-top: -80px;
        padding-top: 80px;
        background: linear-gradient(rgba(0,0,0,.55), rgba(0,0,0,.55)), url('/Content/im/img2.jpg') center/cover no-repeat;
    }

    .evento-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        transition: all .35s ease;
        overflow: hidden;
        height: 100%;
    }

        .evento-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 40px rgba(0,0,0,.15);
        }

    .evento-body {
        padding: 1.6rem;
    }

    .evento-tag {
        display: inline-block;
        background: rgba(25,135,84,.1);
        color: #198754;
        font-size: .75rem;
        padding: .25rem .6rem;
        border-radius: 50px;
        font-weight: 600;
        width: fit-content;
    }
</style>