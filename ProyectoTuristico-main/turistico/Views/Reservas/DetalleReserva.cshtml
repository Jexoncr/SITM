@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}
@model turistico.Controllers.ReservaDetalleVM
@using System

@{
    ViewBag.Title = "Detalle de Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var reserva = Model ?? new turistico.Controllers.ReservaDetalleVM();

    Func<string, string> estadoClass = (estadoTexto) =>
    {
        switch ((estadoTexto ?? "").Trim().ToLowerInvariant())
        {
            case "confirmada": return "status-confirmada";
            case "pendiente": return "status-pendiente";
            case "cancelada": return "status-cancelada";
            case "finalizada": return "status-finalizada";
            default: return "status-neutro";
        }
    };

    Func<string, string> estadoIcon = (estadoTexto) =>
    {
        switch ((estadoTexto ?? "").Trim().ToLowerInvariant())
        {
            case "confirmada": return "bi-check-circle-fill";
            case "pendiente": return "bi-hourglass-split";
            case "cancelada": return "bi-x-circle-fill";
            case "finalizada": return "bi-flag-fill";
            default: return "bi-info-circle-fill";
        }
    };

    Func<string, string> tipoIcon = (tipoTexto) =>
    {
        switch ((tipoTexto ?? "").Trim().ToLowerInvariant())
        {
            case "evento": return "bi-calendar-event";
            case "lugar": return "bi-geo-alt";
            case "hotel": return "bi-building";
            case "restaurante": return "bi-cup-hot";
            case "tour": return "bi-compass";
            default: return "bi-bookmark-star";
        }
    };

    Func<DateTime, string> fmt = (d) => d.ToString("dd/MM/yyyy");

    var titulo = string.IsNullOrWhiteSpace(reserva.Titulo) ? "Reserva" : reserva.Titulo;
    var tipo = string.IsNullOrWhiteSpace(reserva.Tipo) ? "-" : reserva.Tipo;
    var estado = string.IsNullOrWhiteSpace(reserva.Estado) ? "Pendiente" : reserva.Estado;
    var lugarNombre = string.IsNullOrWhiteSpace(reserva.LugarNombre) ? "No disponible" : reserva.LugarNombre;
    var direccion = string.IsNullOrWhiteSpace(reserva.Direccion) ? "No disponible" : reserva.Direccion;
    var fechaReserva = fmt(reserva.FechaReserva);

    var fechaActividad = reserva.FechaInicio.HasValue
        ? (reserva.FechaFin.HasValue
            ? $"{fmt(reserva.FechaInicio.Value)} - {fmt(reserva.FechaFin.Value)}"
            : fmt(reserva.FechaInicio.Value))
        : "No disponible";
}

<style>
    :root {
        --dt-green-900: #0f3d2e;
        --dt-green-800: #145544;
        --dt-green-soft: rgba(20,85,68,.08);
        --dt-ink: #0f172a;
        --dt-muted: #64748b;
        --dt-border: rgba(15,23,42,.08);
        --dt-card: rgba(255,255,255,.97);
        --dt-shadow: 0 20px 48px rgba(15,23,42,.07);
        --dt-shadow-soft: 0 10px 24px rgba(15,23,42,.05);
        --dt-radius-xl: 30px;
        --dt-radius-lg: 24px;
        --dt-radius-md: 18px;
    }

    .detail-page {
        background: radial-gradient(circle at top left, rgba(20,85,68,.07), transparent 30%), radial-gradient(circle at top right, rgba(46,158,127,.08), transparent 24%), linear-gradient(180deg, #fbfdfc 0%, #f4f8f6 50%, #eef4f1 100%);
        min-height: 100%;
    }

    .detail-shell-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
    }

    .detail-hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--dt-radius-xl);
        padding: 2.1rem 1.45rem 1.7rem;
        margin-bottom: 1.15rem;
        background: radial-gradient(circle at top right, rgba(46,158,127,.12), transparent 28%), linear-gradient(135deg, #ffffff 0%, #f7fbf8 55%, #eef7f2 100%);
        border: 1px solid rgba(15,23,42,.06);
        box-shadow: 0 20px 46px rgba(15,23,42,.06);
    }

        .detail-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(20,85,68,.04), transparent 24%);
            pointer-events: none;
        }

    .detail-hero-inner {
        position: relative;
        z-index: 2;
    }

    .detail-badge {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .55rem .88rem;
        border-radius: 999px;
        background: rgba(20,85,68,.08);
        color: #145544;
        border: 1px solid rgba(20,85,68,.10);
        font-weight: 800;
        font-size: .8rem;
        margin-bottom: .8rem;
    }

    .detail-hero h1 {
        font-weight: 950;
        letter-spacing: -.03em;
        margin-bottom: .5rem;
        line-height: 1.02;
        color: var(--dt-ink);
        font-size: clamp(2rem, 3vw, 3rem);
    }

    .detail-hero p {
        margin: 0;
        color: var(--dt-muted);
        line-height: 1.85;
        max-width: 860px;
        font-size: .96rem;
    }

    .detail-layout {
        display: grid;
        grid-template-columns: 1.1fr .8fr;
        gap: 1rem;
        align-items: start;
    }

    @@media (max-width: 991.98px) {
        .detail-layout {
            grid-template-columns: 1fr;
        }
    }

    .detail-panel {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 28px;
        background: var(--dt-card);
        box-shadow: var(--dt-shadow);
        overflow: hidden;
    }

    .detail-panel-head {
        padding: 1rem 1rem .95rem;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.96));
    }

    .detail-panel-title {
        margin: 0;
        color: var(--dt-ink);
        font-weight: 950;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

    .detail-panel-sub {
        color: var(--dt-muted);
        font-size: .84rem;
        margin-top: .25rem;
        line-height: 1.6;
    }

    .detail-panel-body {
        padding: 1rem;
    }

    .detail-info {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 22px;
        background: linear-gradient(180deg, rgba(248,250,252,.8), rgba(255,255,255,1));
        padding: 1rem;
        height: 100%;
        box-shadow: var(--dt-shadow-soft);
    }

    .detail-row {
        display: flex;
        align-items: start;
        gap: .9rem;
        margin-bottom: 1rem;
    }

        .detail-row:last-child {
            margin-bottom: 0;
        }

    .detail-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: rgba(20,85,68,.08);
        color: #145544;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        border: 1px solid rgba(20,85,68,.10);
        flex: 0 0 auto;
    }

    .detail-label {
        color: var(--dt-muted);
        font-size: .76rem;
        font-weight: 800;
        margin-bottom: .08rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .detail-value {
        color: var(--dt-ink);
        font-weight: 850;
        line-height: 1.55;
        font-size: .92rem;
    }

    .detail-status {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .52rem .84rem;
        border-radius: 999px;
        font-weight: 850;
        font-size: .82rem;
        white-space: nowrap;
    }

    .status-confirmada {
        background: rgba(22,163,74,.10);
        color: #166534;
    }

    .status-pendiente {
        background: rgba(245,158,11,.14);
        color: #92400e;
    }

    .status-cancelada {
        background: rgba(220,53,69,.12);
        color: #b42318;
    }

    .status-finalizada {
        background: rgba(59,130,246,.10);
        color: #1d4ed8;
    }

    .status-neutro {
        background: rgba(100,116,139,.10);
        color: #475569;
    }

    .detail-actions {
        display: grid;
        gap: .75rem;
    }

    .btn-detail {
        border-radius: 999px;
        font-weight: 850;
        padding: .82rem 1rem;
    }
</style>

<div class="detail-page">
    <div class="detail-shell-wrap">
        <section class="detail-hero">
            <div class="detail-hero-inner">
                <span class="detail-badge">
                    <i class="bi bi-bookmark-star"></i> Reserva registrada
                </span>

                <h1>@titulo</h1>
                <p>
                    Consulta la información detallada de tu reserva registrada en el portal turístico, incluyendo estado actual, tipo de actividad y datos principales.
                </p>
            </div>
        </section>

        <div class="detail-layout">
            <div class="detail-panel">
                <div class="detail-panel-head">
                    <h2 class="detail-panel-title">
                        <i class="bi bi-journal-text"></i> Información de la reserva
                    </h2>
                    <div class="detail-panel-sub">
                        Datos principales, tipo de actividad, lugar asociado y fechas relacionadas.
                    </div>
                </div>

                <div class="detail-panel-body">
                    <div class="detail-info">
                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi @tipoIcon(tipo)"></i>
                            </div>
                            <div>
                                <div class="detail-label">Título</div>
                                <div class="detail-value">@titulo</div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi bi-tag"></i>
                            </div>
                            <div>
                                <div class="detail-label">Tipo</div>
                                <div class="detail-value">@tipo</div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                            <div>
                                <div class="detail-label">Fecha de reserva</div>
                                <div class="detail-value">@fechaReserva</div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi bi-calendar2-check"></i>
                            </div>
                            <div>
                                <div class="detail-label">Fecha de actividad</div>
                                <div class="detail-value">@fechaActividad</div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi bi-people"></i>
                            </div>
                            <div>
                                <div class="detail-label">Cantidad de personas</div>
                                <div class="detail-value">@reserva.NumeroPersonas</div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <div>
                                <div class="detail-label">Lugar</div>
                                <div class="detail-value">@lugarNombre</div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi bi-signpost"></i>
                            </div>
                            <div>
                                <div class="detail-label">Dirección</div>
                                <div class="detail-value">@direccion</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="detail-panel">
                <div class="detail-panel-head">
                    <h2 class="detail-panel-title">
                        <i class="bi bi-shield-check"></i> Estado y acciones
                    </h2>
                    <div class="detail-panel-sub">
                        Estado actual de la reserva y accesos rápidos.
                    </div>
                </div>

                <div class="detail-panel-body">
                    <div class="detail-info">
                        <div class="detail-row">
                            <div class="detail-icon">
                                <i class="bi @estadoIcon(estado)"></i>
                            </div>
                            <div>
                                <div class="detail-label">Estado actual</div>
                                <div class="mt-2">
                                    <span class="detail-status @estadoClass(estado)">
                                        <i class="bi @estadoIcon(estado)"></i> @estado
                                    </span>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="detail-actions">
                            <a href="@Url.Action("Index", "Reservas")" class="btn btn-outline-secondary btn-detail">
                                <i class="bi bi-arrow-left me-1"></i> Volver
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>