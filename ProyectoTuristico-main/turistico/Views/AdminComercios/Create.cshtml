@model turistico.Controllers.ComercioAdminVM

@{
    ViewBag.Title = "Crear Comercio";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    :root {
        --cc-green-900: #0f3d2e;
        --cc-green-800: #145544;
        --cc-green-soft: rgba(20,85,68,.08);
        --cc-ink: #0f172a;
        --cc-muted: #64748b;
        --cc-card: rgba(255,255,255,.97);
        --cc-shadow: 0 20px 48px rgba(15,23,42,.08);
        --cc-shadow-soft: 0 10px 24px rgba(15,23,42,.05);
        --cc-radius-xl: 28px;
        --cc-radius-lg: 22px;
    }

    .commerce-form-shell {
        display: grid;
        gap: 1rem;
        max-width: 1260px;
    }

    .commerce-hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--cc-radius-xl);
        padding: 1.9rem 1.25rem 1.55rem;
        background: radial-gradient(circle at top right, rgba(46,158,127,.12), transparent 28%), linear-gradient(135deg, #ffffff 0%, #f7fbf8 55%, #eef7f2 100%);
        border: 1px solid rgba(15,23,42,.06);
        box-shadow: 0 18px 42px rgba(15,23,42,.06);
    }

        .commerce-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(20,85,68,.04), transparent 24%);
            pointer-events: none;
        }

    .commerce-hero-inner {
        position: relative;
        z-index: 2;
    }

    .commerce-badge {
        display: inline-flex;
        align-items: center;
        gap: .42rem;
        padding: .5rem .82rem;
        border-radius: 999px;
        background: rgba(20,85,68,.08);
        color: var(--cc-green-800);
        border: 1px solid rgba(20,85,68,.10);
        font-weight: 800;
        font-size: .8rem;
        margin-bottom: .75rem;
    }

    .commerce-title {
        margin: 0 0 .45rem;
        color: var(--cc-ink);
        font-weight: 950;
        line-height: 1.04;
        letter-spacing: -.03em;
        font-size: clamp(2rem, 3vw, 2.9rem);
    }

    .commerce-sub {
        margin: 0;
        color: var(--cc-muted);
        line-height: 1.78;
        max-width: 880px;
        font-size: .95rem;
    }

    .commerce-grid {
        display: grid;
        grid-template-columns: 1.2fr .95fr;
        gap: 1rem;
        align-items: start;
    }

    @@media (max-width: 991.98px) {
        .commerce-grid {
            grid-template-columns: 1fr;
        }
    }

    .card-premium {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: var(--cc-radius-xl);
        background: var(--cc-card);
        box-shadow: var(--cc-shadow);
        overflow: hidden;
    }

    .card-head {
        padding: 1rem 1.05rem;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.96));
    }

    .card-head-title {
        margin: 0;
        color: var(--cc-ink);
        font-weight: 950;
        font-size: 1rem;
    }

    .card-head-sub {
        margin-top: .2rem;
        color: var(--cc-muted);
        font-size: .84rem;
        line-height: 1.6;
    }

    .card-body-premium {
        padding: 1.1rem;
    }

    .form-label {
        font-weight: 900;
        color: var(--cc-ink);
        font-size: .84rem;
        margin-bottom: .45rem;
    }

    .form-control,
    .form-select {
        border-radius: 16px;
        min-height: 48px;
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: none !important;
        font-size: .92rem;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #1f8a6c;
            box-shadow: 0 0 0 .2rem rgba(31,138,108,.12) !important;
        }

    textarea.form-control {
        min-height: 120px;
    }

    .soft-box {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(248,250,252,.78), rgba(255,255,255,1));
        padding: 1rem;
        box-shadow: var(--cc-shadow-soft);
    }

    .toggle-box {
        display: flex;
        align-items: center;
        gap: .75rem;
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 18px;
        padding: .95rem 1rem;
        background: linear-gradient(180deg, rgba(248,250,252,.78), rgba(255,255,255,1));
        box-shadow: var(--cc-shadow-soft);
    }

    .map-box {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 22px;
        overflow: hidden;
        background: #fff;
        box-shadow: var(--cc-shadow-soft);
    }

    .map-toolbar {
        padding: .9rem 1rem;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: #f8fafc;
    }

    .map-toolbar-title {
        color: var(--cc-ink);
        font-weight: 900;
        font-size: .9rem;
        margin-bottom: .15rem;
    }

    .map-toolbar-sub {
        color: var(--cc-muted);
        font-size: .82rem;
        line-height: 1.55;
        margin: 0;
    }

    .map-search-wrap {
        margin-top: .85rem;
        position: relative;
    }

    .map-search-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: .55rem;
    }

    .map-search-btn {
        border-radius: 14px;
        font-weight: 800;
        padding: .75rem 1rem;
        white-space: nowrap;
    }

    .map-search-results {
        margin-top: .6rem;
        display: none;
        border: 1px solid rgba(15,23,42,.08);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 12px 28px rgba(15,23,42,.10);
        max-height: 240px;
        overflow-y: auto;
    }

        .map-search-results.show {
            display: block;
        }

    .map-result-item {
        padding: .8rem .9rem;
        cursor: pointer;
        border-bottom: 1px solid rgba(15,23,42,.06);
        transition: background .18s ease;
    }

        .map-result-item:last-child {
            border-bottom: none;
        }

        .map-result-item:hover {
            background: rgba(20,85,68,.05);
        }

    .map-result-title {
        color: var(--cc-ink);
        font-weight: 800;
        font-size: .88rem;
        line-height: 1.4;
    }

    .map-result-sub {
        color: var(--cc-muted);
        font-size: .78rem;
        line-height: 1.5;
        margin-top: .12rem;
    }

    .map-search-hint {
        color: var(--cc-muted);
        font-size: .8rem;
        line-height: 1.5;
        margin-top: .5rem;
    }

    .map-search-state {
        margin-top: .6rem;
        font-size: .82rem;
        font-weight: 700;
        color: var(--cc-muted);
        display: none;
    }

        .map-search-state.show {
            display: block;
        }

    #mapaComercioCreate {
        height: 420px;
        width: 100%;
    }

    .coords-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .75rem;
        padding: 1rem;
        border-top: 1px solid rgba(15,23,42,.06);
        background: #fff;
    }

    .coords-readonly {
        border-radius: 14px;
        min-height: 46px;
        border: 1px solid rgba(15,23,42,.10);
        background: #f8fafc;
        display: flex;
        align-items: center;
        padding: .7rem .85rem;
        color: #334155;
        font-weight: 700;
        font-size: .9rem;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .7rem;
        margin-top: 1rem;
    }

    .btn-premium {
        border-radius: 999px;
        font-weight: 850;
        padding: .8rem 1rem;
    }

    .img-help {
        color: var(--cc-muted);
        font-size: .82rem;
        line-height: 1.6;
        margin-top: .35rem;
    }
</style>

<div class="commerce-form-shell">
    <section class="commerce-hero">
        <div class="commerce-hero-inner">
            <span class="commerce-badge">
                <i class="bi bi-shop-window"></i> Administración de comercios
            </span>
            <h1 class="commerce-title">Crear comercio</h1>
            <p class="commerce-sub">
                Registra un nuevo comercio, asigna categoría, usuario comercio, ubicación exacta en el mapa de Costa Rica y, si aplica, marca regulación y patente.
            </p>
        </div>
    </section>

    @using (Html.BeginForm("Create", "AdminComercios", FormMethod.Post, new { enctype = "multipart/form-data", autocomplete = "off" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.MapaLatitud, new { id = "MapaLatitud" })
        @Html.HiddenFor(m => m.MapaLongitud, new { id = "MapaLongitud" })

        <div class="commerce-grid">
            <div class="card-premium">
                <div class="card-head">
                    <h2 class="card-head-title">Información principal</h2>
                    <div class="card-head-sub">Completa los datos generales del comercio y del lugar asociado.</div>
                </div>

                <div class="card-body-premium">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Nombre</label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Nombre del comercio" })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Categoría</label>
                            @Html.DropDownListFor(m => m.CategoriaId, (SelectList)ViewBag.Categorias, "Seleccione...", new { @class = "form-select" })
                        </div>

                        <div class="col-12">
                            <label class="form-label">Usuario comercio</label>
                            @Html.DropDownListFor(m => m.UserId, (SelectList)ViewBag.UsuariosComercio, "Sin asignar", new { @class = "form-select" })
                        </div>

                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            @Html.TextAreaFor(m => m.Descripcion, 5, 1, new { @class = "form-control", placeholder = "Descripción del comercio..." })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Teléfono</label>
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", placeholder = "Teléfono" })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">WhatsApp</label>
                            @Html.TextBoxFor(m => m.LinkWhatsApp, new { @class = "form-control", placeholder = "https://wa.me/..." })
                        </div>

                        <div class="col-12">
                            <label class="form-label">Dirección</label>
                            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control", placeholder = "Dirección del lugar" })
                        </div>

                        <div class="col-12">
                            <label class="form-label">Dirección para mapa / referencia</label>
                            @Html.TextBoxFor(m => m.DireccionMapa, new { @class = "form-control", placeholder = "Referencia visual o detalle para el mapa" })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Horario</label>
                            @Html.TextBoxFor(m => m.Horario, new { @class = "form-control", placeholder = "Ej. L-V 8:00 a.m. - 6:00 p.m." })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Sitio web</label>
                            @Html.TextBoxFor(m => m.SitioWeb, new { @class = "form-control", placeholder = "https://..." })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Estado</label>
                            @Html.DropDownListFor(m => m.Estado,
                                new SelectList(new[]
                                {
                                    new SelectListItem { Text = "Aprobado", Value = "Aprobado" },
                                    new SelectListItem { Text = "Pendiente", Value = "Pendiente" },
                                    new SelectListItem { Text = "Rechazado", Value = "Rechazado" }
                                }, "Value", "Text", Model != null ? Model.Estado : "Aprobado"),
                                new { @class = "form-select" })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Imagen principal</label>
                            @Html.TextBoxFor(m => m.Imagen, new { type = "file", @class = "form-control", accept = ".jpg,.jpeg,.png,.webp,image/*" })
                            <div class="img-help">Formatos permitidos: JPG, PNG y WEBP.</div>
                        </div>

                        <div class="col-12">
                            <div class="toggle-box">
                                @Html.CheckBoxFor(m => m.EsRegulado, new { @class = "form-check-input", id = "EsRegulado" })
                                <label for="EsRegulado" class="mb-0 fw-bold">Este comercio es regulado</label>
                            </div>
                        </div>

                        <div class="col-12" id="bloqueRegulado" style="display:@((Model != null && Model.EsRegulado) ? "block" : "none")">
                            <div class="soft-box">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Número de patente</label>
                                        @Html.TextBoxFor(m => m.NumeroPatente, new { @class = "form-control", placeholder = "Número de patente" })
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Fecha de vencimiento</label>
                                        @Html.TextBoxFor(m => m.FechaVencimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-success btn-premium">
                            <i class="bi bi-check2-circle me-1"></i> Guardar comercio
                        </button>

                        <a href="@Url.Action("Index", "AdminComercios")" class="btn btn-outline-secondary btn-premium">
                            Cancelar
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-premium">
                <div class="card-head">
                    <h2 class="card-head-title">Ubicación en mapa</h2>
                    <div class="card-head-sub">Selecciona el punto exacto dentro de Costa Rica. Este paso es obligatorio para tu controller.</div>
                </div>

                <div class="card-body-premium">
                    <div class="map-box">
                        <div class="map-toolbar">
                            <div class="map-toolbar-title">Mapa interactivo</div>
                            <p class="map-toolbar-sub">Haz clic en el mapa para colocar el pin, arrástralo para ajustar la ubicación o usa la barra de búsqueda para ir directo a un lugar.</p>

                            <div class="map-search-wrap">
                                <div class="map-search-row">
                                    <input type="text"
                                           id="mapSearchInput"
                                           class="form-control"
                                           placeholder="Buscar dirección, comercio, barrio o referencia en Costa Rica..." />
                                    <button type="button" id="mapSearchBtn" class="btn btn-success map-search-btn">
                                        <i class="bi bi-search me-1"></i> Buscar
                                    </button>
                                </div>

                                <div id="mapSearchState" class="map-search-state"></div>
                                <div id="mapSearchResults" class="map-search-results"></div>

                                <div class="map-search-hint">
                                    Puedes escribir algo como: <strong>La Fortuna, San Carlos</strong>, <strong>Ciudad Quesada</strong> o una dirección más específica.
                                </div>
                            </div>
                        </div>

                        <div id="mapaComercioCreate"></div>

                        <div class="coords-box">
                            <div>
                                <label class="form-label">Latitud</label>
                                <div id="latitudPreview" class="coords-readonly">Sin seleccionar</div>
                            </div>
                            <div>
                                <label class="form-label">Longitud</label>
                                <div id="longitudPreview" class="coords-readonly">Sin seleccionar</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
            const esRegulado = document.getElementById('EsRegulado');
            const bloqueRegulado = document.getElementById('bloqueRegulado');

            function toggleRegulado() {
                if (!esRegulado || !bloqueRegulado) return;
                bloqueRegulado.style.display = esRegulado.checked ? 'block' : 'none';
            }

            if (esRegulado) {
                esRegulado.addEventListener('change', toggleRegulado);
                toggleRegulado();
            }

            const latInput = document.getElementById('MapaLatitud');
            const lngInput = document.getElementById('MapaLongitud');
            const latPreview = document.getElementById('latitudPreview');
            const lngPreview = document.getElementById('longitudPreview');

            const searchInput = document.getElementById('mapSearchInput');
            const searchBtn = document.getElementById('mapSearchBtn');
            const searchResults = document.getElementById('mapSearchResults');
            const searchState = document.getElementById('mapSearchState');

            const crCenter = [9.7489, -83.7534];
            const map = L.map('mapaComercioCreate').setView(crCenter, 8);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            let marker = null;

            function setPoint(lat, lng) {
                latInput.value = lat.toFixed(6);
                lngInput.value = lng.toFixed(6);
                latPreview.textContent = lat.toFixed(6);
                lngPreview.textContent = lng.toFixed(6);

                if (!marker) {
                    marker = L.marker([lat, lng], { draggable: true }).addTo(map);

                    marker.on('dragend', function (e) {
                        const pos = e.target.getLatLng();
                        setPoint(pos.lat, pos.lng);
                    });
                } else {
                    marker.setLatLng([lat, lng]);
                }
            }

            function clearResults() {
                searchResults.innerHTML = '';
                searchResults.classList.remove('show');
            }

            function setState(text) {
                if (!text) {
                    searchState.textContent = '';
                    searchState.classList.remove('show');
                    return;
                }

                searchState.textContent = text;
                searchState.classList.add('show');
            }

            function selectResult(item) {
                const lat = parseFloat(item.lat);
                const lng = parseFloat(item.lon);

                if (isNaN(lat) || isNaN(lng)) {
                    return;
                }

                setPoint(lat, lng);
                map.setView([lat, lng], 16);
                clearResults();
                setState('Ubicación seleccionada correctamente.');
            }

            function renderResults(items) {
                clearResults();

                if (!items || !items.length) {
                    setState('No se encontraron resultados para esa búsqueda.');
                    return;
                }

                setState('Selecciona una opción de la lista.');

                items.forEach(function (item) {
                    const div = document.createElement('div');
                    div.className = 'map-result-item';
                    div.innerHTML =
                        '<div class="map-result-title">' + (item.display_name || 'Resultado') + '</div>' +
                        '<div class="map-result-sub">Lat: ' + parseFloat(item.lat).toFixed(6) + ' · Lng: ' + parseFloat(item.lon).toFixed(6) + '</div>';

                    div.addEventListener('click', function () {
                        selectResult(item);
                    });

                    searchResults.appendChild(div);
                });

                searchResults.classList.add('show');
            }

            async function searchLocation() {
                const query = (searchInput.value || '').trim();

                if (!query) {
                    clearResults();
                    setState('Escribe una dirección o referencia para buscar.');
                    return;
                }

                setState('Buscando ubicación...');
                clearResults();

                try {
                    const finalQuery = query.toLowerCase().includes('costa rica')
                        ? query
                        : query + ', Costa Rica';

                    const url = 'https://nominatim.openstreetmap.org/search?format=json&limit=6&countrycodes=cr&q=' + encodeURIComponent(finalQuery);

                    const response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (!response.ok) {
                        throw new Error('No se pudo consultar el servicio de búsqueda.');
                    }

                    const data = await response.json();
                    renderResults(data);
                } catch (error) {
                    clearResults();
                    setState('No fue posible completar la búsqueda en este momento.');
                }
            }

            map.on('click', function (e) {
                setPoint(e.latlng.lat, e.latlng.lng);
                setState('Ubicación seleccionada manualmente en el mapa.');
                clearResults();
            });

            if (searchBtn) {
                searchBtn.addEventListener('click', searchLocation);
            }

            if (searchInput) {
                searchInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        searchLocation();
                    }
                });
            }

            document.addEventListener('click', function (e) {
                if (!searchResults.contains(e.target) &&
                    e.target !== searchInput &&
                    e.target !== searchBtn) {
                    searchResults.classList.remove('show');
                }
            });

            const currentLat = parseFloat(latInput.value || '');
            const currentLng = parseFloat(lngInput.value || '');

            if (!isNaN(currentLat) && !isNaN(currentLng)) {
                setPoint(currentLat, currentLng);
                map.setView([currentLat, currentLng], 14);
            }
        })();
    </script>
}