@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
    ViewBag.HideAlerts = true;

}
@model turistico.Controllers.EventoDetalleVM

@{

    ViewBag.Title = Model != null ? "Detalle del evento" : "Evento";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var evento = Model ?? new turistico.Controllers.EventoDetalleVM();

    var categoria = string.IsNullOrWhiteSpace(evento.Categoria) ? "General" : evento.Categoria;
    var descripcion = string.IsNullOrWhiteSpace(evento.Descripcion) ? "Evento turístico disponible en el portal." : evento.Descripcion;
    var comercioNombre = string.IsNullOrWhiteSpace(evento.ComercioNombre) ? "-" : evento.ComercioNombre;
    var lugarNombre = string.IsNullOrWhiteSpace(evento.LugarNombre) ? "-" : evento.LugarNombre;
    var direccion = string.IsNullOrWhiteSpace(evento.Direccion) ? "Ubicación no disponible" : evento.Direccion;
    var fechaInicio = evento.FechaInicio.HasValue ? evento.FechaInicio.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    var fechaFin = evento.FechaFin.HasValue ? evento.FechaFin.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    var telefono = string.IsNullOrWhiteSpace(evento.Telefono) ? "-" : evento.Telefono;
    var whatsapp = string.IsNullOrWhiteSpace(evento.WhatsApp) ? "" : evento.WhatsApp;
    var sitioWeb = string.IsNullOrWhiteSpace(evento.SitioWeb) ? "" : evento.SitioWeb;
    var sinCupos = evento.CuposDisponibles <= 0;
    var limitePorPersona = evento.LimitePorPersona > 0 ? evento.LimitePorPersona : 1;
}

<script>
    document.body.classList.add("event-detail-body");
</script>

<style>
    :root {
        --ed-green-900: #0f3d2e;
        --ed-green-800: #145544;
        --ed-green-700: #1b6b55;
        --ed-green-soft: rgba(20,85,68,.08);
        --ed-ink: #0f172a;
        --ed-ink-soft: #1e293b;
        --ed-muted: #475569;
        --ed-border: rgba(15,23,42,.08);
        --ed-card: rgba(255,255,255,.98);
        --ed-card-soft: #f8fbf9;
        --ed-shadow: 0 18px 42px rgba(15,23,42,.10);
        --ed-shadow-soft: 0 10px 24px rgba(15,23,42,.06);
        --ed-radius-xl: 26px;
        --ed-radius-lg: 20px;
    }

    body.event-detail-body {
        background:
            linear-gradient(rgba(8,18,15,.58), rgba(8,18,15,.46)),
            radial-gradient(circle at 12% 10%, rgba(46,158,127,.10), transparent 36%),
            radial-gradient(circle at 88% 20%, rgba(27,122,92,.08), transparent 38%),
            url('/Content/im/img4.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .event-detail-wrap {
        max-width: 1320px;
        margin: 0 auto;
        padding: 1.5rem 1rem 2.7rem;
    }

    .detail-alert-wrap {
        margin-bottom: 1rem;
    }

    .detail-alert {
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 22px;
        padding: 1rem 1.1rem;
        display: flex;
        align-items: flex-start;
        gap: .85rem;
        box-shadow: 0 16px 34px rgba(15,23,42,.18);
        backdrop-filter: blur(10px);
    }

    .detail-alert.err {
        background: rgba(255,248,248,.96);
        color: #7f1d1d;
        border-color: rgba(220,53,69,.18);
    }

    .detail-alert.ok {
        background: rgba(247,255,250,.96);
        color: #14532d;
        border-color: rgba(22,163,74,.18);
    }

    .detail-alert-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        font-size: 1.1rem;
    }

    .detail-alert.err .detail-alert-icon {
        background: rgba(220,53,69,.12);
        color: #b42318;
    }

    .detail-alert.ok .detail-alert-icon {
        background: rgba(22,163,74,.12);
        color: #166534;
    }

    .detail-alert-title {
        font-weight: 950;
        font-size: 1.02rem;
        margin-bottom: .15rem;
        line-height: 1.2;
    }

    .detail-alert-text {
        font-size: .96rem;
        line-height: 1.55;
        color: inherit;
    }

    .event-detail-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 2rem 1.35rem;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, rgba(15,61,46,.93), rgba(20,85,68,.80));
        color: #fff;
        border: 1px solid rgba(255,255,255,.12);
        box-shadow: 0 22px 52px rgba(15,61,46,.20);
        backdrop-filter: blur(8px);
    }

    .event-detail-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at top right, rgba(255,255,255,.08), transparent 30%),
            radial-gradient(circle at bottom left, rgba(255,255,255,.04), transparent 24%);
        pointer-events: none;
    }

    .event-detail-hero-inner {
        position: relative;
        z-index: 2;
    }

    .hero-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .52rem .82rem;
        border-radius: 999px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.16);
        font-weight: 800;
        font-size: .8rem;
        margin-top: .9rem;
        color: #fff;
    }

    .event-detail-hero h1 {
        font-weight: 950;
        margin-bottom: .55rem;
        letter-spacing: -.02em;
        line-height: 1.08;
        color: #fff;
    }

    .event-detail-hero p {
        max-width: 820px;
        color: rgba(255,255,255,.94);
        line-height: 1.8;
        margin: 0;
        font-size: .97rem;
    }

    .detail-card {
        border: 1px solid rgba(255,255,255,.10);
        border-radius: var(--ed-radius-xl);
        background: var(--ed-card);
        box-shadow: var(--ed-shadow);
        overflow: hidden;
    }

    .detail-section {
        padding: 1.2rem;
        height: 100%;
        background: transparent;
    }

    .detail-title {
        color: var(--ed-ink);
        font-weight: 950;
        margin-bottom: .25rem;
        font-size: 1.2rem;
    }

    .detail-sub {
        color: var(--ed-muted);
        margin-bottom: .95rem;
        font-size: .89rem;
        line-height: 1.6;
    }

    .info-box {
        border: 1px solid rgba(15,23,42,.07);
        border-radius: 18px;
        padding: .95rem;
        background: #ffffff;
        margin-bottom: .8rem;
        box-shadow: var(--ed-shadow-soft);
    }

    .info-row {
        display: flex;
        align-items: start;
        gap: .75rem;
    }

    .info-icon {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--ed-green-soft);
        color: var(--ed-green-800);
        font-size: .95rem;
        flex: 0 0 auto;
    }

    .info-label {
        color: var(--ed-muted);
        font-size: .72rem;
        font-weight: 900;
        margin-bottom: .08rem;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .info-value {
        color: var(--ed-ink);
        font-weight: 850;
        line-height: 1.5;
        font-size: .92rem;
    }

    .info-value-soft {
        font-weight: 700;
        color: var(--ed-ink-soft);
        margin-top: .15rem;
    }

    .reserve-panel {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 20px;
        padding: 1rem;
        background: #ffffff;
        box-shadow: var(--ed-shadow-soft);
    }

    .reserve-title {
        font-weight: 950;
        color: var(--ed-ink);
        margin-bottom: .25rem;
        font-size: 1rem;
    }

    .reserve-sub {
        color: var(--ed-muted);
        margin-bottom: .85rem;
        font-size: .87rem;
        line-height: 1.6;
    }

    .availability-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        border-radius: 999px;
        padding: .46rem .76rem;
        font-weight: 900;
        font-size: .76rem;
        margin-bottom: .9rem;
    }

    .availability-ok {
        background: rgba(22,163,74,.10);
        color: #166534;
    }

    .availability-none {
        background: rgba(220,53,69,.12);
        color: #b42318;
    }

    .reserve-note {
        border-radius: 16px;
        padding: .8rem .9rem;
        background: var(--ed-card-soft);
        border: 1px solid rgba(15,23,42,.06);
        color: var(--ed-ink-soft);
        font-size: .84rem;
        line-height: 1.6;
        margin-bottom: .9rem;
    }

    .reserve-limit-box {
        border-radius: 16px;
        padding: .85rem .95rem;
        background: rgba(20,85,68,.06);
        border: 1px solid rgba(20,85,68,.10);
        color: #145544;
        font-size: .84rem;
        line-height: 1.6;
        margin-bottom: .9rem;
        font-weight: 700;
    }

    .btn-detail {
        border-radius: 999px;
        font-weight: 800;
        padding: .74rem 1rem;
        font-size: .84rem;
    }

    .detail-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .6rem;
        margin-top: 1rem;
    }

    .form-label.fw-bold {
        font-size: .84rem;
        font-weight: 900 !important;
        color: var(--ed-ink);
    }

    .form-control {
        border-radius: 16px;
        min-height: 48px;
        border: 1px solid rgba(15,23,42,.10);
        color: var(--ed-ink);
        font-weight: 700;
        box-shadow: none !important;
    }

    .form-control:focus {
        border-color: #1f8a6c;
        box-shadow: 0 0 0 .2rem rgba(31,138,108,.12) !important;
    }

    .text-login-note {
        color: var(--ed-ink-soft);
        font-size: .9rem;
        line-height: 1.6;
    }

    .divider-soft {
        border-color: rgba(15,23,42,.08);
    }

    @@media (max-width: 991.98px) {
        .event-detail-hero {
            padding: 1.5rem 1rem;
            border-radius: 22px;
        }

        .detail-alert {
            padding: .9rem;
        }
    }
</style>

<div class="event-detail-wrap">
    @if (TempData["Err"] != null)
    {
        <div class="detail-alert-wrap">
            <div class="detail-alert err">
                <div class="detail-alert-icon">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                </div>
                <div>
                    <div class="detail-alert-title">Ocurrió un problema</div>
                    <div class="detail-alert-text">@TempData["Err"]</div>
                </div>
            </div>
        </div>
    }

    @if (TempData["Ok"] != null)
    {
        <div class="detail-alert-wrap">
            <div class="detail-alert ok">
                <div class="detail-alert-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="detail-alert-title">Operación completada</div>
                    <div class="detail-alert-text">@TempData["Ok"]</div>
                </div>
            </div>
        </div>
    }

    <section class="event-detail-hero">
        <div class="event-detail-hero-inner">
            <h1 class="display-6">@evento.Nombre</h1>
            <p>@descripcion</p>
            <span class="hero-chip">
                <i class="bi bi-tag"></i> @categoria
            </span>
        </div>
    </section>

    <div class="detail-card">
        <div class="row g-0">
            <div class="col-lg-7 border-end">
                <div class="detail-section">
                    <h2 class="detail-title">Información del evento</h2>
                    <div class="detail-sub">Consulta los datos principales de la actividad registrada.</div>

                    <div class="info-box">
                        <div class="info-row">
                            <div class="info-icon">
                                <i class="bi bi-shop"></i>
                            </div>
                            <div>
                                <div class="info-label">Comercio</div>
                                <div class="info-value">@comercioNombre</div>
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-row">
                            <div class="info-icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <div>
                                <div class="info-label">Lugar</div>
                                <div class="info-value">@lugarNombre</div>
                                <div class="info-value info-value-soft">@direccion</div>
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-row">
                            <div class="info-icon">
                                <i class="bi bi-calendar2-event"></i>
                            </div>
                            <div>
                                <div class="info-label">Fecha de inicio</div>
                                <div class="info-value">@fechaInicio</div>
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-row">
                            <div class="info-icon">
                                <i class="bi bi-calendar2-check"></i>
                            </div>
                            <div>
                                <div class="info-label">Fecha de finalización</div>
                                <div class="info-value">@fechaFin</div>
                            </div>
                        </div>
                    </div>

                    <div class="detail-actions">
                        <a href="@Url.Action("Index", "Eventos")" class="btn btn-outline-secondary btn-detail">
                            <i class="bi bi-arrow-left me-1"></i> Volver
                        </a>

                        <a href="@Url.Action("Contacto", "Eventos", new { id = evento.Id })" class="btn btn-outline-success btn-detail">
                            <i class="bi bi-chat-dots me-1"></i> Ver contacto
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="detail-section">
                    <div class="reserve-panel">
                        <h3 class="reserve-title">Reservar evento</h3>
                        <div class="reserve-sub">Gestiona tu participación según la disponibilidad actual.</div>

                        <span class="availability-pill @(sinCupos ? "availability-none" : "availability-ok")">
                            <i class="bi bi-people"></i>
                            @(sinCupos ? "No hay cupos disponibles" : ("Cupos disponibles: " + evento.CuposDisponibles))
                        </span>

                        <div class="reserve-note">
                            <strong>Límite por persona:</strong> @limitePorPersona entrada@(limitePorPersona > 1 ? "s" : "").
                        </div>

                        <div class="reserve-limit-box">
                            Si ya reservaste antes para este mismo evento, el sistema sumará tu reserva anterior con la nueva y no te dejará superar el límite permitido.
                        </div>

                        @if (User.Identity.IsAuthenticated)
                        {
                            using (Html.BeginForm("Reservar", "Eventos", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="EventoId" value="@evento.Id" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Cantidad de personas</label>
                                    <input type="number"
                                           name="NumeroPersonas"
                                           min="1"
                                           max="@limitePorPersona"
                                           value="1"
                                           class="form-control"
                                           required
                                           oninput="if(parseInt(this.value || '0') > @limitePorPersona){ this.value='@limitePorPersona'; }" />
                                </div>

                                <button type="submit"
                                        class="btn btn-success btn-detail w-100"
                                        @(sinCupos ? "disabled" : "")>
                                    <i class="bi bi-calendar-check me-1"></i> Reservar
                                </button>
                            }
                        }
                        else
                        {
                            <p class="text-login-note mb-3">Inicia sesión para reservar este evento.</p>
                            <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Detalle", "Eventos", new { id = evento.Id }) })"
                               class="btn btn-success btn-detail w-100">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                            </a>
                        }

                        <hr class="my-4 divider-soft" />

                        <div class="info-box mb-3">
                            <div class="info-row">
                                <div class="info-icon">
                                    <i class="bi bi-telephone"></i>
                                </div>
                                <div>
                                    <div class="info-label">Teléfono</div>
                                    <div class="info-value">@telefono</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            @if (!string.IsNullOrWhiteSpace(whatsapp))
                            {
                                <a href="@whatsapp" target="_blank" class="btn btn-outline-success btn-detail">
                                    <i class="bi bi-whatsapp me-1"></i> Abrir WhatsApp
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(sitioWeb))
                            {
                                <a href="@(sitioWeb.StartsWith("http") ? sitioWeb : "http://" + sitioWeb)"
                                   target="_blank"
                                   class="btn btn-outline-dark btn-detail">
                                    <i class="bi bi-globe me-1"></i> Visitar sitio web
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>