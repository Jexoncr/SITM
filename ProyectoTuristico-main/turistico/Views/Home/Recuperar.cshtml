@{
    ViewBag.Title = "Recuperar acceso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .recover-shell {
        min-height: calc(100vh - 240px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .recover-card {
        width: 100%;
        max-width: 760px;
        border: 1px solid rgba(15,23,42,.08);
        border-radius: 28px;
        background: #fff;
        box-shadow: 0 18px 42px rgba(15,23,42,.06);
        overflow: hidden;
    }

    .recover-head {
        background: linear-gradient(135deg, #0f3d2e 0%, #145544 100%);
        color: #fff;
        padding: 2rem;
    }

        .recover-head h2 {
            font-weight: 900;
            margin-bottom: .45rem;
        }

        .recover-head p {
            margin: 0;
            color: rgba(255,255,255,.82);
        }

    .recover-body {
        padding: 2rem;
    }

    .recover-box {
        border: 1px dashed rgba(15,23,42,.14);
        border-radius: 20px;
        padding: 1.2rem;
        background: #f8fafc;
        color: #475569;
        line-height: 1.75;
    }

    .recover-actions .btn {
        border-radius: 999px;
        font-weight: 800;
        padding: .85rem 1.2rem;
    }
</style>

<div class="container recover-shell">
    <div class="recover-card">
        <div class="recover-head">
            <h2><i class="bi bi-key me-2"></i>Recuperar acceso</h2>
            <p>Espacio reservado para recuperación de credenciales del sistema.</p>
        </div>

        <div class="recover-body">
            <div class="recover-box">
                La funcionalidad de recuperación de contraseña puede integrarse posteriormente con correo electrónico y validación de identidad. Por ahora, este espacio funciona como referencia visual dentro del sistema.
            </div>

            <div class="recover-actions mt-4 d-flex flex-wrap gap-2">
                <a href="@Url.Action("Login", "Account")" class="btn btn-success">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Ir a iniciar sesión
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                    <i class="bi bi-house-door me-1"></i> Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>