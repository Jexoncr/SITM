@model turistico.Models.PaginacionVM<turistico.Controllers.UsuarioRowVM>

@{
    ViewBag.Title = "Administrar usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var vm = Model ?? new turistico.Models.PaginacionVM<turistico.Controllers.UsuarioRowVM>();
    var usuarios = vm.Items ?? new List<turistico.Controllers.UsuarioRowVM>();
    var q = (ViewBag.Query ?? "").ToString();
}

<style>
    :root {
        --au-green-900: #0f3d2e;
        --au-green-800: #145544;
        --au-green-soft: rgba(20,85,68,.08);
        --au-ink: #0f172a;
        --au-muted: #64748b;
        --au-card: rgba(255,255,255,.97);
        --au-shadow: 0 20px 48px rgba(15,23,42,.08);
        --au-shadow-soft: 0 10px 24px rgba(15,23,42,.05);
        --au-radius-xl: 28px;
    }

    .admin-users-shell {
        display: grid;
        gap: 1rem;
    }

    .admin-users-hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--au-radius-xl);
        padding: 1.8rem 1.25rem 1.55rem;
        background: radial-gradient(circle at top right, rgba(46,158,127,.12), transparent 28%), linear-gradient(135deg, #ffffff 0%, #f7fbf8 55%, #eef7f2 100%);
        border: 1px solid rgba(15,23,42,.06);
        box-shadow: 0 18px 42px rgba(15,23,42,.06);
    }

        .admin-users-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(20,85,68,.04), transparent 24%);
            pointer-events: none;
        }

    .admin-users-hero-inner {
        position: relative;
        z-index: 2;
    }

    .admin-users-badge {
        display: inline-flex;
        align-items: center;
        gap: .42rem;
        padding: .5rem .82rem;
        border-radius: 999px;
        background: rgba(20,85,68,.08);
        color: var(--au-green-800);
        border: 1px solid rgba(20,85,68,.10);
        font-weight: 800;
        font-size: .8rem;
        margin-bottom: .75rem;
    }

    .admin-users-title {
        margin: 0 0 .45rem;
        color: var(--au-ink);
        font-weight: 950;
        line-height: 1.04;
        letter-spacing: -.03em;
        font-size: clamp(1.9rem, 2.8vw, 2.8rem);
    }

    .admin-users-sub {
        margin: 0;
        color: var(--au-muted);
        line-height: 1.78;
        max-width: 860px;
        font-size: .94rem;
    }

    .admin-users-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .7rem;
        margin-top: 1rem;
    }

    .btn-admin-users {
        border-radius: 999px;
        font-weight: 850;
        padding: .78rem 1rem;
        font-size: .84rem;
    }

    .admin-users-card {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: var(--au-radius-xl);
        background: var(--au-card);
        box-shadow: var(--au-shadow);
        overflow: hidden;
    }

    .admin-users-head {
        padding: 1rem 1.05rem;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.96));
    }

    .admin-users-head-title {
        margin: 0;
        color: var(--au-ink);
        font-weight: 950;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

    .admin-users-head-sub {
        margin-top: .2rem;
        color: var(--au-muted);
        font-size: .84rem;
        line-height: 1.6;
    }

    .filter-wrap {
        padding: 1rem 1.05rem 0;
    }

    .filter-card {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 20px;
        background: linear-gradient(180deg, rgba(248,250,252,.78), rgba(255,255,255,1));
        padding: 1rem;
        box-shadow: var(--au-shadow-soft);
    }

    .form-label {
        font-weight: 900;
        color: var(--au-ink);
        font-size: .82rem;
        margin-bottom: .45rem;
    }

    .form-control {
        border-radius: 14px;
        min-height: 46px;
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: none !important;
        font-size: .9rem;
    }

    .table-wrap {
        overflow-x: auto;
        padding: 1rem 1.05rem 1.05rem;
    }

    .admin-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 1000px;
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
    }

        .admin-table th, .admin-table td {
            padding: .95rem 1rem;
            border-bottom: 1px solid rgba(15,23,42,.06);
            vertical-align: middle;
        }

        .admin-table th {
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #475569;
            font-weight: 900;
            background: #fbfcfd;
            white-space: nowrap;
        }

        .admin-table td {
            font-size: .9rem;
            color: #0f172a;
        }

        .admin-table tr:last-child td {
            border-bottom: none;
        }

    .user-cell {
        display: flex;
        align-items: center;
        gap: .8rem;
        min-width: 240px;
    }

    .user-avatar {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        background: rgba(20,85,68,.08);
        color: #145544;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 950;
        flex: 0 0 auto;
        border: 1px solid rgba(20,85,68,.10);
    }

    .user-name {
        font-weight: 900;
        color: var(--au-ink);
        margin-bottom: .12rem;
        font-size: .92rem;
    }

    .user-sub {
        color: var(--au-muted);
        font-size: .8rem;
        line-height: 1.55;
    }

    .soft-pill {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .42rem .7rem;
        border-radius: 999px;
        font-size: .76rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .pill-role {
        background: rgba(59,130,246,.10);
        color: #1d4ed8;
        margin: .15rem .25rem .15rem 0;
    }

    .pill-ok {
        background: rgba(22,163,74,.10);
        color: #166534;
    }

    .pill-bad {
        background: rgba(220,53,69,.12);
        color: #b42318;
    }

    .action-set {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        justify-content: flex-end;
    }

    .btn-row {
        border-radius: 999px;
        font-weight: 800;
        font-size: .78rem;
        padding: .58rem .84rem;
        white-space: nowrap;
    }

    .btn-delete-soft {
        border: 1px solid rgba(220,53,69,.18);
        background: rgba(220,53,69,.06);
        color: #b42318;
    }

    .pager-stage {
        padding: 0 1.05rem 1.2rem;
    }

    .pager-card {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(248,250,252,.78), rgba(255,255,255,1));
        box-shadow: var(--au-shadow-soft);
        padding: 1rem;
    }

    .pager-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: .9rem;
    }

    .pager-info {
        color: var(--au-muted);
        font-size: .88rem;
        font-weight: 700;
    }

    .pager-track {
        width: 100%;
        height: 10px;
        background: #eef2f7;
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .pager-track-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #145544, #36c28d);
    }

    .pager-rail {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        align-items: center;
    }

    .pager-chip {
        min-width: 42px;
        height: 42px;
        padding: 0 .9rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: 800;
        font-size: .84rem;
        border: 1px solid rgba(15,23,42,.08);
        background: #fff;
        color: #0f172a;
        box-shadow: var(--au-shadow-soft);
        transition: all .18s ease;
    }

        .pager-chip:hover {
            text-decoration: none;
            color: #145544;
            border-color: rgba(20,85,68,.18);
            transform: translateY(-1px);
        }

        .pager-chip.active {
            background: linear-gradient(135deg, #145544, #1f8a6c);
            color: #fff;
            border-color: #145544;
        }

        .pager-chip.ghost {
            background: rgba(20,85,68,.08);
            color: #145544;
        }

        .pager-chip.disabled {
            pointer-events: none;
            opacity: .45;
        }

    .empty-shell {
        padding: 2.6rem 1.2rem;
        text-align: center;
        background: linear-gradient(180deg, rgba(248,250,252,.78), rgba(255,255,255,1));
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto .95rem;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(20,85,68,.08);
        color: var(--au-green-800);
        font-size: 1.8rem;
    }

    .empty-shell h4 {
        color: var(--au-ink);
        font-weight: 950;
        margin-bottom: .35rem;
    }

    .empty-shell p {
        color: var(--au-muted);
        margin: 0;
        font-size: .9rem;
    }

    .sitm-toast-wrap {
        position: fixed;
        top: 18px;
        right: 18px;
        z-index: 3000;
        display: grid;
        gap: .75rem;
        width: min(480px, calc(100vw - 36px));
    }

    .sitm-toast {
        border-radius: 20px;
        padding: 1rem 1rem;
        box-shadow: 0 20px 45px rgba(15,23,42,.16);
        border: 1px solid rgba(255,255,255,.14);
        color: #fff;
        animation: sitmToastIn .24s ease;
    }

        .sitm-toast.ok {
            background: linear-gradient(135deg, #145544, #1f8a6c);
        }

        .sitm-toast.err {
            background: linear-gradient(135deg, #991b1b, #dc2626);
        }

        .sitm-toast.warn {
            background: linear-gradient(135deg, #92400e, #f59e0b);
        }

    .sitm-toast-title {
        font-weight: 900;
        margin-bottom: .18rem;
    }

    .sitm-toast-text {
        opacity: .95;
        line-height: 1.55;
        font-size: .92rem;
        word-break: break-word;
    }

    .sitm-password-box {
        margin-top: .7rem;
        padding: .8rem;
        border-radius: 16px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.22);
    }

    .sitm-password-label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        margin-bottom: .35rem;
        opacity: .92;
    }

    .sitm-password-row {
        display: flex;
        gap: .55rem;
        align-items: center;
    }

    .sitm-password-value {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: none;
        border-radius: 12px;
        padding: .72rem .85rem;
        background: rgba(255,255,255,.92);
        color: #0f172a;
        font-weight: 900;
        font-size: .95rem;
    }

    .sitm-copy-btn {
        border: 0;
        border-radius: 12px;
        padding: .72rem .9rem;
        font-weight: 900;
        background: #fff;
        color: #92400e;
        min-width: 110px;
        transition: .18s ease;
    }

    @@keyframes sitmToastIn {
        from {
            opacity: 0;
            transform: translateY(-8px) scale(.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .sitm-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.42);
        z-index: 2990;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

        .sitm-modal-backdrop.show {
            display: flex;
        }

    .sitm-modal {
        width: min(520px, 100%);
        border-radius: 26px;
        background: #fff;
        box-shadow: 0 30px 80px rgba(15,23,42,.24);
        overflow: hidden;
        border: 1px solid rgba(15,23,42,.08);
    }

    .sitm-modal-head {
        padding: 1rem 1.1rem;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.98));
    }

    .sitm-modal-title {
        margin: 0;
        font-weight: 950;
        color: #0f172a;
        font-size: 1.02rem;
    }

    .sitm-modal-body {
        padding: 1rem 1.1rem;
        color: #475569;
        line-height: 1.75;
        font-size: .94rem;
    }

    .sitm-modal-actions {
        padding: 0 1.1rem 1.1rem;
        display: flex;
        gap: .7rem;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .sitm-modal-btn {
        border-radius: 999px;
        font-weight: 800;
        padding: .75rem 1rem;
    }
</style>

<div class="admin-users-shell">
    <section class="admin-users-hero">
        <div class="admin-users-hero-inner">
            <span class="admin-users-badge">
                <i class="bi bi-people"></i> Gestión de cuentas
            </span>

            <h1 class="admin-users-title">Administrar usuarios</h1>
            <p class="admin-users-sub">
                Gestión de cuentas del sistema con roles, estados de acceso y acciones administrativas.
            </p>

            <div class="admin-users-actions">
                <a href="@Url.Action("Create", "AdminUsuarios")" class="btn btn-success btn-admin-users">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo usuario
                </a>
            </div>
        </div>
    </section>

    <div class="admin-users-card">
        <div class="admin-users-head">
            <h2 class="admin-users-head-title">
                <i class="bi bi-table"></i> Listado de usuarios
            </h2>
            <div class="admin-users-head-sub">
                Consulta, busca y administra las cuentas registradas.
            </div>
        </div>

        <div class="filter-wrap">
            @using (Html.BeginForm("Index", "AdminUsuarios", FormMethod.Get))
            {
                <div class="filter-card">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-lg-9">
                            <label class="form-label">Buscar</label>
                            <input type="text" name="q" value="@q" class="form-control" placeholder="Correo, nombre o apellido..." />
                        </div>

                        <div class="col-12 col-lg-3">
                            <button type="submit" class="btn btn-success btn-admin-users w-100">
                                <i class="bi bi-search me-1"></i> Buscar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (usuarios.Any())
        {
            <div class="table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Roles</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in usuarios)
                        {
                            var nombreCompleto = ((u.Nombre ?? "") + " " + (u.Apellido ?? "")).Trim();
                            if (string.IsNullOrWhiteSpace(nombreCompleto))
                            {
                                nombreCompleto = "Usuario";
                            }

                            var inicial = nombreCompleto.Substring(0, 1).ToUpper();

                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar">@inicial</div>
                                        <div>
                                            <div class="user-name">@nombreCompleto</div>
                                            <div class="user-sub">ID: @u.Id</div>
                                        </div>
                                    </div>
                                </td>

                                <td>@u.Email</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "No disponible" : u.PhoneNumber)
                                </td>

                                <td>
                                    @if (u.Roles != null && u.Roles.Any())
                                    {
                                        foreach (var rol in u.Roles)
                                        {
                                            <span class="soft-pill pill-role">
                                                <i class="bi bi-shield"></i> @rol
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin roles</span>
                                    }
                                </td>

                                <td>
                                    @if (u.Bloqueado)
                                    {
                                        <span class="soft-pill pill-bad">
                                            <i class="bi bi-lock"></i> Bloqueado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="soft-pill pill-ok">
                                            <i class="bi bi-check-circle"></i> Activo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="action-set">
                                        <a href="@Url.Action("Edit", "AdminUsuarios", new { id = u.Id })"
                                           class="btn btn-outline-success btn-row">
                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </a>

                                        <button type="button"
                                                class="btn btn-row btn-delete-soft js-delete-user"
                                                data-id="@u.Id"
                                                data-name="@nombreCompleto"
                                                data-url="@Url.Action("Delete", "AdminUsuarios")">
                                            <i class="bi bi-trash3 me-1"></i> Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            if (vm.TotalPaginas > 1)
            {
                var progreso = vm.TotalPaginas > 0 ? ((decimal)vm.PaginaActual / vm.TotalPaginas) * 100m : 0m;
                var prevDisabled = vm.PaginaActual <= 1 ? "disabled" : "";
                var nextDisabled = vm.PaginaActual >= vm.TotalPaginas ? "disabled" : "";

                <div class="pager-stage">
                    <div class="pager-card">
                        <div class="pager-top">
                            <div class="pager-info">
                                Página @vm.PaginaActual de @vm.TotalPaginas · @vm.TotalRegistros registro(s) · @vm.RegistrosPorPagina por página
                            </div>
                            <div class="pager-info">
                                Progreso visual: @progreso.ToString("0")%
                            </div>
                        </div>

                        <div class="pager-track">
                            <div class="pager-track-fill" style="width:@progreso.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>

                        <div class="pager-rail">
                            <a class="pager-chip ghost @prevDisabled"
                               href="@Url.Action("Index", "AdminUsuarios", new { q = q, pagina = vm.PaginaActual - 1 })">
                                <i class="bi bi-arrow-left"></i>
                            </a>

                            @for (int i = 1; i <= vm.TotalPaginas; i++)
                            {
                                var active = i == vm.PaginaActual ? "active" : "";
                                if (i == 1 || i == vm.TotalPaginas || Math.Abs(i - vm.PaginaActual) <= 1)
                                {
                                    <a class="pager-chip @active"
                                       href="@Url.Action("Index", "AdminUsuarios", new { q = q, pagina = i })">
                                        @i
                                    </a>
                                }
                                else if (i == vm.PaginaActual - 2 || i == vm.PaginaActual + 2)
                                {
                                    <span class="pager-chip ghost">…</span>
                                }
                            }

                            <a class="pager-chip ghost @nextDisabled"
                               href="@Url.Action("Index", "AdminUsuarios", new { q = q, pagina = vm.PaginaActual + 1 })">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-shell">
                <div class="empty-icon">
                    <i class="bi bi-person-x"></i>
                </div>
                <h4>No hay usuarios registrados</h4>
            </div>
        }
    </div>
</div>

<div id="sitmToastWrap" class="sitm-toast-wrap"></div>

<div id="sitmDeleteModal" class="sitm-modal-backdrop">
    <div class="sitm-modal">
        <div class="sitm-modal-head">
            <h3 class="sitm-modal-title">Confirmar eliminación</h3>
        </div>
        <div class="sitm-modal-body" id="sitmDeleteModalText"></div>
        <div class="sitm-modal-actions">
            <button type="button" class="btn btn-outline-secondary sitm-modal-btn" id="sitmCancelDelete">Cancelar</button>
            <button type="button" class="btn btn-danger sitm-modal-btn" id="sitmConfirmDelete">Sí, eliminar</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        (function () {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';
            const toastWrap = document.getElementById('sitmToastWrap');
            const modal = document.getElementById('sitmDeleteModal');
            const modalText = document.getElementById('sitmDeleteModalText');
            const btnCancel = document.getElementById('sitmCancelDelete');
            const btnConfirm = document.getElementById('sitmConfirmDelete');

            let currentDelete = null;

            function showToast(type, title, text, delay, passwordValue) {
                const el = document.createElement('div');
                el.className = 'sitm-toast ' + (type || 'ok');

                let html = '<div class="sitm-toast-title">' + title + '</div>' +
                           '<div class="sitm-toast-text">' + text + '</div>';

                if (passwordValue) {
                    const safeValue = (passwordValue || '').replace(/"/g, '&quot;');
                    html += '<div class="sitm-password-box">' +
                                '<span class="sitm-password-label">Contraseña temporal</span>' +
                                '<div class="sitm-password-row">' +
                                    '<input class="sitm-password-value" type="text" readonly value="' + safeValue + '" />' +
                                    '<button type="button" class="sitm-copy-btn">Copiar</button>' +
                                '</div>' +
                            '</div>';
                }

                el.innerHTML = html;
                toastWrap.appendChild(el);

                const copyBtn = el.querySelector('.sitm-copy-btn');
                const passInput = el.querySelector('.sitm-password-value');

                if (copyBtn && passInput) {
                    copyBtn.addEventListener('click', async function () {
                        try {
                            await navigator.clipboard.writeText(passInput.value);
                            copyBtn.textContent = 'Copiado';
                        } catch (e) {
                            passInput.select();
                            document.execCommand('copy');
                            copyBtn.textContent = 'Copiado';
                        }

                        setTimeout(function () {
                            copyBtn.textContent = 'Copiar';
                        }, 1800);
                    });
                }

                setTimeout(function () {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(-6px)';
                    setTimeout(function () { el.remove(); }, 250);
                }, delay || 5000);
            }

            function openDeleteModal(cfg) {
                currentDelete = cfg;
                modalText.innerHTML = 'Vas a eliminar <strong>' + cfg.name + '</strong>.<br><br>Si la cuenta tiene datos relacionados, la operación puede ser rechazada.';
                modal.classList.add('show');
            }

            function closeDeleteModal() {
                modal.classList.remove('show');
                currentDelete = null;
            }

            document.querySelectorAll('.js-delete-user').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openDeleteModal({
                        id: this.getAttribute('data-id'),
                        name: this.getAttribute('data-name'),
                        url: this.getAttribute('data-url')
                    });
                });
            });

            btnCancel.addEventListener('click', closeDeleteModal);
            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeDeleteModal();
            });

            btnConfirm.addEventListener('click', function () {
                if (!currentDelete) return;

                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('id', currentDelete.id);

                fetch(currentDelete.url, {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin'
                })
                .then(function (r) {
                    if (r.ok) {
                        showToast('ok', 'Usuario eliminado', 'La operación se ejecutó correctamente.');
                        setTimeout(function () { window.location.reload(); }, 700);
                        return;
                    }

                    showToast('err', 'No se pudo eliminar', 'La cuenta tiene información relacionada o hubo una restricción de seguridad.');
                })
                .catch(function () {
                    showToast('err', 'No se pudo eliminar', 'La cuenta no se puede eliminar por relaciones existentes o un error interno.');
                })
                .finally(function () {
                    closeDeleteModal();
                });
            });

            @if (TempData["Ok"] != null)
            {
                <text>showToast('ok', 'Operación completada', '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Ok"].ToString()))', 5000);</text>
            }

            @if (TempData["Err"] != null)
            {
                <text>showToast('err', 'Ocurrió un problema', '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Err"].ToString()))', 7000);</text>
            }

            @if (TempData["TempPasswordTitle"] != null && TempData["TempPasswordText"] != null && TempData["TempPasswordValue"] != null)
            {
                <text>showToast(
                    'warn',
                    '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["TempPasswordTitle"].ToString()))',
                    '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["TempPasswordText"].ToString()))',
                    9000,
                    '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["TempPasswordValue"].ToString()))'
                );</text>
            }
        })();
    </script>
}