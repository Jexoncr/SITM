@model turistico.Models.RegisterVM

@{
    ViewBag.Title = "Crear Cuenta";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<style>
    .auth-shell {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at top left, rgba(34,197,94,.06), transparent 20%), #f4f8f5;
        padding: 2rem 1rem;
    }

    .auth-card {
        width: 100%;
        max-width: 540px;
        border: 0;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(15,23,42,.08);
    }

        .auth-card .card-body {
            padding: 2rem;
        }

    .auth-brand {
        text-align: center;
        margin-bottom: 1.6rem;
    }

        .auth-brand h3 {
            font-weight: 900;
            color: #198754;
            margin-bottom: .2rem;
        }

        .auth-brand p {
            color: #64748b;
            margin: 0;
        }

    .auth-btn {
        font-weight: 800;
        border-radius: 999px;
        padding: .8rem 1rem;
    }
</style>

<div class="auth-shell">
    <div class="card auth-card">
        <div class="card-body">
            <div class="auth-brand">
                <h3>SITM</h3>
                <p>Crea tu cuenta para acceder al portal</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-4">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Nombre</label>
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Nombre" })
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Apellido</label>
                        @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control", placeholder = "Apellido" })
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Correo electrónico</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "correo@ejemplo.com" })
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Teléfono</label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "8888-8888" })
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Contraseña</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Contraseña" })
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Confirmar contraseña</label>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirmar contraseña" })
                    </div>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-success auth-btn">
                        Crear cuenta
                    </button>
                </div>
            }

            <div class="text-center mt-4">
                <small class="text-muted">
                    ¿Ya tienes cuenta?
                    <a href="@Url.Action("Login","Account")" class="text-success text-decoration-none fw-semibold">Inicia sesión</a>
                </small>
            </div>
        </div>
    </div>
</div>