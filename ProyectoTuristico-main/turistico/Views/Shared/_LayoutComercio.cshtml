@using System
@using Microsoft.AspNet.Identity

@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    var currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();

    Func<string, string, string> navClass = (controller, action) =>
    {
        var active = currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
                     && (string.IsNullOrWhiteSpace(action) || currentAction.Equals(action, StringComparison.OrdinalIgnoreCase));
        return active ? "trade-nav-link active" : "trade-nav-link";
    };

    var displayName = User != null && User.Identity != null && User.Identity.IsAuthenticated
        ? User.Identity.GetUserName()
        : "Comercio";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Panel Comercio</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --tc-green-950: #0a241c;
            --tc-green-900: #0f3d2e;
            --tc-green-800: #145544;
            --tc-green-700: #1b6b55;
            --tc-soft: rgba(20,85,68,.08);
            --tc-border: rgba(15,23,42,.08);
            --tc-ink: #0f172a;
            --tc-muted: #64748b;
            --tc-bg: #f5f8f7;
            --tc-card: rgba(255,255,255,.96);
            --tc-shadow: 0 18px 44px rgba(15,23,42,.08);
            --tc-shadow-soft: 0 10px 24px rgba(15,23,42,.05);
            --tc-sidebar: 286px;
            --tc-topbar: 84px;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at top left, rgba(20,85,68,.06), transparent 26%), radial-gradient(circle at top right, rgba(46,158,127,.07), transparent 20%), linear-gradient(180deg, #fbfdfc 0%, #f4f8f6 52%, #eef4f1 100%);
            color: var(--tc-ink);
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .trade-shell {
            display: flex;
            min-height: 100vh;
        }

        .trade-sidebar {
            width: var(--tc-sidebar);
            background: linear-gradient(180deg, rgba(10,36,28,.99) 0%, rgba(15,61,46,.98) 100%);
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 1040;
            display: flex;
            flex-direction: column;
            box-shadow: 12px 0 30px rgba(15,23,42,.12);
        }

        .trade-sidebar-top {
            padding: 1.35rem 1.05rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .trade-brand {
            display: flex;
            align-items: center;
            gap: .82rem;
        }

        .trade-brand-icon {
            width: 52px;
            height: 52px;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.08));
            border: 1px solid rgba(255,255,255,.14);
            color: #fff;
            font-size: 1.2rem;
            flex: 0 0 auto;
        }

        .trade-brand-title {
            margin: 0;
            color: #fff;
            font-size: 1.08rem;
            font-weight: 950;
            line-height: 1.1;
            letter-spacing: -.02em;
        }

        .trade-brand-sub {
            margin-top: .2rem;
            color: rgba(255,255,255,.72);
            font-size: .8rem;
            line-height: 1.4;
        }

        .trade-user {
            margin-top: 1rem;
            padding: .9rem .95rem;
            border-radius: 18px;
            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.08);
        }

        .trade-user-label {
            font-size: .72rem;
            color: rgba(255,255,255,.65);
            text-transform: uppercase;
            letter-spacing: .08em;
            font-weight: 800;
            margin-bottom: .28rem;
        }

        .trade-user-name {
            color: #fff;
            font-size: .95rem;
            font-weight: 850;
            line-height: 1.35;
            word-break: break-word;
        }

        .trade-user-sub {
            color: rgba(255,255,255,.68);
            font-size: .78rem;
            margin-top: .12rem;
        }

        .trade-nav {
            padding: 1rem .85rem;
            overflow-y: auto;
            flex: 1;
        }

        .trade-nav-group {
            margin-bottom: 1rem;
        }

        .trade-nav-group-label {
            color: rgba(255,255,255,.56);
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            font-weight: 800;
            margin: 0 0 .55rem .45rem;
        }

        .trade-nav-link {
            display: flex;
            align-items: center;
            gap: .8rem;
            padding: .85rem .92rem;
            border-radius: 16px;
            color: rgba(255,255,255,.84);
            text-decoration: none;
            font-weight: 700;
            font-size: .9rem;
            margin-bottom: .28rem;
            border: 1px solid transparent;
            transition: all .18s ease;
        }

            .trade-nav-link:hover,
            .trade-nav-link:focus {
                color: #fff;
                text-decoration: none;
                background: rgba(255,255,255,.08);
                border-color: rgba(255,255,255,.08);
            }

            .trade-nav-link.active {
                color: #fff;
                background: linear-gradient(135deg, rgba(32,135,103,.92), rgba(20,85,68,.96));
                border-color: rgba(255,255,255,.08);
                box-shadow: 0 10px 20px rgba(0,0,0,.12);
            }

            .trade-nav-link i {
                width: 18px;
                text-align: center;
                flex: 0 0 auto;
                font-size: 1rem;
            }

        .trade-sidebar-bottom {
            padding: .95rem .85rem 1.05rem;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .trade-logout-btn {
            width: 100%;
            border: 1px solid rgba(255,255,255,.18);
            background: rgba(255,255,255,.08);
            color: #fff;
            border-radius: 16px;
            font-weight: 800;
            padding: .85rem 1rem;
            transition: all .18s ease;
        }

            .trade-logout-btn:hover {
                background: rgba(255,255,255,.14);
                color: #fff;
            }

        .trade-main {
            margin-left: var(--tc-sidebar);
            width: calc(100% - var(--tc-sidebar));
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .trade-topbar {
            position: sticky;
            top: 0;
            z-index: 1030;
            height: var(--tc-topbar);
            background: rgba(255,255,255,.78);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(15,23,42,.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.25rem;
        }

        .trade-topbar-left {
            display: flex;
            align-items: center;
            gap: .95rem;
            min-width: 0;
        }

        .trade-mobile-menu {
            display: none;
            border: 0;
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: rgba(20,85,68,.08);
            color: var(--tc-green-800);
            font-size: 1.2rem;
        }

        .trade-title-wrap {
            min-width: 0;
        }

        .trade-page-title {
            margin: 0;
            color: var(--tc-ink);
            font-size: 1.18rem;
            font-weight: 950;
            line-height: 1.14;
            letter-spacing: -.02em;
        }

        .trade-page-sub {
            color: var(--tc-muted);
            font-size: .82rem;
            margin-top: .16rem;
            line-height: 1.4;
        }

        .trade-topbar-right {
            display: flex;
            align-items: center;
            gap: .65rem;
            flex-wrap: wrap;
        }

        .trade-chip {
            display: inline-flex;
            align-items: center;
            gap: .42rem;
            padding: .56rem .85rem;
            border-radius: 999px;
            background: rgba(20,85,68,.08);
            color: var(--tc-green-800);
            border: 1px solid rgba(20,85,68,.10);
            font-size: .8rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .trade-link-chip {
            display: inline-flex;
            align-items: center;
            gap: .42rem;
            padding: .68rem .92rem;
            border-radius: 999px;
            background: #fff;
            color: var(--tc-ink);
            text-decoration: none;
            border: 1px solid rgba(15,23,42,.08);
            font-size: .82rem;
            font-weight: 800;
            box-shadow: var(--tc-shadow-soft);
            white-space: nowrap;
        }

            .trade-link-chip:hover {
                color: var(--tc-green-800);
                text-decoration: none;
            }

        .trade-content {
            padding: 1.25rem;
            flex: 1;
        }

            .trade-content .alert {
                border-radius: 18px;
                border: 1px solid rgba(15,23,42,.06);
                box-shadow: var(--tc-shadow-soft);
                padding: .95rem 1rem;
                font-size: .9rem;
                font-weight: 700;
            }

        .trade-sidebar-backdrop {
            display: none;
        }

        @@media (max-width: 991.98px) {
            .trade-sidebar {
                transform: translateX(-100%);
                transition: transform .22s ease;
            }

                .trade-sidebar.show {
                    transform: translateX(0);
                }

            .trade-sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(15,23,42,.36);
                z-index: 1035;
            }

                .trade-sidebar-backdrop.show {
                    display: block;
                }

            .trade-main {
                margin-left: 0;
                width: 100%;
            }

            .trade-mobile-menu {
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .trade-chip {
                display: none;
            }
        }

        @@media (max-width: 575.98px) {
            .trade-topbar {
                padding: .9rem .85rem;
            }

            .trade-content {
                padding: .95rem;
            }

            .trade-page-title {
                font-size: 1rem;
            }

            .trade-page-sub {
                font-size: .77rem;
            }
        }
    </style>
</head>
<body>
    <div class="trade-shell">
        <aside id="tradeSidebar" class="trade-sidebar">
            <div class="trade-sidebar-top">
                <div class="trade-brand">
                    <div class="trade-brand-icon">
                        <i class="bi bi-shop-window"></i>
                    </div>
                    <div>
                        <h1 class="trade-brand-title">Panel Comercio</h1>
                        <div class="trade-brand-sub">Gestión de tu negocio</div>
                    </div>
                </div>

                <div class="trade-user">
                    <div class="trade-user-label">Sesión actual</div>
                    <div class="trade-user-name">@displayName</div>
                    <div class="trade-user-sub">Usuario comercio</div>
                </div>
            </div>

            <div class="trade-nav">
                <div class="trade-nav-group">
                    <div class="trade-nav-group-label">General</div>

                    <a href="@Url.Action("Dashboard","ComercioPanel")" class="@navClass("ComercioPanel","Dashboard")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>

                    <a href="@Url.Action("MiComercio","ComercioPanel")" class="@navClass("ComercioPanel","MiComercio")">
                        <i class="bi bi-shop"></i>
                        <span>Mi comercio</span>
                    </a>
                </div>

                <div class="trade-nav-group">
                    <div class="trade-nav-group-label">Gestión</div>

                    <a href="@Url.Action("MisEventos","ComercioPanel")" class="@navClass("ComercioPanel","MisEventos")">
                        <i class="bi bi-calendar-event"></i>
                        <span>Eventos</span>
                    </a>

                    <a href="@Url.Action("ReservasEventos","ComercioPanel")" class="@navClass("ComercioPanel","ReservasEventos")">
                        <i class="bi bi-bookmark-check"></i>
                        <span>Reservas</span>
                    </a>

                    <a href="@Url.Action("MisResenas","ComercioPanel")" class="@navClass("ComercioPanel","MisResenas")">
                        <i class="bi bi-chat-square-heart"></i>
                        <span>Reseñas</span>
                    </a>
                </div>
            </div>

            <div class="trade-sidebar-bottom">
                <a href="@Url.Action("Index","Home")" class="trade-nav-link">
                    <i class="bi bi-globe2"></i>
                    <span>Ver sitio</span>
                </a>

                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "m-0 mt-2" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="trade-logout-btn">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Cerrar sesión
                    </button>
                }
            </div>
        </aside>

        <div id="tradeSidebarBackdrop" class="trade-sidebar-backdrop"></div>

        <main class="trade-main">
            <header class="trade-topbar">
                <div class="trade-topbar-left">
                    <button id="tradeMobileMenu" type="button" class="trade-mobile-menu" aria-label="Abrir menú">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="trade-title-wrap">
                        <h2 class="trade-page-title">@ViewBag.Title</h2>
                        <div class="trade-page-sub">Panel de gestión comercial del SITM</div>
                    </div>
                </div>

                <div class="trade-topbar-right">
                    <span class="trade-chip">
                        <i class="bi bi-shop"></i> Comercio
                    </span>

                    <a href="@Url.Action("CrearEvento","ComercioPanel")" class="trade-link-chip">
                        <i class="bi bi-plus-circle"></i> Crear evento
                    </a>
                </div>
            </header>

            <section class="trade-content">
                @Html.Partial("_Alerts")
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            var btn = document.getElementById('tradeMobileMenu');
            var sidebar = document.getElementById('tradeSidebar');
            var backdrop = document.getElementById('tradeSidebarBackdrop');

            if (!btn || !sidebar || !backdrop) return;

            function openSidebar() {
                sidebar.classList.add('show');
                backdrop.classList.add('show');
            }

            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            }

            btn.addEventListener('click', function () {
                if (sidebar.classList.contains('show')) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });

            backdrop.addEventListener('click', closeSidebar);

            window.addEventListener('resize', function () {
                if (window.innerWidth > 991) {
                    closeSidebar();
                }
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>