@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.Owin
@using turistico.Models

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - SITM</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --sitm-green-900: #0f3d2e;
            --sitm-green-800: #145544;
            --sitm-green-700: #1b6b55;
            --sitm-green-600: #1f8a6c;
            --sitm-green-100: #e9f6f0;
            --sitm-bg: #f5f8f7;
            --sitm-card: #ffffff;
            --sitm-text: #1f2937;
            --sitm-muted: #6b7280;
            --sitm-border: rgba(15, 23, 42, .08);
            --sitm-shadow: 0 16px 34px rgba(15, 23, 42, .08);
            --sitm-radius: 20px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
            background: var(--sitm-bg);
            color: var(--sitm-text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            text-decoration: none;
        }

        .sitm-navbar {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: linear-gradient(135deg, rgba(15,61,46,.94), rgba(27,107,85,.92));
            box-shadow: 0 10px 28px rgba(15, 23, 42, .14);
            backdrop-filter: blur(10px);
        }

        .sitm-brand {
            display: inline-flex;
            align-items: center;
            gap: .75rem;
            color: #fff !important;
            font-weight: 900;
            letter-spacing: .3px;
            font-size: 1.18rem;
        }

        .sitm-brand-badge {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.16);
            color: #fff;
            font-size: 1.05rem;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
        }

        .navbar-toggler {
            border: 1px solid rgba(255,255,255,.18);
            box-shadow: none !important;
        }

        .sitm-nav-center {
            display: flex;
            align-items: center;
            gap: .25rem;
            margin-left: 2rem;
        }

        .sitm-nav-link {
            color: rgba(255,255,255,.84) !important;
            padding: .72rem .88rem !important;
            border-radius: 14px;
            font-weight: 700;
            transition: all .2s ease;
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            font-size: .98rem;
        }

            .sitm-nav-link:hover {
                color: #fff !important;
                background: rgba(255,255,255,.10);
                transform: translateY(-1px);
            }

            .sitm-nav-link.active {
                color: var(--sitm-green-900) !important;
                background: #fff;
                box-shadow: 0 10px 20px rgba(0,0,0,.12);
            }

        .sitm-user-box {
            display: inline-flex;
            align-items: center;
            gap: .7rem;
            padding: .42rem .55rem .42rem .42rem;
            border-radius: 999px;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.14);
            color: #fff;
            min-width: 0;
        }

        .sitm-user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.16);
            color: #fff;
            flex: 0 0 auto;
        }

        .sitm-user-meta {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .sitm-user-name {
            font-weight: 800;
            color: #fff;
            font-size: .92rem;
            line-height: 1.1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 170px;
        }

        .sitm-user-role {
            color: rgba(255,255,255,.72);
            font-size: .76rem;
            line-height: 1.1;
        }

        .sitm-nav-actions {
            display: flex;
            align-items: center;
            gap: .65rem;
            margin-left: 1rem;
        }

        .sitm-nav-cta {
            border-radius: 999px;
            font-weight: 800;
            padding: .72rem 1rem;
            border: 1px solid rgba(255,255,255,.18);
            transition: all .2s ease;
            white-space: nowrap;
        }

            .sitm-nav-cta:hover {
                transform: translateY(-1px);
            }

        .sitm-btn-light {
            background: #fff;
            color: var(--sitm-green-900);
        }

            .sitm-btn-light:hover {
                background: #f7fffb;
                color: var(--sitm-green-900);
            }

        .sitm-btn-outline {
            background: rgba(255,255,255,.10);
            color: #fff;
        }

            .sitm-btn-outline:hover {
                background: rgba(255,255,255,.18);
                color: #fff;
            }

        .sitm-main {
            flex: 1 0 auto;
            padding-top: 1.25rem;
            padding-bottom: 3rem;
        }

        .sitm-footer {
            margin-top: auto;
            position: relative;
            background: radial-gradient(900px 500px at 20% -10%, rgba(31,138,108,.22), transparent 55%), radial-gradient(700px 450px at 100% 0%, rgba(31,138,108,.14), transparent 50%), linear-gradient(180deg, #0f3d2e 0%, #0c3427 100%);
            color: rgba(255,255,255,.88);
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .sitm-footer-top {
            padding: 3rem 0 1.3rem 0;
        }

        .sitm-footer-brand {
            display: inline-flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem .85rem;
            border-radius: 18px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: 0 12px 28px rgba(0,0,0,.12);
        }

        .sitm-footer-brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.10);
            color: #fff;
        }

        .sitm-footer-title {
            color: #fff;
            font-weight: 900;
            margin: 0;
            line-height: 1.1;
            font-size: 1.02rem;
        }

        .sitm-footer-sub {
            color: rgba(255,255,255,.72);
            margin: .2rem 0 0;
            font-size: .93rem;
        }

        .sitm-footer-text {
            margin-top: 1rem;
            color: rgba(255,255,255,.76);
            max-width: 42ch;
            line-height: 1.8;
        }

        .sitm-footer-heading {
            color: #fff;
            font-weight: 900;
            font-size: .95rem;
            margin-bottom: .9rem;
        }

        .sitm-footer-links {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: .55rem;
        }

            .sitm-footer-links a {
                color: rgba(255,255,255,.76);
                display: inline-flex;
                align-items: center;
                gap: .5rem;
                transition: all .2s ease;
            }

                .sitm-footer-links a:hover {
                    color: #fff;
                    transform: translateX(2px);
                }

        .sitm-contact-card {
            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 18px;
            padding: 1rem;
        }

        .sitm-contact-row {
            display: flex;
            gap: .75rem;
            align-items: flex-start;
            margin-bottom: .9rem;
        }

            .sitm-contact-row:last-child {
                margin-bottom: 0;
            }

            .sitm-contact-row i {
                margin-top: .15rem;
            }

        .sitm-footer-divider {
            border: 0;
            height: 1px;
            margin: 1.5rem 0 1rem 0;
            background: linear-gradient(90deg, rgba(255,255,255,.08), rgba(255,255,255,.18), rgba(255,255,255,.08));
        }

        .sitm-footer-bottom {
            padding: 1rem 0 1.35rem 0;
            color: rgba(255,255,255,.72);
            font-size: .92rem;
        }

        .sitm-footer-legal a {
            color: rgba(255,255,255,.72);
            transition: color .2s ease;
        }

            .sitm-footer-legal a:hover {
                color: #fff;
            }

        .sitm-social {
            display: inline-flex;
            gap: .6rem;
            justify-content: flex-end;
        }

            .sitm-social a {
                width: 40px;
                height: 40px;
                border-radius: 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(255,255,255,.10);
                transition: all .2s ease;
            }

                .sitm-social a:hover {
                    transform: translateY(-2px);
                    background: rgba(255,255,255,.14);
                }

        @@media (max-width: 1199.98px) {
            .sitm-user-name {
                max-width: 120px;
            }
        }

        @@media (max-width: 991.98px) {
            .sitm-nav-center {
                margin-left: 0;
                margin-top: .8rem;
                flex-direction: column;
                align-items: stretch;
                gap: .2rem;
            }

            .sitm-nav-link {
                width: 100%;
                justify-content: flex-start;
            }

            .sitm-nav-actions {
                margin-top: .9rem;
                margin-left: 0;
                width: 100%;
                display: grid;
                gap: .65rem;
            }

                .sitm-nav-actions .sitm-nav-cta,
                .sitm-nav-actions form,
                .sitm-nav-actions form button,
                .sitm-user-box {
                    width: 100%;
                }

            .sitm-user-name {
                max-width: none;
            }
        }

        @@media (max-width: 576px) {
            .sitm-main {
                padding-top: 1rem;
            }

            .sitm-footer-top {
                padding: 2.3rem 0 1rem;
            }

            .sitm-social {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    @{
        var controller = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
        var action = (ViewContext.RouteData.Values["action"] ?? "").ToString();

        Func<string, string, string> active = (ctrl, act) =>
            string.Equals(controller, ctrl, System.StringComparison.OrdinalIgnoreCase) &&
            string.Equals(action, act, System.StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

        var isAuth = Request.IsAuthenticated;
        var displayName = "";
        var userRoleLabel = "Usuario";

        if (isAuth)
        {
            var userManager = Context.GetOwinContext().GetUserManager<UserManager<ApplicationUser>>();
            var currentUserId = User.Identity.GetUserId();
            var currentUser = userManager.FindById(currentUserId);

            if (currentUser != null)
            {
                var nombreCompleto = ((currentUser.Nombre ?? "") + " " + (currentUser.Apellido ?? "")).Trim();
                displayName = string.IsNullOrWhiteSpace(nombreCompleto) ? currentUser.UserName : nombreCompleto;

                if (User.IsInRole("Admin"))
                {
                    userRoleLabel = "Administrador";
                }
                else if (User.IsInRole("Comercio"))
                {
                    userRoleLabel = "Comercio";
                }
                else
                {
                    userRoleLabel = "Usuario";
                }
            }
            else
            {
                displayName = User.Identity.GetUserName();
            }
        }
    }

    <nav class="navbar navbar-expand-lg navbar-dark sitm-navbar">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand sitm-brand" href="@Url.Action("Index", "Home")">
                <span class="sitm-brand-badge">
                    <i class="bi bi-buildings"></i>
                </span>
                <span>SITM</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSITM" aria-controls="navbarSITM" aria-expanded="false" aria-label="Menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSITM">
                <ul class="navbar-nav sitm-nav-center mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link sitm-nav-link @active("Home","Mapa")" href="@Url.Action("Mapa","Home")">
                            <i class="bi bi-map"></i> Mapa
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link sitm-nav-link @active("Eventos","Index")" href="@Url.Action("Index","Eventos")">
                            <i class="bi bi-calendar-event"></i> Eventos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link sitm-nav-link @active("Comercios","Index")" href="@Url.Action("Index","Comercios")">
                            <i class="bi bi-shop"></i> Comercios
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link sitm-nav-link @active("Resenas","Index")" href="@Url.Action("Index","Resenas")">
                            <i class="bi bi-chat-square-quote"></i> Reseñas
                        </a>
                    </li>

                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link sitm-nav-link @active("Home","Perfil")" href="@Url.Action("Perfil","Home")">
                                <i class="bi bi-person-circle"></i> Perfil
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link sitm-nav-link @active("Reservas","Index")" href="@Url.Action("Index","Reservas")">
                                <i class="bi bi-bookmark-check"></i> Mis reservas
                            </a>
                        </li>
                    }
                </ul>

                <div class="sitm-nav-actions ms-auto">
                    @if (isAuth)
                    {
                        <div class="sitm-user-box">
                            <span class="sitm-user-avatar">
                                <i class="bi bi-person"></i>
                            </span>

                            <span class="sitm-user-meta">
                                <span class="sitm-user-name">@displayName</span>
                                <span class="sitm-user-role">@userRoleLabel</span>
                            </span>
                        </div>

                        using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "m-0" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn sitm-nav-cta sitm-btn-outline">
                                <i class="bi bi-box-arrow-right me-1"></i> Salir
                            </button>
                        }
                    }
                    else
                    {
                        <a class="btn sitm-nav-cta sitm-btn-light" href="@Url.Action("Login","Account")">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="sitm-main">
        <div class="container-fluid px-3 px-lg-4">
            @if (ViewBag.HideAlerts == null || ViewBag.HideAlerts == false)
            {
                @Html.Partial("_Alerts")
            }
            @RenderBody()
        </div>
    </main>

    <footer class="sitm-footer">
        <div class="container">
            <div class="sitm-footer-top">
                <div class="row g-4">
                    <div class="col-12 col-lg-4">
                        <div class="sitm-footer-brand mb-3">
                            <div class="sitm-footer-brand-icon">
                                <i class="bi bi-building"></i>
                            </div>
                            <div>
                                <p class="sitm-footer-title">SITM</p>
                                <p class="sitm-footer-sub">Sistema de Información Turística Municipal</p>
                            </div>
                        </div>

                        <p class="sitm-footer-text">
                            Plataforma institucional para consultar comercios, eventos, reseñas y reservas dentro del portal turístico municipal.
                        </p>
                    </div>

                    <div class="col-6 col-lg-2">
                        <h6 class="sitm-footer-heading">Portal</h6>
                        <ul class="sitm-footer-links">
                            <li><a href="@Url.Action("Index","Home")"><i class="bi bi-house-door"></i> Inicio</a></li>
                            <li><a href="@Url.Action("Mapa","Home")"><i class="bi bi-map"></i> Mapa</a></li>
                            <li><a href="@Url.Action("Index","Eventos")"><i class="bi bi-calendar-event"></i> Eventos</a></li>
                            <li><a href="@Url.Action("Index","Comercios")"><i class="bi bi-shop"></i> Comercios</a></li>
                            <li><a href="@Url.Action("Index","Resenas")"><i class="bi bi-chat-square-quote"></i> Reseñas</a></li>
                        </ul>
                    </div>

                    <div class="col-6 col-lg-2">
                        <h6 class="sitm-footer-heading">Usuario</h6>
                        <ul class="sitm-footer-links">
                            <li><a href="@Url.Action("Perfil","Home")"><i class="bi bi-person-circle"></i> Perfil</a></li>
                            <li><a href="@Url.Action("Index","Reservas")"><i class="bi bi-bookmark-check"></i> Mis reservas</a></li>
                            <li><a href="@Url.Action("Login","Account")"><i class="bi bi-box-arrow-in-right"></i> Acceso</a></li>
                            <li><a href="@Url.Action("Contact","Home")"><i class="bi bi-envelope"></i> Contacto</a></li>
                        </ul>
                    </div>

                    <div class="col-12 col-lg-4">
                        <h6 class="sitm-footer-heading">Contacto municipal</h6>
                        <div class="sitm-contact-card">
                            <div class="sitm-contact-row">
                                <i class="bi bi-geo-alt"></i>
                                <div>
                                    <div class="fw-semibold text-white">Ubicación</div>
                                    <div class="text-white-50">San Carlos, Costa Rica</div>
                                </div>
                            </div>

                            <div class="sitm-contact-row">
                                <i class="bi bi-telephone"></i>
                                <div>
                                    <div class="fw-semibold text-white">Teléfono</div>
                                    <div class="text-white-50">+506 0000-0000</div>
                                </div>
                            </div>

                            <div class="sitm-contact-row">
                                <i class="bi bi-envelope"></i>
                                <div>
                                    <div class="fw-semibold text-white">Correo</div>
                                    <div class="text-white-50">sitm@municipalidad.go.cr</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="sitm-footer-divider" />

                <div class="sitm-footer-bottom">
                    <div class="row align-items-center g-3">
                        <div class="col-12 col-md-7">
                            <div class="d-flex flex-column flex-md-row gap-2 gap-md-3 align-items-md-center">
                                <span>© @DateTime.Now.Year SITM</span>
                                <span class="d-none d-md-inline text-white-50">•</span>
                                <div class="sitm-footer-legal d-flex flex-wrap gap-3">
                                    <a href="@Url.Action("About","Home")">Acerca del sistema</a>
                                    <a href="@Url.Action("Contact","Home")">Contacto</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-5">
                            <div class="sitm-social">
                                <a href="#" aria-label="Sitio web"><i class="bi bi-globe2"></i></a>
                                <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                                <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                                <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>