@model turistico.Models.PaginacionVM<turistico.Models.Evento>

@{
    ViewBag.Title = "Mis Eventos";
    Layout = "~/Views/Shared/_LayoutComercio.cshtml";
}

<style>
    .pager-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .pager-info {
        color: #64748b;
        font-weight: 600;
    }

    .pager-nav {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .pager-btn {
        min-width: 42px;
        height: 42px;
        padding: 0 1rem;
        border-radius: 999px;
        border: 1px solid rgba(15,23,42,.08);
        background: #fff;
        color: #0f172a;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .pager-btn.active {
            background: #145544;
            color: #fff;
            border-color: #145544;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold text-success mb-0">
        <i class="bi bi-calendar-event me-2"></i>Mis eventos
    </h2>

    <a href="@Url.Action("CrearEvento","ComercioPanel")" class="btn btn-success rounded-pill fw-bold">
        <i class="bi bi-plus-circle me-1"></i> Nuevo evento
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Nombre</th>
                        <th>Categoría</th>
                        <th>Fecha inicio</th>
                        <th>Fecha fin</th>
                        <th>Cupo</th>
                        <th>Límite por persona</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No tienes eventos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model.Items)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@e.Nombre</td>
                                <td>@(e.CategoriaEvento?.Nombre ?? "-")</td>
                                <td>@(e.FechaInicio.HasValue ? e.FechaInicio.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>@(e.FechaFin.HasValue ? e.FechaFin.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>@e.CupoMaximo</td>
                                <td>@e.LimitePorPersona</td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                                        <a href="@Url.Action("EditarEvento", "ComercioPanel", new { id = e.Id })"
                                           class="btn btn-sm btn-outline-primary rounded-pill fw-bold">
                                            Editar
                                        </a>

                                        @using (Html.BeginForm("EliminarEvento", "ComercioPanel", FormMethod.Post, new { @class = "m-0" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@e.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger rounded-pill fw-bold"
                                                    onclick="return confirm('¿Seguro que deseas eliminar este evento?');">
                                                Eliminar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model != null && Model.TotalPaginas > 1)
{
    <div class="pager-wrap">
        <div class="pager-info">
            Mostrando @Model.Desde - @Model.Hasta de @Model.TotalRegistros registros
        </div>

        <div class="pager-nav">
            @if (Model.TieneAnterior)
            {
                <a class="pager-btn" href="@Url.Action("MisEventos", new { pagina = Model.PaginaActual - 1 })">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <a class="pager-btn @(i == Model.PaginaActual ? "active" : "")"
                   href="@Url.Action("MisEventos", new { pagina = i })">
                    @i
                </a>
            }

            @if (Model.TieneSiguiente)
            {
                <a class="pager-btn" href="@Url.Action("MisEventos", new { pagina = Model.PaginaActual + 1 })">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}