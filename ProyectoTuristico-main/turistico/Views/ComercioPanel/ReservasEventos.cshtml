@model turistico.Models.PaginacionVM<turistico.Models.Reserva>

@{
    ViewBag.Title = "Reservas de Eventos";
    Layout = "~/Views/Shared/_LayoutComercio.cshtml";
}

<style>
    .pager-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .pager-info {
        color: #64748b;
        font-weight: 600;
    }

    .pager-nav {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .pager-btn {
        min-width: 42px;
        height: 42px;
        padding: 0 1rem;
        border-radius: 999px;
        border: 1px solid rgba(15,23,42,.08);
        background: #fff;
        color: #0f172a;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .pager-btn.active {
            background: #145544;
            color: #fff;
            border-color: #145544;
        }
</style>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <h2 class="fw-bold text-success mb-4">
            <i class="bi bi-bookmark-check me-2"></i>Reservas de mis eventos
        </h2>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Evento</th>
                        <th>Usuario</th>
                        <th>Cantidad</th>
                        <th>Fecha reserva</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No hay reservas registradas para tus eventos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model.Items)
                        {
                            var nombre = ((r.User?.Nombre ?? "") + " " + (r.User?.Apellido ?? "")).Trim();

                            <tr>
                                <td>@(r.Evento?.Nombre ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(nombre) ? (r.User?.Email ?? "Usuario") : nombre)</td>
                                <td>@r.CantidadPersonas</td>
                                <td>@r.FechaReserva.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.TotalPaginas > 1)
        {
            <div class="pager-wrap">
                <div class="pager-info">
                    Mostrando @Model.Desde - @Model.Hasta de @Model.TotalRegistros registros
                </div>

                <div class="pager-nav">
                    @if (Model.TieneAnterior)
                    {
                        <a class="pager-btn" href="@Url.Action("ReservasEventos", new { pagina = Model.PaginaActual - 1 })">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    }

                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <a class="pager-btn @(i == Model.PaginaActual ? "active" : "")"
                           href="@Url.Action("ReservasEventos", new { pagina = i })">
                            @i
                        </a>
                    }

                    @if (Model.TieneSiguiente)
                    {
                        <a class="pager-btn" href="@Url.Action("ReservasEventos", new { pagina = Model.PaginaActual + 1 })">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>