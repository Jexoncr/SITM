@model turistico.Controllers.EventoAdminVM

@{
    ViewBag.Title = "Editar Evento";
    Layout = "~/Views/Shared/_LayoutComercio.cshtml";
    var comercio = ViewBag.ComercioActual as turistico.Models.Comercio;
    var imagenActual = string.IsNullOrWhiteSpace(Model?.ImagenUrlActual)
        ? Url.Content("~/Content/im/img4.png")
        : Url.Content(Model.ImagenUrlActual);
}

<style>
    :root {
        --ee-green-900: #0f3d2e;
        --ee-green-800: #145544;
        --ee-green-700: #1b6b55;
        --ee-soft: rgba(20,85,68,.08);
        --ee-ink: #0f172a;
        --ee-muted: #64748b;
        --ee-border: rgba(15,23,42,.08);
        --ee-card: rgba(255,255,255,.97);
        --ee-shadow: 0 20px 48px rgba(15,23,42,.08);
        --ee-shadow-soft: 0 10px 24px rgba(15,23,42,.05);
        --ee-radius-xl: 30px;
        --ee-radius-lg: 24px;
        --ee-radius-md: 18px;
    }

    .event-edit-page {
        background: radial-gradient(circle at top left, rgba(20,85,68,.07), transparent 30%), radial-gradient(circle at top right, rgba(46,158,127,.08), transparent 24%), linear-gradient(180deg, #fbfdfc 0%, #f4f8f6 50%, #eef4f1 100%);
        min-height: 100%;
    }

    .event-edit-shell {
        max-width: 1220px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
    }

    .event-edit-hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--ee-radius-xl);
        padding: 2rem 1.45rem 1.7rem;
        margin-bottom: 1.1rem;
        background: radial-gradient(circle at top right, rgba(46,158,127,.12), transparent 28%), linear-gradient(135deg, #ffffff 0%, #f7fbf8 55%, #eef7f2 100%);
        border: 1px solid rgba(15,23,42,.06);
        box-shadow: 0 20px 46px rgba(15,23,42,.06);
    }

        .event-edit-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(20,85,68,.04), transparent 24%);
            pointer-events: none;
        }

    .event-edit-hero-inner {
        position: relative;
        z-index: 2;
    }

    .event-edit-badge {
        display: inline-flex;
        align-items: center;
        gap: .42rem;
        padding: .55rem .88rem;
        border-radius: 999px;
        background: rgba(20,85,68,.08);
        color: var(--ee-green-800);
        border: 1px solid rgba(20,85,68,.10);
        font-weight: 800;
        font-size: .8rem;
        margin-bottom: .8rem;
    }

    .event-edit-hero h1 {
        margin: 0 0 .5rem;
        color: var(--ee-ink);
        font-weight: 950;
        line-height: 1.03;
        letter-spacing: -.03em;
        font-size: clamp(2rem, 3vw, 3rem);
    }

    .event-edit-hero p {
        margin: 0;
        max-width: 820px;
        color: var(--ee-muted);
        line-height: 1.82;
        font-size: .95rem;
    }

    .event-edit-grid {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 1rem;
        align-items: start;
    }

    @@media (max-width: 991.98px) {
        .event-edit-grid {
            grid-template-columns: 1fr;
        }
    }

    .event-edit-card {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: var(--ee-radius-xl);
        background: var(--ee-card);
        box-shadow: var(--ee-shadow);
        overflow: hidden;
    }

    .event-edit-head {
        padding: 1rem 1.1rem;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.96));
    }

    .event-edit-title {
        margin: 0;
        color: var(--ee-ink);
        font-weight: 950;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

    .event-edit-sub {
        color: var(--ee-muted);
        font-size: .84rem;
        margin-top: .22rem;
        line-height: 1.6;
    }

    .event-edit-body {
        padding: 1.15rem;
    }

    .soft-box {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 20px;
        background: linear-gradient(180deg, rgba(248,250,252,.8), rgba(255,255,255,1));
        padding: 1rem;
        box-shadow: var(--ee-shadow-soft);
    }

    .form-label {
        font-weight: 900;
        color: var(--ee-ink);
        font-size: .84rem;
        margin-bottom: .45rem;
    }

    .form-control,
    .form-select {
        border-radius: 16px;
        min-height: 48px;
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: none !important;
        font-size: .92rem;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #1f8a6c;
            box-shadow: 0 0 0 .2rem rgba(31,138,108,.12) !important;
        }

    textarea.form-control {
        min-height: 140px;
    }

    .readonly-box {
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid rgba(15,23,42,.08);
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        display: flex;
        align-items: center;
        padding: .75rem .95rem;
        color: #334155;
        font-weight: 700;
    }

    .image-preview-card {
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 22px;
        overflow: hidden;
        background: #fff;
        box-shadow: var(--ee-shadow-soft);
    }

    .image-preview {
        width: 100%;
        height: 260px;
        object-fit: cover;
        display: block;
    }

    .image-preview-body {
        padding: .95rem 1rem;
    }

    .image-preview-title {
        color: var(--ee-ink);
        font-weight: 900;
        margin-bottom: .2rem;
        font-size: .95rem;
    }

    .image-preview-sub {
        color: var(--ee-muted);
        font-size: .82rem;
        line-height: 1.6;
        margin: 0;
    }

    .upload-card {
        border: 1px dashed rgba(15,23,42,.14);
        border-radius: 18px;
        padding: 1rem;
        background: linear-gradient(180deg, #fbfdfc 0%, #ffffff 100%);
    }

    .upload-hint {
        color: var(--ee-muted);
        font-size: .82rem;
        line-height: 1.6;
        margin-top: .45rem;
    }

    .form-actions {
        margin-top: 1.1rem;
        display: flex;
        flex-wrap: wrap;
        gap: .7rem;
    }

    .btn-event-form {
        border-radius: 999px;
        font-weight: 850;
        padding: .82rem 1.15rem;
    }
</style>

<div class="event-edit-page">
    <div class="event-edit-shell">
        <section class="event-edit-hero">
            <div class="event-edit-hero-inner">
                <span class="event-edit-badge">
                    <i class="bi bi-pencil-square"></i> Panel de comercio
                </span>

                <h1>Editar evento</h1>
                <p>
                    Actualiza la información del evento, reemplaza su imagen si lo necesitas y mejora la presentación pública de la actividad dentro del portal.
                </p>
            </div>
        </section>

        <div class="event-edit-grid">
            <div class="event-edit-card">
                <div class="event-edit-head">
                    <h2 class="event-edit-title">
                        <i class="bi bi-sliders"></i> Datos del evento
                    </h2>
                    <div class="event-edit-sub">
                        Ajusta nombre, categoría, cupos, fechas y descripción.
                    </div>
                </div>

                <div class="event-edit-body">
                    @using (Html.BeginForm("EditarEvento", "ComercioPanel", FormMethod.Post, new { enctype = "multipart/form-data", autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)

                        <div class="soft-box mb-3">
                            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0" })
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Comercio</label>
                                <div class="readonly-box">
                                    <i class="bi bi-shop me-2"></i>
                                    @(comercio != null ? comercio.Nombre : "-")
                                </div>
                            </div>

                            <div class="col-12 col-md-7">
                                <label class="form-label">Nombre del evento</label>
                                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Nombre del evento" })
                            </div>

                            <div class="col-12 col-md-5">
                                <label class="form-label">Categoría de evento</label>
                                @Html.DropDownListFor(m => m.CategoriaEventoId, (SelectList)ViewBag.CategoriasEvento, "Seleccione...", new { @class = "form-select" })
                            </div>

                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                @Html.TextAreaFor(m => m.Descripcion, 5, 1, new { @class = "form-control", placeholder = "Descripción del evento..." })
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Fecha de inicio</label>
                                @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Fecha de fin</label>
                                @Html.TextBoxFor(m => m.FechaFin, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Cupo máximo</label>
                                @Html.TextBoxFor(m => m.CupoMaximo, new { @class = "form-control", type = "number", min = "0" })
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Límite por persona</label>
                                @Html.TextBoxFor(m => m.LimitePorPersona, new { @class = "form-control", type = "number", min = "1" })
                            </div>

                            <div class="col-12">
                                <label class="form-label">Reemplazar imagen</label>
                                <div class="upload-card">
                                    <input type="file"
                                           name="ImagenArchivo"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png,.webp,image/*" />
                                    <div class="upload-hint">
                                        Opcional. Solo selecciona un archivo si deseas cambiar la imagen actual.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-success btn-event-form">
                                <i class="bi bi-check2-circle me-1"></i> Guardar cambios
                            </button>

                            <a href="@Url.Action("MisEventos", "ComercioPanel")" class="btn btn-outline-secondary btn-event-form">
                                Cancelar
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="event-edit-card">
                <div class="event-edit-head">
                    <h2 class="event-edit-title">
                        <i class="bi bi-image"></i> Imagen actual
                    </h2>
                    <div class="event-edit-sub">
                        Vista previa de la imagen principal del evento.
                    </div>
                </div>

                <div class="event-edit-body">
                    <div class="image-preview-card">
                        <img src="@imagenActual"
                             alt="Imagen actual del evento"
                             class="image-preview"
                             onerror="this.onerror=null;this.src='@Url.Content("~/Content/im/img4.png")';" />
                        <div class="image-preview-body">
                            <div class="image-preview-title">Imagen visible en el portal</div>
                            <p class="image-preview-sub">
                                Si subes una nueva imagen y guardas los cambios, esta vista se actualizará con la nueva portada.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>